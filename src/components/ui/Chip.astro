---
interface Props {
	label: string;
	value: string;
	pressed?: boolean;
	count?: number;
}

const { label, value, pressed = false, count } = Astro.props;
---

<button
	type="button"
	class="chip"
	data-filter={value}
	aria-pressed={pressed ? 'true' : 'false'}
>
	<span data-filter-label>{label}</span>
	{count !== undefined && <span class="chip__count">{count}</span>}
</button>
