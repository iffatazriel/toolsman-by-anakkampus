---
import type { ToolMeta } from '../lib/tool-types';
import { categoryLabel } from '../lib/tool-types';
import { normalize, searchableFields } from '../lib/search';
import Icon from './ui/Icon.astro';
import Modal from './ui/Modal.astro';

interface Props {
	tools: ToolMeta[];
}

const { tools } = Astro.props;
---

<Modal id="palette" labelledby="palette-title">
	<div class="palette__head">
		<label class="palette__label" id="palette-title" for="palette-input" data-i18n="palette.label">Cari alat</label>
		<kbd class="kbd">Esc</kbd>
	</div>

	<div class="palette__search">
		<Icon name="search" size={20} />
		<input
			id="palette-input"
			class="palette__input"
			type="search"
			placeholder="mis. gabung pdf, flowchart, pas foto"
			autocomplete="off"
			data-palette-input
			data-i18n-placeholder="palette.placeholder"
		/>
	</div>

	<ul class="palette__list" data-palette-list>
		{
			tools.map((tool) => (
				<li
					data-palette-item
					data-palette-slug={tool.slug}
					data-category={tool.category}
					data-palette-cat={categoryLabel(tool.category)}
					data-search={normalize(searchableFields(tool).join(' '))}
				>
					<a class="palette__link" href={`/tools/${tool.slug}/`}>
						<span class="tool-tile" data-category={tool.category}>
							<Icon name={tool.icon} size={20} />
						</span>
						<span class="palette__name">{tool.name}</span>
						<span class="palette__cat">{categoryLabel(tool.category)}</span>
					</a>
				</li>
			))
		}
	</ul>

	<p class="palette__empty" data-palette-empty data-i18n="palette.empty" hidden>
		Belum ada alat yang cocok. Coba kata lain seperti "pdf", "foto", atau "json".
	</p>

	<div class="palette__foot">
		<span data-i18n="palette.updown">↑ ↓ untuk pilih</span>
		<span data-i18n="palette.enter">Enter untuk buka</span>
	</div>
</Modal>

<style>
	.palette__label {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 500;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--text-muted);
	}

	.palette__search {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		padding-inline: var(--space-4);
		border-bottom: 1px solid var(--border);
		color: var(--text-muted);
	}

	.palette__head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-2);
		padding: var(--space-3) var(--space-4) 0;
	}

	/* Judul kelompok: "Terakhir dipakai" dan nama kategori. */
	.palette__group {
		padding: var(--space-3) var(--space-3) var(--space-1);
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--text-muted);
	}
</style>

<script>
	import { readRecent } from '../lib/favorites';
	import { readLang, t } from '../lib/i18n';
	import { matches } from '../lib/search';

	const dialog = document.getElementById('palette') as HTMLDialogElement | null;

	if (dialog) {
		const input = dialog.querySelector<HTMLInputElement>('[data-palette-input]');
		const list = dialog.querySelector<HTMLElement>('[data-palette-list]');
		const items = Array.from(
			dialog.querySelectorAll<HTMLElement>('[data-palette-item]'),
		);
		const empty = dialog.querySelector<HTMLElement>('[data-palette-empty]');
		const bySlug = new Map(items.map((item) => [item.dataset.paletteSlug ?? '', item]));

		const visibleLinks = (): HTMLAnchorElement[] =>
			Array.from(list?.querySelectorAll<HTMLElement>('[data-palette-item]') ?? [])
				.filter((item) => !item.hidden)
				.map((item) => item.querySelector('a'))
				.filter((link): link is HTMLAnchorElement => link !== null);

		const groupHeader = (label: string): HTMLElement => {
			const header = document.createElement('li');
			header.className = 'palette__group';
			header.dataset.paletteGroup = '';
			header.textContent = label;
			return header;
		};

		// "Terakhir dipakai" di atas, sisanya dikelompokkan per kategori.
		// Node yang sama dipindah, bukan digandakan, supaya keyboard tetap
		// melewati satu tautan per alat.
		const arrange = () => {
			const recent = readRecent(localStorage)
				.filter((slug) => bySlug.has(slug))
				.slice(0, 4);
			const lang = readLang();
			const shown = new Set<HTMLElement>();
			list?.replaceChildren();

			if (recent.length > 0) {
				list?.append(groupHeader(t(lang, 'palette.recent')));
				recent.forEach((slug) => {
					const item = bySlug.get(slug);
					if (!item || shown.has(item)) return;
					shown.add(item);
					list?.append(item);
				});
			}

			let current = '';
			for (const item of items) {
				if (shown.has(item)) continue;
				const label = item.dataset.paletteCat ?? '';
				if (label !== current) {
					current = label;
					list?.append(groupHeader(label));
				}
				shown.add(item);
				list?.append(item);
			}
		};

		// Judul kelompok ikut disembunyikan saat tidak ada anak yang cocok.
		const syncHeaders = () => {
			list?.querySelectorAll<HTMLElement>('[data-palette-group]').forEach((header) => {
				let node = header.nextElementSibling;
				let any = false;
				while (node !== null && !node.hasAttribute('data-palette-group')) {
					if (!(node as HTMLElement).hidden) {
						any = true;
						break;
					}
					node = node.nextElementSibling;
				}
				header.hidden = !any;
			});
		};

		const filter = () => {
			let shown = 0;
			items.forEach((item) => {
				const hit = matches([item.dataset.search ?? ''], input?.value ?? '');
				item.hidden = !hit;
				if (hit) shown += 1;
			});
			syncHeaders();
			if (empty) empty.hidden = shown !== 0;
		};

		const open = () => {
			if (dialog.open) return;
			if (input) input.value = '';
			arrange();
			filter();
			dialog.showModal();
			input?.focus();
		};

		document
			.querySelectorAll<HTMLElement>('[data-open-palette]')
			.forEach((trigger) => trigger.addEventListener('click', open));

		document.addEventListener('keydown', (event) => {
			const target = event.target as HTMLElement | null;
			const typing =
				target !== null &&
				(target.tagName === 'INPUT' ||
					target.tagName === 'TEXTAREA' ||
					target.isContentEditable);

			if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k') {
				event.preventDefault();
				if (dialog.open) {
					dialog.close();
				} else {
					open();
				}
				return;
			}

			if (event.key === '/' && !typing && !dialog.open) {
				event.preventDefault();
				open();
			}
		});

		input?.addEventListener('input', filter);
		document.addEventListener('lang:change', () => {
			if (dialog.open) arrange();
			filter();
		});

		input?.addEventListener('keydown', (event) => {
			if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp') return;
			const links = visibleLinks();
			if (links.length === 0) return;
			event.preventDefault();
			const target = event.key === 'ArrowDown' ? links[0] : links[links.length - 1];
			target?.focus();
		});

		dialog.addEventListener('keydown', (event) => {
			// Panah dari kolom cari sudah ditangani di atas; jangan digeser dua kali.
			if (event.defaultPrevented) return;
			if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp') return;
			const links = visibleLinks();
			const current = links.indexOf(document.activeElement as HTMLAnchorElement);
			if (current === -1) return;
			event.preventDefault();
			const step = event.key === 'ArrowDown' ? 1 : -1;
			links[(current + step + links.length) % links.length]?.focus();
		});
	}
</script>
