---
import type { ToolMeta } from '../lib/tool-types';
import { categories, featuredSlugs } from '../lib/tool-types';
import ToolCard from './ToolCard.astro';
import Chip from './ui/Chip.astro';

interface Props {
	tools: ToolMeta[];
}

const { tools } = Astro.props;

const counts = new Map(categories.map((category) => [
	category.id,
	tools.filter((tool) => tool.category === category.id).length,
]));

const featured = new Set<string>(featuredSlugs);
---

<section class="catalog container" id="katalog" aria-labelledby="katalog-title">
	<div class="section-head">
		<h2 class="section-title" id="katalog-title" data-i18n="catalog.title">Alat di daftar MVP</h2>
		<p class="section-meta" data-i18n="catalog.meta" data-count-value={tools.length}>{tools.length} modul</p>
	</div>

	<p class="catalog-intro" data-i18n="catalog.intro" data-count-value={tools.length}>
		{tools.length} alat di bawah ini bisa langsung dipakai. File diproses di browser,
		kecuali Kirim File yang memakai server dan ditandai di kartunya.
	</p>

	<div class="chip-row" role="group" aria-label="Filter kategori">
		<Chip label="Semua" value="semua" count={tools.length} pressed />
		{categories.map((category) => (
			<Chip label={category.label} value={category.id} count={counts.get(category.id) ?? 0} />
		))}
	</div>

	<p class="catalog-count" aria-live="polite" data-count>{tools.length} alat</p>

	<ul class="tool-grid" data-tool-grid>
		{
			tools.map((tool, index) => (
				<li
					class:list={['tool-grid__item', featured.has(tool.slug) && 'tool-grid__item--featured']}
					data-tool
					data-name={tool.name}
					data-category={tool.category}
					data-keywords={tool.keywords.join('|')}
					style={`--i:${index}`}
				>
					<ToolCard tool={tool} featured={featured.has(tool.slug)} />
				</li>
			))
		}
	</ul>

	<div class="empty-state" data-catalog-empty hidden>
		<svg
			class="empty-state__art"
			viewBox="0 0 120 72"
			role="presentation"
			focusable="false"
			aria-hidden="true"
		>
			<rect x="10.5" y="10.5" width="99" height="51" rx="8" />
			<circle cx="44" cy="36" r="12" />
			<path d="m53 45 12 12" />
			<path d="M78 30h18M78 42h12" />
		</svg>
		<p class="empty-state__title" data-i18n="catalog.emptyTitle">Tidak ada alat yang cocok</p>
		<p class="empty-state__body" data-empty-body>
			Belum ada hasil untuk "..." di kategori yang dipilih. Coba kata lain seperti
			"pdf", "foto", atau "json", atau hapus filter kategori.
		</p>
		<button type="button" class="btn btn--secondary mt-4" data-catalog-reset data-i18n="catalog.reset">
			Hapus filter
		</button>
	</div>
</section>

<style>
	.catalog-intro {
		max-width: 62ch;
		margin-top: var(--space-2);
		font-size: 0.875rem;
		color: var(--text-muted);
	}

	.catalog-count {
		margin-top: var(--space-4);
		font-family: var(--font-mono);
		font-size: 0.75rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--text-muted);
	}
</style>

<script>
	import { fill, readLang, t } from '../lib/i18n';
	import { matches } from '../lib/search';

	const FILTER_KEY = 'toolsman-filter';

	const grid = document.querySelector<HTMLElement>('[data-tool-grid]');

	if (grid) {
		const items = Array.from(grid.querySelectorAll<HTMLElement>('[data-tool]'));
		const input = document.querySelector<HTMLInputElement>('#catalog-search');
		const chips = Array.from(
			document.querySelectorAll<HTMLButtonElement>('[data-filter]'),
		);
		const count = document.querySelector<HTMLElement>('[data-count]');
		const empty = document.querySelector<HTMLElement>('[data-catalog-empty]');
		const emptyBody = document.querySelector<HTMLElement>('[data-empty-body]');
		const reset = document.querySelector<HTMLButtonElement>('[data-catalog-reset]');
		const total = items.length;
		const validCategories = new Set(chips.map((chip) => chip.dataset.filter ?? 'semua'));

		const readFilter = (): string => {
			try {
				const stored = localStorage.getItem(FILTER_KEY);
				return stored && validCategories.has(stored) ? stored : 'semua';
			} catch {
				return 'semua';
			}
		};

		const writeFilter = (value: string): void => {
			try {
				localStorage.setItem(FILTER_KEY, value);
			} catch {
				/* penyimpanan bisa diblokir; filter tetap jalan untuk sesi ini */
			}
		};

		let category = readFilter();
		let query = '';

		const press = (value: string): void => {
			chips.forEach((chip) =>
				chip.setAttribute('aria-pressed', chip.dataset.filter === value ? 'true' : 'false'),
			);
		};

		const apply = () => {
			let visible = 0;

			items.forEach((item) => {
				const fields = [
					item.dataset.name ?? '',
					item.dataset.category ?? '',
					...(item.dataset.keywords ?? '').split('|'),
				];
				const hit =
					(category === 'semua' || item.dataset.category === category) &&
					matches(fields, query);
				item.hidden = !hit;
				if (hit) visible += 1;
			});

			const lang = readLang();
			const filtered = query.trim() !== '' || category !== 'semua';
			if (count) {
				count.textContent = filtered
					? fill(t(lang, 'catalog.countFiltered'), { visible, total })
					: fill(t(lang, 'catalog.count'), { n: total });
			}
			if (empty) empty.hidden = visible !== 0;
			if (emptyBody) {
				emptyBody.textContent = fill(t(lang, 'catalog.emptyBody'), {
					query: query.trim() === '' ? '...' : query,
				});
			}
		};

		chips.forEach((chip) => {
			chip.addEventListener('click', () => {
				category = chip.dataset.filter ?? 'semua';
				press(category);
				writeFilter(category);
				apply();
			});
		});

		input?.addEventListener('input', () => {
			query = input.value;
			apply();
		});

		reset?.addEventListener('click', () => {
			query = '';
			category = 'semua';
			writeFilter(category);
			if (input) input.value = '';
			press(category);
			apply();
			input?.focus();
		});

		press(category);
		document.addEventListener('lang:change', apply);
		apply();
	}
</script>
