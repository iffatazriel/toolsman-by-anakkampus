---
import dict from '../../features/kirim-file/i18n';
import Layout from '../../layouts/Layout.astro';
import Modal from '../../components/ui/Modal.astro';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
const id = Astro.params.id ?? '';
---

<Layout title={dict.id.manageTitle} description={dict.id.manageDescription} noindex>
	<div class="container manage-page" data-manage-id={id}>
		<h1 data-i18n="workspace.kirim-file.manageTitle">{dict.id.manageTitle}</h1>
		<p data-i18n="workspace.kirim-file.managePrivacy">{dict.id.managePrivacy}</p>
		<p><a href="/tools/kirim-file/" data-i18n="workspace.kirim-file.back">{dict.id.back}</a></p>
		<p id="manage-error" class="field-error" role="alert" hidden></p>
		<p id="manage-message" class="field-hint" role="status">{dict.id.manageLoading}</p>
		<section class="pane" id="manage-details" hidden aria-labelledby="manage-heading">
			<h2 id="manage-heading" class="pane__title" data-i18n="workspace.kirim-file.manageHeading">{dict.id.manageHeading}</h2>
			<dl class="details"><dt data-i18n="workspace.kirim-file.status">{dict.id.status}</dt><dd id="manage-state"></dd><dt data-i18n="workspace.kirim-file.created">{dict.id.created}</dt><dd id="manage-created"></dd><dt data-i18n="workspace.kirim-file.expires">{dict.id.expires}</dt><dd id="manage-expires"></dd><dt data-i18n="workspace.kirim-file.remaining">{dict.id.remaining}</dt><dd id="manage-countdown"></dd><dt data-i18n="workspace.kirim-file.protection">{dict.id.protection}</dt><dd id="manage-flags"></dd><dt data-i18n="workspace.kirim-file.downloads">{dict.id.downloads}</dt><dd id="manage-downloads"></dd></dl>
			<p id="manage-pending" class="field-hint" hidden data-i18n="workspace.kirim-file.pending">{dict.id.pending}</p>
			<h3 data-i18n="workspace.kirim-file.yourFiles">{dict.id.yourFiles}</h3><ul id="manage-files"></ul>
			<p class="field-hint" data-i18n="workspace.kirim-file.countNote">{dict.id.countNote}</p>
			<button type="button" id="manage-notify" class="btn btn--secondary" data-i18n="workspace.kirim-file.notify">{dict.id.notify}</button>
			<p id="manage-notify-note" class="field-hint" data-i18n="workspace.kirim-file.notifyHint">{dict.id.notifyHint}</p>
			<button type="button" id="manage-delete" class="btn btn--danger" data-i18n="workspace.kirim-file.delete">{dict.id.delete}</button>
		</section>
		<section class="pane" id="manage-share" hidden aria-labelledby="manage-share-title">
			<h2 id="manage-share-title" class="pane__title" data-i18n="workspace.kirim-file.recipientLink">{dict.id.recipientLink}</h2>
			<a id="manage-share-link" rel="noreferrer" data-i18n="workspace.kirim-file.openShare">{dict.id.openShare}</a>
			<label class="field-label" for="manage-share-url" data-i18n="workspace.kirim-file.shareLabel">{dict.id.shareLabel}</label>
			<div class="link-row"><input class="field-input" id="manage-share-url" readonly /><button type="button" class="btn btn--secondary" id="manage-share-copy" data-i18n="workspace.kirim-file.copyShare">{dict.id.copyShare}</button></div>
			<img id="manage-qr" alt={dict.id.shareQrAlt} data-i18n-alt="workspace.kirim-file.shareQrAlt" width="180" height="180" hidden />
		</section>
		<Modal id="manage-confirm" labelledby="manage-confirm-title">
			<h2 id="manage-confirm-title" data-i18n="workspace.kirim-file.deleteTitle">{dict.id.deleteTitle}</h2>
			<p data-i18n="workspace.kirim-file.deleteHint">{dict.id.deleteHint}</p>
			<div class="actions"><button type="button" class="btn btn--secondary" id="manage-cancel" autofocus data-i18n="workspace.kirim-file.dismiss">{dict.id.dismiss}</button><button type="button" class="btn btn--danger" id="manage-confirm-delete" data-i18n="workspace.kirim-file.deleteConfirm">{dict.id.deleteConfirm}</button></div>
		</Modal>
	</div>
</Layout>

<script>
	import '../../features/kirim-file/manage-client';
</script>

<style>
	.manage-page { max-width: 900px; padding-block: var(--space-7); }
	.pane { margin-block: var(--space-4); }
	.details { display: grid; grid-template-columns: minmax(100px, 1fr) 2fr; gap: var(--space-2) var(--space-4); }
	dt { color: var(--text-muted); } dd { margin: 0; overflow-wrap: anywhere; }
	.link-row, .actions { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-block: var(--space-3); }
	.link-row input { flex: 1 1 240px; }
	#manage-files { padding-left: var(--space-5); overflow-wrap: anywhere; }
	#manage-files li { margin-bottom: var(--space-2); }
</style>
