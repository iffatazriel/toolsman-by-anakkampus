---
import Layout from '../../layouts/Layout.astro';
import Modal from '../../components/ui/Modal.astro';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
const id = Astro.params.id ?? '';
---

<Layout title="Kelola kiriman" description="Lihat status unduhan dan hapus kiriman kamu lebih awal dengan link kelola rahasia." noindex>
	<main class="container manage-page" id="main" data-manage-id={id}>
		<h1>Kelola kiriman</h1>
		<p>Link halaman ini rahasia. Siapa pun yang memilikinya bisa melihat status dan menghapus kiriman. Jangan bagikan ke penerima.</p>
		<p><a href="/tools/kirim-file/">Kembali ke Kirim File</a></p>
		<p id="manage-error" class="field-error" role="alert" hidden></p>
		<p id="manage-message" class="field-hint" role="status">Membaca link kelola…</p>
		<section class="pane" id="manage-details" hidden aria-labelledby="manage-heading">
			<h2 id="manage-heading" class="pane__title">Status kiriman</h2>
			<dl class="details"><dt>Status</dt><dd id="manage-state"></dd><dt>Dibuat</dt><dd id="manage-created"></dd><dt>Berlaku sampai</dt><dd id="manage-expires"></dd><dt>Sisa waktu</dt><dd id="manage-countdown"></dd><dt>Perlindungan</dt><dd id="manage-flags"></dd><dt>Total unduhan</dt><dd id="manage-downloads"></dd></dl>
			<p id="manage-pending" class="field-hint" hidden>Akses kiriman sudah ditutup. Sebagian objek belum berhasil dihapus; pembersihan otomatis akan mencoba lagi.</p>
			<h3>Berkas kamu</h3><ul id="manage-files"></ul>
			<p class="field-hint">Unduhan tercatat saat pengambilan dimulai, bukan bukti berkas selesai diterima. Berkas yang sudah diunduh atau sedang dikirim tidak bisa ditarik kembali.</p>
			<button type="button" id="manage-notify" class="btn btn--secondary">Aktifkan notifikasi</button>
			<p id="manage-notify-note" class="field-hint">Status diperiksa setiap sekitar 20 detik saat tab terlihat. Notifikasi hanya bekerja selama halaman terbuka; ini bukan notifikasi push.</p>
			<button type="button" id="manage-delete" class="btn btn--danger">Hapus sekarang</button>
		</section>
		<section class="pane" id="manage-share" hidden aria-labelledby="manage-share-title">
			<h2 id="manage-share-title" class="pane__title">Link untuk penerima</h2>
			<a id="manage-share-link" rel="noreferrer">Buka link kiriman</a>
			<label class="field-label" for="manage-share-url">Link kiriman (bukan link kelola)</label>
			<div class="link-row"><input class="field-input" id="manage-share-url" readonly /><button type="button" class="btn btn--secondary" id="manage-share-copy">Salin link kiriman</button></div>
			<img id="manage-qr" alt="QR link kiriman untuk penerima" width="180" height="180" hidden />
		</section>
		<Modal id="manage-confirm" labelledby="manage-confirm-title">
			<h2 id="manage-confirm-title">Hapus kiriman sekarang?</h2>
			<p>Link penerima langsung dinonaktifkan. Berkas akan dihapus dari penyimpanan; tindakan ini tidak bisa dibatalkan.</p>
			<div class="actions"><button type="button" class="btn btn--secondary" id="manage-cancel" autofocus>Batal</button><button type="button" class="btn btn--danger" id="manage-confirm-delete">Ya, hapus kiriman</button></div>
		</Modal>
	</main>
</Layout>

<script>
	import '../../features/kirim-file/manage-client';
</script>

<style>
	.manage-page { max-width: 900px; padding-block: var(--space-7); }
	.pane { margin-block: var(--space-4); }
	.details { display: grid; grid-template-columns: minmax(100px, 1fr) 2fr; gap: var(--space-2) var(--space-4); }
	dt { color: var(--text-muted); } dd { margin: 0; overflow-wrap: anywhere; }
	.link-row, .actions { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-block: var(--space-3); }
	.link-row input { flex: 1 1 240px; }
	#manage-files { padding-left: var(--space-5); overflow-wrap: anywhere; }
	#manage-files li { margin-bottom: var(--space-2); }
</style>
