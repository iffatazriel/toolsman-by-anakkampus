---
import Catalog from '../components/Catalog.astro';
import ProductPreview from '../components/ProductPreview.astro';
import Icon from '../components/ui/Icon.astro';
import Layout from '../layouts/Layout.astro';
import { tools } from '../lib/tools';
import { SITE_DESCRIPTION, absoluteUrl } from '../lib/site';

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: 'Toolsman',
	url: absoluteUrl('/'),
	description: SITE_DESCRIPTION,
	inLanguage: 'id-ID',
};

const examples = [{text:'gabung pdf',key:'home.example.pdf'}, {text:'flowchart',key:undefined}, {text:'pas foto merah',key:'home.example.photo'}];
---

<Layout
	title="Toolsman, kotak perkakas untuk kuliah dan koding"
	description={SITE_DESCRIPTION}
	jsonLd={jsonLd}
>
	<section class="hero" aria-labelledby="hero-title">
		<div class="container hero__grid">
			<div class="hero__copy">
				<h1 class="hero__title" id="hero-title" data-i18n="home.heroTitle">
					Semua perkakas kuliahmu, satu kotak.
				</h1>

				<p class="hero__lede" data-i18n="home.heroLede" data-count-value={tools.length}>
					{tools.length} alat untuk kuliah dan koding. Gratis, tanpa akun.
				</p>

				<div class="hero__search">
					<label class="field-label" for="catalog-search" data-i18n="home.searchLabel">
						Cari alat
					</label>
					<div class="hero__search-field">
						<span class="hero__search-icon" aria-hidden="true">
							<Icon name="search" size={20} />
						</span>
						<input
							id="catalog-search"
							class="field-input hero__input"
							type="search"
							placeholder="mis. gabung pdf"
							autocomplete="off"
							aria-describedby="catalog-search-hint"
							data-i18n-placeholder="home.searchPlaceholder"
						/>
						<kbd class="kbd hero__kbd">Ctrl K</kbd>
					</div>
					<p class="field-hint" id="catalog-search-hint" data-i18n="home.searchHint">
						Tekan / atau Ctrl K untuk membuka pencarian dari halaman mana saja.
					</p>
				</div>

				<div class="hero__examples" role="group" aria-label="Contoh pencarian" data-i18n-aria="home.examplesAria">
					<span class="hero__examples-label" data-i18n="home.examplesLabel">Coba:</span>
					{
						examples.map((example) => (
								<button type="button" class="chip chip--example" data-hero-example={example.text} data-i18n={example.key}>
									{example.text}
							</button>
						))
					}
				</div>

			</div>

			<ProductPreview />
		</div>
	</section>
	<div class="value-strip">
		<ul class="container value-strip__items">
			<li><Icon name="check" /><span data-i18n="home.valueFree">Gratis tanpa akun</span></li>
			<li><Icon name="shield" /><span data-i18n="home.valueLocal">File tetap di perangkatmu (kecuali Kirim File)</span></li>
			<li><Icon name="braces" /><span data-i18n="home.valuePattern">Satu pola untuk semua alat</span></li>
		</ul>
	</div>

	<section class="shelf container" data-shelf="favorites" aria-labelledby="favorit-title" hidden>
		<div class="section-head">
			<h2 class="section-title" id="favorit-title" data-i18n="home.favorites">Favoritmu</h2>
			<a class="section-meta shelf-link" href="#katalog" data-i18n="home.allTools">Semua alat</a>
		</div>
		<ul class="shelf-grid" data-shelf-list="favorites"></ul>
	</section>

	<section class="shelf container" data-shelf="recent" aria-labelledby="terakhir-title" hidden>
		<div class="section-head">
			<h2 class="section-title" id="terakhir-title" data-i18n="home.recent">Terakhir dipakai</h2>
			<p class="section-meta" data-i18n="home.saved">Disimpan di browser ini</p>
		</div>
		<ul class="shelf-grid" data-shelf-list="recent"></ul>
	</section>

	<Catalog tools={tools} />

	<script>
		import { readFavorites, readRecent } from '../lib/favorites';

		const cards = new Map<string, HTMLElement>();
		document.querySelectorAll<HTMLElement>('[data-tool-grid] [data-tool]').forEach((item) => {
			const link = item.querySelector<HTMLAnchorElement>('.tool-card__link');
			const slug = link?.getAttribute('href')?.replace(/^\/tools\//, '').replace(/\/$/, '');
			if (slug) cards.set(slug, item);
		});

		const renderShelf = (name: string, slugs: string[], favorites: string[]) => {
			const section = document.querySelector<HTMLElement>(`[data-shelf="${name}"]`);
			const list = document.querySelector<HTMLUListElement>(`[data-shelf-list="${name}"]`);
			if (!section || !list) return;

			list.innerHTML = '';
			slugs.forEach((slug) => {
				const source = cards.get(slug);
				if (!source) return;

				const clone = source.cloneNode(true) as HTMLElement;
				for (const attribute of ['data-tool', 'data-name', 'data-category', 'data-keywords']) {
					clone.removeAttribute(attribute);
				}
				clone.hidden = false;
				clone.querySelectorAll<HTMLButtonElement>('[data-favorite]').forEach((button) => {
					const active = favorites.includes(slug);
					button.setAttribute('aria-pressed', active ? 'true' : 'false');
				});
				list.append(clone);
			});

			section.hidden = list.children.length === 0;
		};

		const refresh = () => {
			const favorites = readFavorites(localStorage);
			const recent = readRecent(localStorage).filter((slug) => !favorites.includes(slug));
			renderShelf('favorites', favorites, favorites);
			renderShelf('recent', recent, favorites);
		};

		refresh();
		document.addEventListener('favorites:change', refresh);
		window.addEventListener('pageshow', refresh);
	</script>

	<script>
		// Chip contoh mengisi kolom pencarian lalu memicu filter katalog yang
		// sudah ada, tanpa logika pencarian kedua.
		const input = document.querySelector<HTMLInputElement>('#catalog-search');

		if (input) {
			document.querySelectorAll<HTMLButtonElement>('[data-hero-example]').forEach((chip) => {
				chip.addEventListener('click', () => {
					const value = chip.textContent?.trim() ?? '';
					input.value = value;
					input.dispatchEvent(new Event('input', { bubbles: true }));
					document.querySelector('#katalog')?.scrollIntoView({ block: 'start' });
					input.focus({ preventScroll: true });
				});
			});
		}
	</script>

	<style>
		.value-strip { border-bottom: 1px solid var(--border); background: var(--surface); }
		.value-strip__items { display: grid; gap: var(--space-4); padding-block: var(--space-5); list-style: none; }
		.value-strip__items li { display: flex; align-items: center; gap: var(--space-3); font-size: 0.875rem; }
		.value-strip__items :global(svg) { flex-shrink: 0; color: var(--text-muted); }
		@media (min-width: 768px) { .value-strip__items { grid-template-columns: 0.8fr 1.4fr 1fr; } }
		@media (pointer: coarse), (hover: none) {
			.hero__kbd, #catalog-search-hint { display: none; }
			.hero__input { padding-right: var(--space-4); }
		}
		@media (max-width: 767px) {
			.chip--example { min-width: 7rem; justify-content: center; }
		}
		.shelf {
			padding-top: var(--space-6);
		}

		.shelf[hidden] {
			display: none;
		}

		.shelf-grid {
			display: grid;
			grid-template-columns: minmax(0, 1fr);
			gap: var(--space-3);
			margin: var(--space-3) 0 0;
			padding: 0;
			list-style: none;
		}

		@media (min-width: 640px) {
			.shelf-grid {
				grid-template-columns: repeat(2, minmax(0, 1fr));
			}
		}

		@media (min-width: 1024px) {
			.shelf-grid {
				grid-template-columns: repeat(3, minmax(0, 1fr));
			}
		}

		.shelf-link {
			text-decoration: none;
		}

		.shelf-link:hover {
			color: var(--text);
		}
	</style>
</Layout>
