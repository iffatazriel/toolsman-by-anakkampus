---
import dict from '../../features/kirim-file/i18n';
import Layout from '../../layouts/Layout.astro';
import Modal from '../../components/ui/Modal.astro';
import type { ShareFileRow, ShareRow } from '../../features/kirim-file/db';
import { hasR2Config } from '../../features/kirim-file/r2';
import { shareAccess } from '../../features/kirim-file/share-access';
import { fileDownloadViews, viewShare } from '../../features/kirim-file/share-view';
import { formatBytes, formatRemaining } from '../../features/kirim-file/format';
import { shareEnv } from '../../features/kirim-file/bindings';
import { verifyPassword } from '../../features/kirim-file/password';
import { allowPasswordAttempt, clientIp } from '../../features/kirim-file/rate-limit';

export const prerender = false;

const ID_PATTERN = /^[0-9a-f]{32}$/;
const id = Astro.params.id ?? '';

// Halaman terbuka bisa memuat kata sandi di form unduh, jadi jangan disimpan
// di cache peramban atau proxy.
Astro.response.headers.set('Cache-Control', 'no-store');

const env = ID_PATTERN.test(id) ? shareEnv() : null;

let row: ShareRow | null = null;
if (env) {
	try {
		row = await env.DB.prepare('SELECT * FROM shares WHERE id = ?').bind(id).first<ShareRow>();
	} catch {
		row = null;
	}
}

const view = viewShare(row, Date.now());
const r2Ready = hasR2Config(env);
const locked = Boolean(row?.password_hash);
const maxDownloads = row?.max_downloads ?? null;

let password = '';
let passwordError: 'passwordRate' | 'passwordWrong' | null = null;

if (Astro.request.method === 'POST' && locked && row && view.state === 'ok') {
	const allowed = await allowPasswordAttempt(
		env?.PASSWORD_LIMIT,
		clientIp(Astro.request),
		id,
	);

	if (!allowed) {
		passwordError = 'passwordRate';
	} else {
		try {
			const form = await Astro.request.formData();
			password = String(form.get('password') ?? '');
		} catch {
			password = '';
		}
		if (!(await verifyPassword(password, row.password_hash ?? ''))) {
			password = '';
			passwordError = 'passwordWrong';
		}
	}
}

const unlocked = !locked || password !== '';

let fileRows: ShareFileRow[] = [];
if (env && row?.status === 'ready') {
	try {
		const { results } = await env.DB.prepare(
			'SELECT * FROM share_files WHERE share_id = ? ORDER BY rowid',
		)
			.bind(id)
			.all<ShareFileRow>();
		fileRows = results;
	} catch {
		fileRows = [];
	}
}

const access = shareAccess(row, fileRows, Date.now(), unlocked);

const files =
	access === 'ok' && env && r2Ready
		? fileDownloadViews(id, fileRows, maxDownloads)
		: [];

if (access === 'expired' || access === 'exhausted' || access === 'taken-down') {
	Astro.response.status = 410;
} else if (access === 'missing') {
	Astro.response.status = 404;
}
---

<Layout
	title={access === 'ok' ? dict.id.recipientTitle : dict.id.unavailableTitle}
	description={dict.id.recipientDescription}
	noindex
>
	<section class="container prose-page share-page" data-share-id={id} data-available={access === 'ok'} data-expires-at={row?.expires_at}>
		{
			access === 'missing' && (
				<>
					<h1 data-i18n="workspace.kirim-file.missingTitle">{dict.id.missingTitle}</h1>
					<p data-i18n="workspace.kirim-file.missingBody">{dict.id.missingBody}</p>
					<p>
						<a class="btn btn--primary mt-4" href="/tools/kirim-file" data-i18n="workspace.kirim-file.createOwn">{dict.id.createOwn}</a>
					</p>
				</>
			)
		}

		{
			access === 'expired' && (
				<>
					<h1 data-i18n="workspace.kirim-file.expiredTitle">{dict.id.expiredTitle}</h1>
					<p data-i18n="workspace.kirim-file.expiredBody">{dict.id.expiredBody}</p>
					<p>
						<a class="btn btn--primary mt-4" href="/tools/kirim-file" data-i18n="workspace.kirim-file.sendFiles">{dict.id.sendFiles}</a>
					</p>
				</>
			)
		}

		{
			access === 'exhausted' && (
				<>
					<h1 data-i18n="workspace.kirim-file.usedTitle">{dict.id.usedTitle}</h1>
					<p data-i18n="workspace.kirim-file.usedBody">{dict.id.usedBody}</p>
					<p>
						<a class="btn btn--primary mt-4" href="/tools/kirim-file" data-i18n="workspace.kirim-file.sendFiles">{dict.id.sendFiles}</a>
					</p>
				</>
			)
		}

		{
			access === 'taken-down' && (
				<>
					<h1 data-i18n="workspace.kirim-file.disabledTitle">{dict.id.disabledTitle}</h1>
					<p data-i18n="workspace.kirim-file.disabledBody">{dict.id.disabledBody}</p>
					<p>
						<span data-i18n="workspace.kirim-file.ownerHelp">{dict.id.ownerHelp}</span>{' '}
						<a href="/tentang" data-i18n="workspace.kirim-file.about">{dict.id.about}</a><span data-i18n="workspace.kirim-file.aboutSuffix">{dict.id.aboutSuffix}</span>
					</p>
					<p>
						<a class="btn btn--primary mt-4" href="/tools/kirim-file" data-i18n="workspace.kirim-file.sendFiles">{dict.id.sendFiles}</a>
					</p>
				</>
			)
		}

		{
			access === 'ok' && !r2Ready && (
				<>
					<h1 data-i18n="workspace.kirim-file.storageTitle">{dict.id.storageTitle}</h1>
					<p data-i18n="workspace.kirim-file.storageBody">{dict.id.storageBody}</p>
				</>
			)
		}

		{
			access === 'locked' && r2Ready && (
				<form method="post" class="share-lock">
					<h1 data-i18n="workspace.kirim-file.lockedTitle">{dict.id.lockedTitle}</h1>
					<p data-i18n="workspace.kirim-file.lockedBody">{dict.id.lockedBody}</p>
					<div>
						<label class="field-label" for="share-password" data-i18n="workspace.kirim-file.password">{dict.id.password}</label>
						<input
							class="field-input"
							id="share-password"
							name="password"
							type="password"
							autocomplete="off"
							required
							aria-invalid={passwordError ? 'true' : undefined}
							aria-describedby={passwordError ? 'share-password-error' : undefined}
						/>
						{passwordError && (
							<p class="field-error" id="share-password-error" role="alert" data-i18n={`workspace.kirim-file.${passwordError}`}>
								{dict.id[passwordError]}
							</p>
						)}
					</div>
					<button class="btn btn--primary" type="submit" data-i18n="workspace.kirim-file.unlock">{dict.id.unlock}</button>
				</form>
			)
		}

		{
			access === 'ok' && r2Ready && (
				<>
					<h1 data-i18n="workspace.kirim-file.readyTitle">{dict.id.readyTitle}</h1>
					<p data-countdown>{formatRemaining(view.remainingMs)}.</p>

					{files.length === 0 ? (
						<p class="empty-state__body" data-i18n="workspace.kirim-file.filesUnreadable">{dict.id.filesUnreadable}</p>
					) : (
						<ul class="share-page__list">
							{files.map((file) => (
								<li class="share-page__item">
									<span>
										{file.name}
										<span class="share-page__size">
											{formatBytes(file.size)}
											{file.remaining !== null && <span data-download-remaining={file.remaining}> · {file.remaining > 0 ? dict.id.remainingDownloads.replace('{count}', String(file.remaining)) : dict.id.downloaded}</span>}
										</span>
									</span>
									{file.remaining === 0 ? (
											<button type="button" class="btn btn--secondary" disabled data-i18n="workspace.kirim-file.downloaded">{dict.id.downloaded}</button>
										) : (
											<form
												method="post"
												data-download-form
												action={file.action}>
												<input type="hidden" name="lang" value="id" />
												{password !== '' && (
													<input type="hidden" name="password" value={password} />
												)}
												<button type="submit" class="btn btn--primary" data-i18n="workspace.kirim-file.download">{dict.id.download}</button>
											</form>
									)}
								</li>
							))}
						</ul>
					)}

					{maxDownloads !== null && (maxDownloads === 1 ? (
						<p class="field-hint" data-i18n={`workspace.kirim-file.${files.length === 1 ? 'onceSingle' : 'oneTimeHint'}`}>{files.length === 1 ? dict.id.onceSingle : dict.id.oneTimeHint}</p>
					) : (
						<p class="field-hint" data-download-limit={maxDownloads}>{dict.id.limitDownloads.replace('{count}', String(maxDownloads))}</p>
					))}

					<button type="button" class="btn btn--ghost" data-report-open data-i18n="workspace.kirim-file.reportOpen">{dict.id.reportOpen}</button>

					<Modal id="report-modal" labelledby="report-title">
						<h2 id="report-title" data-i18n="workspace.kirim-file.reportTitle">{dict.id.reportTitle}</h2>
						<p class="field-hint" data-i18n="workspace.kirim-file.reportHint">{dict.id.reportHint}</p>
						<form data-report-form class="share-page__report">
							<label class="field-label" for="report-reason" data-i18n="workspace.kirim-file.reason">{dict.id.reason}</label>
							<textarea
								id="report-reason"
								class="field-input"
								rows="3"
								maxlength="500"
								required></textarea>
							<div class="pane-actions">
								<button type="submit" class="btn btn--primary" data-i18n="workspace.kirim-file.reportSend">{dict.id.reportSend}</button>
								<button type="button" class="btn btn--secondary" data-report-close data-i18n="workspace.kirim-file.dismiss">{dict.id.dismiss}</button>
							</div>
							<p class="field-hint" data-report-status aria-live="polite"></p>
						</form>
					</Modal>
				</>
			)
		}
	</section>
</Layout>

<script>
	import '../../features/kirim-file/recipient-client';
</script>

<style>
	.share-lock {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-3);
		max-width: 26rem;
	}

	.share-page__list {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
		margin: var(--space-4) 0;
		padding: 0;
		list-style: none;
	}

	.share-page__item {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-3);
		padding: var(--space-3);
		border: 1px solid var(--border);
		border-radius: var(--radius-md);
		background: var(--surface);
	}

	.share-page__item > span {
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
		min-width: 0;
		overflow-wrap: anywhere;
	}

	.share-page__item form {
		margin: 0;
	}

	.share-page__size {
		color: var(--text-muted);
		font-size: 0.875rem;
	}

	.share-page__report {
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
		margin-top: var(--space-3);
	}
</style>
