<script is:inline src="/excalidraw-fonts.js"></script>

<div class="draw-shell">
	<div class="draw-root-host" data-draw-root>
		<!-- Kerangka kanvas: ukurannya sama dengan kanvas asli, jadi tidak ada
		     lompatan tata letak saat Excalidraw selesai dimuat. -->
		<div class="canvas-skeleton" aria-hidden="true">
			<span class="canvas-skeleton__bar"></span>
			<span class="canvas-skeleton__bar canvas-skeleton__bar--short"></span>
			<span class="canvas-skeleton__node"></span>
			<span class="canvas-skeleton__node canvas-skeleton__node--alt"></span>
		</div>
		<p class="sr-only">Menyiapkan kanvas gambar…</p>
	</div>
	<div class="draw-export" role="group" aria-label="Ekspor gambar">
		<button type="button" class="btn btn--secondary" data-copy>Salin gambar</button>
		<button type="button" class="btn btn--secondary" data-export="png">Unduh PNG</button>
		<button type="button" class="btn btn--secondary" data-export="svg">Unduh SVG</button>
		<button type="button" class="btn btn--secondary" data-export="excalidraw">Unduh .excalidraw</button>
		<button type="button" class="btn btn--secondary" data-share>Bagikan</button>
	</div>
	<div class="draw-share-result" data-share-result hidden>
		<label class="sr-only" for="draw-share-url">Link hanya-baca</label>
		<input class="field-input" id="draw-share-url" readonly />
		<button type="button" class="btn btn--secondary" id="draw-share-copy">Salin link</button>
	</div>
</div>

<script>
	import { copyText } from '../../lib/clipboard';
	import { buildSessionUrl, encodeSession, SessionTooLargeError } from '../../lib/share-session';
	import { toast } from '../../lib/toast';
	import { mountDraw } from './mount-draw';

	mountDraw(document.querySelector('[data-draw-root]'));

	const shareButton = document.querySelector<HTMLButtonElement>('[data-share]');
	const shareResult = document.querySelector<HTMLElement>('[data-share-result]');
	const shareUrl = document.getElementById('draw-share-url') as HTMLInputElement | null;
	const shareCopy = document.getElementById('draw-share-copy');

	shareButton?.addEventListener('click', async () => {
		const api = window.toolsmanDraw;
		if (!api) {
			toast('Kanvas belum siap. Tunggu sebentar.', { tone: 'error' });
			return;
		}

		try {
			const token = await encodeSession({ v: 1, type: 'draw', scene: api.getScene() });
			const url = buildSessionUrl(`${location.origin}/tools/draw/`, token);
			if (shareUrl && shareResult) {
				shareUrl.value = url;
				shareResult.hidden = false;
			}
			const copied = await copyText(url);
			toast(
				copied
					? `Link hanya-baca disalin (${url.length} karakter).`
					: `Link dibuat (${url.length} karakter). Salin dari kolom.`,
				{ tone: copied ? 'success' : 'neutral' },
			);
		} catch (error) {
			if (shareResult) shareResult.hidden = true;
			if (error instanceof SessionTooLargeError) {
				toast(
					`Kanvas terlalu besar untuk link (${error.length.toLocaleString('id-ID')} dari ${error.limit.toLocaleString('id-ID')} karakter). Hapus beberapa elemen atau gambar, lalu coba lagi.`,
					{ tone: 'error' },
				);
				return;
			}
			toast(error instanceof Error ? error.message : 'Gagal membuat link.', { tone: 'error' });
		}
	});

	shareCopy?.addEventListener('click', async () => {
		if (!shareUrl) return;
		const copied = await copyText(shareUrl.value);
		toast(copied ? 'Link disalin.' : 'Gagal menyalin. Pilih linknya lalu tekan Ctrl+C.', { tone: copied ? 'success' : 'error' });
	});

	const download = (name: string, blob: Blob) => {
		const url = URL.createObjectURL(blob);
		const link = document.createElement('a');
		link.href = url;
		link.download = name;
		document.body.append(link);
		link.click();
		link.remove();
		setTimeout(() => URL.revokeObjectURL(url), 1000);
	};

	const safeName = (value: string) => {
		const cleaned = value.trim().replace(/[^\w\- ]+/g, '').replace(/\s+/g, '-').toLowerCase();
		return cleaned === '' ? 'gambar' : cleaned;
	};

	document.querySelector<HTMLButtonElement>('[data-copy]')?.addEventListener('click', async () => {
		const api = window.toolsmanDraw;
		if (!api) {
			toast('Kanvas belum siap. Tunggu sebentar.', { tone: 'error' });
			return;
		}

		if (!navigator.clipboard?.write || typeof ClipboardItem === 'undefined') {
			toast('Peramban ini belum mendukung salin gambar. Pakai Unduh PNG.', { tone: 'error' });
			return;
		}

		try {
			const blob = await api.getBlob('png');
			if (!blob) {
				toast('Gagal membuat gambar.', { tone: 'error' });
				return;
			}
			await navigator.clipboard.write([new ClipboardItem({ 'image/png': blob })]);
			toast('Gambar disalin ke clipboard.', { tone: 'success' });
		} catch {
			toast('Gagal menyalin gambar. Coba Unduh PNG.', { tone: 'error' });
		}
	});

	document.querySelectorAll<HTMLButtonElement>('[data-export]').forEach((button) => {
		button.addEventListener('click', async () => {
			const format = button.dataset.export as 'png' | 'svg' | 'excalidraw';
			const api = window.toolsmanDraw;
			if (!api) {
				toast('Kanvas belum siap. Tunggu sebentar.', { tone: 'error' });
				return;
			}
			const extension = format === 'excalidraw' ? 'excalidraw' : format;
			const blob = await api.getBlob(format === 'excalidraw' ? 'json' : format);
			if (!blob) {
				toast('Gagal membuat berkas ekspor.', { tone: 'error' });
				return;
			}
			download(`${safeName(api.name())}.${extension}`, blob);
			toast('Berkas diunduh.', { tone: 'success' });
		});
	});
</script>

<style>
