	}

	.canvas-skeleton__node {
		width: 160px;
		height: 90px;
	}

	.canvas-skeleton__node {
		top: 140px;
		left: 32px;
	}

	.canvas-skeleton__node--alt {
		top: 220px;
		left: 220px;
		width: 120px;
		height: 70px;
	}

	.draw-root {
		display: flex;
		flex-direction: column;
		flex: 1;
		min-height: 0;
	}

	.draw-bar {
		display: flex;
		flex-wrap: wrap;
