---
import dict from './i18n';
---
<script is:inline src="/excalidraw-fonts.js"></script>

<div class="draw-shell">
	<div class="draw-root-host" data-draw-root>
		<!-- Kerangka kanvas: ukurannya sama dengan kanvas asli, jadi tidak ada
		     lompatan tata letak saat Excalidraw selesai dimuat. -->
		<div class="canvas-skeleton" aria-hidden="true">
			<span class="canvas-skeleton__bar"></span>
			<span class="canvas-skeleton__bar canvas-skeleton__bar--short"></span>
			<span class="canvas-skeleton__node"></span>
			<span class="canvas-skeleton__node canvas-skeleton__node--alt"></span>
		</div>
		<p class="sr-only" data-i18n="workspace.draw.preparing">{dict.id.preparing}</p>
	</div>
	<div class="draw-export" role="group" aria-label={dict.id.export} data-i18n-aria="workspace.draw.export">
		<button type="button" class="btn btn--secondary" data-copy data-i18n="workspace.draw.copyImage">{dict.id.copyImage}</button>
		<button type="button" class="btn btn--secondary" data-export="png" data-task-action data-i18n="workspace.draw.downloadPng">{dict.id.downloadPng}</button>
		<button type="button" class="btn btn--secondary" data-export="svg" data-i18n="workspace.draw.downloadSvg">{dict.id.downloadSvg}</button>
		<button type="button" class="btn btn--secondary" data-export="excalidraw" data-i18n="workspace.draw.downloadScene">{dict.id.downloadScene}</button>
		<button type="button" class="btn btn--secondary" data-share data-i18n="workspace.draw.share">{dict.id.share}</button>
	</div>
	<div class="draw-share-result" data-share-result hidden>
		<label class="sr-only" for="draw-share-url" data-i18n="workspace.draw.readOnlyLink">{dict.id.readOnlyLink}</label>
		<input class="field-input" id="draw-share-url" readonly />
		<button type="button" class="btn btn--secondary" id="draw-share-copy" data-i18n="workspace.draw.copyLink">{dict.id.copyLink}</button>
	</div>
</div>

<script>
 import {tr} from "../../lib/i18n";
 import dict from "./i18n";
	import { copyText } from '../../lib/clipboard';
	import { buildSessionUrl, encodeSession, SessionTooLargeError } from '../../lib/share-session';
	import { toast } from '../../lib/toast';
	import { mountDraw } from './mount-draw';

	mountDraw(document.querySelector('[data-draw-root]'));

	const shareButton = document.querySelector<HTMLButtonElement>('[data-share]');
	const shareResult = document.querySelector<HTMLElement>('[data-share-result]');
	const shareUrl = document.getElementById('draw-share-url') as HTMLInputElement | null;
	const shareCopy = document.getElementById('draw-share-copy');

	shareButton?.addEventListener('click', async () => {
		const api = window.toolsmanDraw;
		if (!api) {
			toast(()=> tr(dict,'notReady'), { tone: 'error' });
			return;
		}

		try {
			const token = await encodeSession({ v: 1, type: 'draw', scene: api.getScene() });
			const url = buildSessionUrl(`${location.origin}/tools/draw/`, token);
			if (shareUrl && shareResult) {
				shareUrl.value = url;
				shareResult.hidden = false;
			}
			const copied = await copyText(url);
			toast(()=> copied
					? tr(dict,'copiedCount',{count:url.length})
					: tr(dict,'createdCount',{count:url.length}),
				{ tone: copied ? 'success' : 'neutral' },
			);
		} catch (error) {
			if (shareResult) shareResult.hidden = true;
			if (error instanceof SessionTooLargeError) {
				toast(()=> tr(dict,'tooLarge',{length:error.length,limit:error.limit}),
					{ tone: 'error' },
				);
				return;
			}
			toast(()=> tr(dict,'linkFailed'), { tone: 'error' });
		}
	});

	shareCopy?.addEventListener('click', async () => {
		if (!shareUrl) return;
		const copied = await copyText(shareUrl.value);
		toast(()=> copied ? tr(dict,'copiedLink') : tr(dict,'copyFailed'), { tone: copied ? 'success' : 'error' });
	});

	const download = (name: string, blob: Blob) => {
		const url = URL.createObjectURL(blob);
		const link = document.createElement('a');
		link.href = url;
		link.download = name;
		document.body.append(link);
		link.click();
		link.remove();
		setTimeout(() => URL.revokeObjectURL(url), 1000);
	};

	const safeName = (value: string) => {
		const defaultFileName = 'gambar';
		const cleaned = value.trim().replace(/[^\w\- ]+/g, '').replace(/\s+/g, '-').toLowerCase();
		return cleaned === '' ? defaultFileName : cleaned;
	};

	document.querySelector<HTMLButtonElement>('[data-copy]')?.addEventListener('click', async () => {
		const api = window.toolsmanDraw;
		if (!api) {
			toast(()=> tr(dict,'notReady'), { tone: 'error' });
			return;
		}

		if (!navigator.clipboard?.write || typeof ClipboardItem === 'undefined') {
			toast(()=> tr(dict,'unsupported'), { tone: 'error' });
			return;
		}

		try {
			const blob = await api.getBlob('png');
			if (!blob) {
				toast(()=> tr(dict,'imageFailed'), { tone: 'error' });
				return;
			}
			await navigator.clipboard.write([new ClipboardItem({ 'image/png': blob })]);
			toast(()=> tr(dict,'imageCopied'), { tone: 'success' });
		} catch {
			toast(()=> tr(dict,'imageCopyFailed'), { tone: 'error' });
		}
	});

	document.querySelectorAll<HTMLButtonElement>('[data-export]').forEach((button) => {
		button.addEventListener('click', async () => {
			const format = button.dataset.export as 'png' | 'svg' | 'excalidraw';
			const api = window.toolsmanDraw;
			if (!api) {
				toast(()=> tr(dict,'notReady'), { tone: 'error' });
				return;
			}
			const extension = format === 'excalidraw' ? 'excalidraw' : format;
			const blob = await api.getBlob(format === 'excalidraw' ? 'json' : format);
			if (!blob) {
				toast(()=> tr(dict,'exportFailed'), { tone: 'error' });
				return;
			}
			download(`${safeName(api.name())}.${extension}`, blob);
			toast(()=> tr(dict,'downloaded'), { tone: 'success' });
		});
	});
</script>

<style>
	.draw-shell {
		display: flex;
		flex-direction: column;
		min-height: calc(100dvh - var(--header-h) - var(--space-4));
		gap: var(--space-3);
	}

	.draw-root-host {
		display: contents;
	}

	.canvas-skeleton {
		position: relative;
		min-height: 560px;
		border: 1px solid var(--border);
		border-radius: var(--radius-md);
		background: var(--surface);
		overflow: hidden;
	}

	.canvas-skeleton__bar,
	.canvas-skeleton__node {
		position: absolute;
		border-radius: var(--radius-sm);
		background: var(--surface-2);
	}

	.canvas-skeleton__bar {
		top: 32px;
		left: 32px;
		width: 180px;
		height: 12px;
	}

	.canvas-skeleton__bar--short {
		top: 56px;
		width: 120px;
	}

	.canvas-skeleton__node {
		width: 160px;
		height: 90px;
	}

	.canvas-skeleton__node {
		top: 140px;
		left: 32px;
	}

	.canvas-skeleton__node--alt {
		top: 220px;
		left: 220px;
		width: 120px;
		height: 70px;
	}

	.draw-root-host :global(.draw-root) {
		display: flex;
		flex-direction: column;
		flex: 1;
		min-height: 0;
	}

	.draw-root-host :global(.draw-bar) {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-3);
		padding: var(--space-2) 0;
	}

	.draw-root-host :global(.draw-name) {
		width: auto;
		min-width: 200px;
	}

	.draw-root-host :global(.draw-canvas) {
		display: flex;
		flex-direction: column;
		position: relative;
		flex: 1;
		min-height: 560px;
		border: 1px solid var(--border);
		border-radius: var(--radius-md);
		overflow: hidden;
		background: var(--surface);
	}

	.draw-root-host :global(.draw-canvas > *) {
		flex: 1 1 auto;
		min-height: 0;
	}

	.draw-root-host :global(.draw-loading) {
		padding: var(--space-5);
	}

	.draw-export {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
	}

	.draw-share-result {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
	}

	.draw-share-result[hidden] {
		display: none;
	}

	.draw-share-result .field-input {
		flex: 1 1 260px;
		font-family: var(--font-mono);
		font-size: 0.8125rem;
	}
</style>

<style is:global>
	.draw-share-banner--warning {
		border-color: var(--danger);
		background: var(--surface-2);
	}

	.draw-share-banner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-3);
		padding: var(--space-2) var(--space-3);
		border: 1px solid var(--border-strong);
		border-radius: var(--radius-md);
		background: var(--accent-soft);
		font-size: 0.875rem;
	}
</style>
