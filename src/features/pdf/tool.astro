---
import dict from './i18n';
import ModePicker from './ModePicker.astro';
import Dropzone from '../../components/ui/Dropzone.astro';
import Progress from '../../components/ui/Progress.astro';
import ResultCard from './ResultCard.astro';
---

<div class="tool-shell pdf-workspace">
	<ModePicker>
		<div data-panel="gabung" class="tool-panel">
			<div class="pdf-panel">
				<p class="mode-explanation" data-i18n="workspace.pdf.explainMerge">{dict.id.explainMerge}</p>
				<div class="file-section-heading"><h2 data-i18n="workspace.pdf.chooseStep">{dict.id.chooseStep}</h2><button type="button" class="btn btn--ghost" data-clear="gabung" hidden data-i18n="workspace.pdf.clearAll">{dict.id.clearAll}</button></div>
				<Dropzone id="gabung-input" label={dict.id.dropMany} labelKey="workspace.pdf.dropMany" accept="application/pdf" multiple hint={dict.id.limits} hintKey="workspace.pdf.limits" />
				<ol class="file-list" data-list="gabung" aria-label={dict.id.fileOrder} data-i18n-aria="workspace.pdf.fileOrder"></ol>
				<p class="field-hint" data-i18n="workspace.pdf.orderHint">{dict.id.orderHint}</p>
				<div class="pane-actions">
					<div class="action-copy"><h2 data-i18n="workspace.pdf.processStep">{dict.id.processStep}</h2><p data-summary="gabung" role="status"></p></div>
					<button type="button" class="btn btn--primary" data-run="gabung" disabled data-i18n="workspace.pdf.mergeDownload">{dict.id.mergeDownload}</button>
				</div>
				<div data-progress="gabung" hidden><Progress label={dict.id.merging} labelKey="workspace.pdf.merging" value={0} /></div>
				<ResultCard mode="gabung" />
				<p class="alert" data-error="gabung" role="alert" hidden><span></span></p>
			</div>
		</div>

		<div data-panel="pisah" class="tool-panel" hidden>
			<div class="pdf-panel">
				<p class="mode-explanation" data-i18n="workspace.pdf.explainSplit">{dict.id.explainSplit}</p>
				<div class="file-section-heading"><h2 data-i18n="workspace.pdf.chooseStep">{dict.id.chooseStep}</h2><button type="button" class="btn btn--ghost" data-clear="pisah" hidden data-i18n="workspace.pdf.clearAll">{dict.id.clearAll}</button></div>
				<Dropzone id="pisah-input" label={dict.id.dropOne} labelKey="workspace.pdf.dropOne" accept="application/pdf" hint={dict.id.limits} hintKey="workspace.pdf.limits" />
				<div class="pdf-meta" data-meta="pisah" hidden></div>
				<h2 class="section-heading" data-i18n="workspace.pdf.optionsStep">{dict.id.optionsStep}</h2>
				<label class="field-label" for="pisah-range" data-i18n="workspace.pdf.pagesTaken">{dict.id.pagesTaken}</label>
				<input id="pisah-range" class="field-input" type="text" inputmode="numeric" placeholder={dict.id.rangePlaceholder} data-i18n-placeholder="workspace.pdf.rangePlaceholder" aria-describedby="pisah-range-hint" />
				<p class="field-hint" id="pisah-range-hint" data-i18n="workspace.pdf.rangeHint">{dict.id.rangeHint}</p>
				<p class="field-error" data-range-error="pisah" hidden role="alert"></p>
				<div class="pane-actions">
					<div class="action-copy"><h2 data-i18n="workspace.pdf.processStep">{dict.id.processStep}</h2><p data-summary="pisah" role="status"></p></div>
					<button type="button" class="btn btn--primary" data-run="pisah" disabled data-i18n="workspace.pdf.splitDownload">{dict.id.splitDownload}</button>
				</div>
				<div data-progress="pisah" hidden><Progress label={dict.id.splitting} labelKey="workspace.pdf.splitting" value={0} /></div>
				<ResultCard mode="pisah" />
				<p class="alert" data-error="pisah" role="alert" hidden><span></span></p>
			</div>
		</div>

		<div data-panel="kompres" class="tool-panel" hidden>
			<div class="pdf-panel">
				<p class="mode-explanation" data-i18n="workspace.pdf.explainCompress">{dict.id.explainCompress}</p>
				<div class="file-section-heading"><h2 data-i18n="workspace.pdf.chooseStep">{dict.id.chooseStep}</h2><button type="button" class="btn btn--ghost" data-clear="kompres" hidden data-i18n="workspace.pdf.clearAll">{dict.id.clearAll}</button></div>
				<Dropzone id="kompres-input" label={dict.id.dropOne} labelKey="workspace.pdf.dropOne" accept="application/pdf" hint={dict.id.limits} hintKey="workspace.pdf.limits" />
				<div class="pdf-meta" data-meta="kompres" hidden></div>
				<h2 class="section-heading" data-i18n="workspace.pdf.optionsStep">{dict.id.optionsStep}</h2>
				<p class="alert" data-i18n="workspace.pdf.compressNotice">{dict.id.compressNotice}</p>
				<fieldset class="fieldset">
					<legend class="field-label" data-i18n="workspace.pdf.level">{dict.id.level}</legend>
					<div class="segmented" role="radiogroup" aria-label={dict.id.level} data-i18n-aria="workspace.pdf.level">
						<button type="button" class="segmented__btn" role="radio" aria-checked="true" data-level="ringan" data-i18n="workspace.pdf.light">{dict.id.light}</button>
						<button type="button" class="segmented__btn" role="radio" aria-checked="false" data-level="sedang" data-i18n="workspace.pdf.medium">{dict.id.medium}</button>
						<button type="button" class="segmented__btn" role="radio" aria-checked="false" data-level="maksimal" data-i18n="workspace.pdf.maximum">{dict.id.maximum}</button>
					</div>
					<p class="field-hint" data-i18n="workspace.pdf.lightHelp">{dict.id.lightHelp}</p>
					<p class="field-hint" data-i18n="workspace.pdf.mediumHelp">{dict.id.mediumHelp}</p>
					<p class="field-hint" data-i18n="workspace.pdf.maximumHelp">{dict.id.maximumHelp}</p>
				</fieldset>
				<div class="pane-actions">
					<div class="action-copy"><h2 data-i18n="workspace.pdf.processStep">{dict.id.processStep}</h2><p data-summary="kompres" role="status"></p></div>
					<button type="button" class="btn btn--primary" data-run="kompres" disabled data-i18n="workspace.pdf.compressDownload">{dict.id.compressDownload}</button>
				</div>
				<div data-progress="kompres" hidden><Progress label={dict.id.compressing} labelKey="workspace.pdf.compressing" value={0} /></div>
				<ResultCard mode="kompres" />
				<p class="alert" data-error="kompres" role="alert" hidden><span></span></p>
			</div>
		</div>

		<div data-panel="gambar" class="tool-panel" hidden>
			<div class="pdf-panel">
				<p class="mode-explanation" data-i18n="workspace.pdf.explainImages">{dict.id.explainImages}</p>
				<div class="file-section-heading"><h2 data-i18n="workspace.pdf.chooseStep">{dict.id.chooseStep}</h2><button type="button" class="btn btn--ghost" data-clear="gambar" hidden data-i18n="workspace.pdf.clearAll">{dict.id.clearAll}</button></div>
				<Dropzone id="gambar-input" label={dict.id.dropImages} labelKey="workspace.pdf.dropImages" accept="image/jpeg,image/png" multiple hint={dict.id.limits} hintKey="workspace.pdf.limits" />
				<ol class="file-list" data-list="gambar" aria-label={dict.id.imageOrder} data-i18n-aria="workspace.pdf.imageOrder"></ol>
				<h2 class="section-heading" data-i18n="workspace.pdf.optionsStep">{dict.id.optionsStep}</h2>
				<div class="form-grid">
					<div>
						<span class="field-label" data-i18n="workspace.pdf.orientation">{dict.id.orientation}</span>
						<div class="segmented" role="radiogroup" aria-label={dict.id.pageOrientation} data-i18n-aria="workspace.pdf.pageOrientation">
							<button type="button" class="segmented__btn" role="radio" aria-checked="true" data-orientation="auto" data-i18n="workspace.pdf.auto">{dict.id.auto}</button>
							<button type="button" class="segmented__btn" role="radio" aria-checked="false" data-orientation="portrait" data-i18n="workspace.pdf.portrait">{dict.id.portrait}</button>
							<button type="button" class="segmented__btn" role="radio" aria-checked="false" data-orientation="landscape" data-i18n="workspace.pdf.landscape">{dict.id.landscape}</button>
						</div>
					</div>
					<div>
						<span class="field-label">Margin</span>
						<div class="segmented" role="radiogroup" aria-label={dict.id.pageMargin} data-i18n-aria="workspace.pdf.pageMargin">
							<button type="button" class="segmented__btn" role="radio" aria-checked="false" data-margin="none" data-i18n="workspace.pdf.none">{dict.id.none}</button>
							<button type="button" class="segmented__btn" role="radio" aria-checked="true" data-margin="small" data-i18n="workspace.pdf.small">{dict.id.small}</button>
							<button type="button" class="segmented__btn" role="radio" aria-checked="false" data-margin="large" data-i18n="workspace.pdf.large">{dict.id.large}</button>
						</div>
					</div>
				</div>
				<div class="pane-actions">
					<div class="action-copy"><h2 data-i18n="workspace.pdf.processStep">{dict.id.processStep}</h2><p data-summary="gambar" role="status"></p></div>
					<button type="button" class="btn btn--primary" data-run="gambar" disabled data-i18n="workspace.pdf.createDownload">{dict.id.createDownload}</button>
				</div>
				<div data-progress="gambar" hidden><Progress label={dict.id.creatingPdf} labelKey="workspace.pdf.creatingPdf" value={0} /></div>
				<ResultCard mode="gambar" />
				<p class="alert" data-error="gambar" role="alert" hidden><span></span></p>
			</div>
		</div>

		<div data-panel="ke-gambar" class="tool-panel" hidden>
			<div class="pdf-panel">
				<p class="mode-explanation" data-i18n="workspace.pdf.explainToImages">{dict.id.explainToImages}</p>
				<div class="file-section-heading"><h2 data-i18n="workspace.pdf.chooseStep">{dict.id.chooseStep}</h2><button type="button" class="btn btn--ghost" data-clear="ke-gambar" hidden data-i18n="workspace.pdf.clearAll">{dict.id.clearAll}</button></div>
				<Dropzone id="ke-gambar-input" label={dict.id.dropOne} labelKey="workspace.pdf.dropOne" accept="application/pdf" hint={dict.id.limits} hintKey="workspace.pdf.limits" />
				<div class="pdf-meta" data-meta="ke-gambar" hidden></div>
				<h2 class="section-heading" data-i18n="workspace.pdf.optionsStep">{dict.id.optionsStep}</h2>
				<div class="form-grid">
					<div>
						<span class="field-label" data-i18n="workspace.pdf.imageFormat">{dict.id.imageFormat}</span>
						<div class="segmented" role="radiogroup" aria-label={dict.id.imageFormat} data-i18n-aria="workspace.pdf.imageFormat">
							<button type="button" class="segmented__btn" role="radio" aria-checked="true" data-image-format="png">PNG</button>
							<button type="button" class="segmented__btn" role="radio" aria-checked="false" data-image-format="jpeg">JPG</button>
						</div>
					</div>
					<div>
						<span class="field-label" data-i18n="workspace.pdf.resolution">{dict.id.resolution}</span>
						<div class="segmented" role="radiogroup" aria-label={dict.id.imageResolution} data-i18n-aria="workspace.pdf.imageResolution">
							<button type="button" class="segmented__btn" role="radio" aria-checked="false" data-dpi="96">96 DPI</button>
							<button type="button" class="segmented__btn" role="radio" aria-checked="true" data-dpi="150">150 DPI</button>
							<button type="button" class="segmented__btn" role="radio" aria-checked="false" data-dpi="300">300 DPI</button>
						</div>
					</div>
				</div>
				<p class="field-hint" data-i18n="workspace.pdf.formatHelp">{dict.id.formatHelp}</p>
				<p class="field-hint" data-i18n="workspace.pdf.dpiHelp">{dict.id.dpiHelp}</p>
				<div class="pane-actions">
					<div class="action-copy"><h2 data-i18n="workspace.pdf.processStep">{dict.id.processStep}</h2><p data-summary="ke-gambar" role="status"></p></div>
					<button type="button" class="btn btn--primary" data-run="ke-gambar" disabled data-i18n="workspace.pdf.toImages">{dict.id.toImages}</button>
				</div>
				<div data-progress="ke-gambar" hidden><Progress label={dict.id.creatingImages} labelKey="workspace.pdf.creatingImages" value={0} /></div>
				<p class="alert" data-error="ke-gambar" role="alert" hidden><span></span></p>
				<ResultCard mode="ke-gambar" />
			</div>
		</div>

		<div data-panel="halaman" class="tool-panel" hidden>
			<div class="pdf-panel">
				<p class="mode-explanation" data-i18n="workspace.pdf.explainEdit">{dict.id.explainEdit}</p>
				<div class="file-section-heading"><h2 data-i18n="workspace.pdf.chooseStep">{dict.id.chooseStep}</h2><button type="button" class="btn btn--ghost" data-clear="halaman" hidden data-i18n="workspace.pdf.clearAll">{dict.id.clearAll}</button></div>
				<Dropzone id="halaman-input" label={dict.id.dropOne} labelKey="workspace.pdf.dropOne" accept="application/pdf" hint={dict.id.limits} hintKey="workspace.pdf.limits" />
				<div class="pdf-meta" data-meta="halaman" hidden></div>
				<h2 class="section-heading" data-i18n="workspace.pdf.optionsStep">{dict.id.optionsStep}</h2>
				<p class="field-hint" data-i18n="workspace.pdf.editHint">{dict.id.editHint}</p>
				<ol class="page-list" data-page-list aria-label={dict.id.pdfPages} data-i18n-aria="workspace.pdf.pdfPages"></ol>
				<div class="pane-actions">
					<div class="action-copy"><h2 data-i18n="workspace.pdf.processStep">{dict.id.processStep}</h2><p data-summary="halaman" role="status"></p></div>
					<button type="button" class="btn btn--primary" data-run="halaman" disabled data-i18n="workspace.pdf.saveDownload">{dict.id.saveDownload}</button>
				</div>
				<div data-progress="halaman" hidden><Progress label={dict.id.saving} labelKey="workspace.pdf.saving" value={0} /></div>
				<ResultCard mode="halaman" />
				<p class="alert" data-error="halaman" role="alert" hidden><span></span></p>
			</div>
		</div>
	</ModePicker>
</div>

<script>
 import {tr, currentLang, workspaceErrorMessage} from "../../lib/i18n";
 import {localizedText} from "../../lib/i18n-client";
 import dict from "./i18n";
	import { formatBytes, parsePageRange } from '../../lib/page-range';
	import { setDropzoneState } from '../../lib/dropzone';
	import { toast } from '../../lib/toast';
	import { runPdfTask } from './pdf-client';
	import type { CompressLevel, Margin, Orientation } from './pdf-ops';
	import { describeAction, type PdfMode } from './workspace-state';
	import { compareSizes, currentResult, type WorkspaceResult } from './result-state';
	import { supportedFile } from './file-errors';

	type ReadState = 'reading' | 'ready' | 'failed';

	type Named = {
		file: File;
		id: string;
		status: ReadState;
		pages?: number;
		previewUrl?: string;
		thumbUrl?: string;
		error?: unknown;
	};

	const $ = <T extends HTMLElement>(selector: string, root: ParentNode = document) =>
		root.querySelector<T>(selector);

	const setError = (name: string, message: (()=>string) | null) => {
		const box = $<HTMLElement>(`[data-error="${name}"]`);
		if (!box) return;
		box.hidden = message === null;
		const span = box.querySelector('span');
		localizedText(span, message ?? (()=>''));
	};

	const setProgress = (name: string, done: number, total: number, label: ()=>string) => {
		const wrap = $<HTMLElement>(`[data-progress="${name}"]`);
		if (!wrap) return;
		wrap.hidden = false;
		const bar = wrap.querySelector<HTMLElement>('[role="progressbar"]');
		const percent = total > 0 ? Math.round((done / total) * 100) : 0;
		bar?.setAttribute('aria-valuenow', String(percent));
		const fill = wrap.querySelector<HTMLElement>('.progress__bar');
		if (fill) fill.style.width = `${percent}%`;
		const hint = wrap.querySelector<HTMLElement>('.text-ink-muted');
		if (hint) localizedText(hint, () => total > 0 ? tr(dict,'progress',{done,total}) : label());
	};

	const hideProgress = (name: string) => {
		const wrap = $<HTMLElement>(`[data-progress="${name}"]`);
		if (wrap) wrap.hidden = true;
	};

	const readBytes = (file: File) => file.arrayBuffer();

	const revoke = (url?: string) => {
		if (url) URL.revokeObjectURL(url);
	};

	const readPdfInfo = async (file: File) => {
		const task = runPdfTask({ op: 'preview', file: await readBytes(file) });
		const result = await task.promise;
		const previewUrl = result.preview
			? URL.createObjectURL(
					new Blob([result.preview.bytes as BlobPart], { type: result.preview.mime }),
				)
			: undefined;
		return { pages: result.pageCount ?? 0, previewUrl };
	};

	const download = (name: string, bytes: Uint8Array, mime = 'application/pdf') => {
		const blob = new Blob([bytes as BlobPart], { type: mime });
		const url = URL.createObjectURL(blob);
		const link = document.createElement('a');
		link.href = url;
		link.download = name;
		document.body.append(link);
		link.click();
		link.remove();
		setTimeout(() => URL.revokeObjectURL(url), 1000);
	};

	const renderList = (name: string, items: Named[], onChange: () => void) => {
		const list = $<HTMLOListElement>(`[data-list="${name}"]`);
		if (!list) return;
		list.innerHTML = '';
		items.forEach((item, index) => {
			const li = document.createElement('li');
			li.className = 'file-card';
			li.dataset.state = item.status;

			if (name === 'gabung') {
				li.draggable = true;
				li.addEventListener('dragstart', (event) => {
					if (!event.dataTransfer) return;
					event.dataTransfer.effectAllowed = 'move';
					event.dataTransfer.setData('text/plain', String(index));
					li.classList.add('file-card--dragging');
				});
				li.addEventListener('dragend', () => {
					li.classList.remove('file-card--dragging');
				});
				li.addEventListener('dragover', (event) => {
					event.preventDefault();
					if (event.dataTransfer) event.dataTransfer.dropEffect = 'move';
					li.classList.add('file-card--dragover');
				});
				li.addEventListener('dragleave', () => {
					li.classList.remove('file-card--dragover');
				});
				li.addEventListener('drop', (event) => {
					event.preventDefault();
					li.classList.remove('file-card--dragover');
					const raw = event.dataTransfer?.getData('text/plain') ?? '';
					const from = Number(raw);
					if (!Number.isInteger(from) || from === index) return;
					const [moved] = items.splice(from, 1);
					if (!moved) return;
					items.splice(index, 0, moved);
					renderList(name, items, onChange);
					onChange();
					toast(() => tr(dict, 'orderChanged'), { tone: 'success' });
				});
			}

			const thumb = document.createElement('span');
			thumb.className = 'file-card__thumb';
			const imageUrl = item.previewUrl ?? item.thumbUrl;
			if (imageUrl) {
				const img = document.createElement('img');
				img.src = imageUrl;
				img.alt = '';
				img.loading = 'lazy';
				thumb.append(img);
			} else if (item.status === 'reading') {
				const spinner = document.createElement('span');
				spinner.className = 'spinner';
				spinner.setAttribute('aria-hidden', 'true');
				thumb.append(spinner);
			} else {
				thumb.textContent = 'PDF';
			}

			const info = document.createElement('span');
			info.className = 'file-card__info';

			const label = document.createElement('span');
			label.className = 'file-card__name';
			label.textContent = item.file.name;
			label.title = item.file.name;

			const meta = document.createElement('span');
			meta.className = 'file-card__meta';
			if (item.status === 'reading') {
				meta.textContent = formatBytes(item.file.size);
			} else if (item.status === 'failed') {
				meta.textContent = formatBytes(item.file.size);
				meta.classList.add('is-failed');
			} else if (item.pages !== undefined) {
				localizedText(meta, () => tr(dict, 'pageMeta', {pages:item.pages!, size:formatBytes(item.file.size)}));
				meta.classList.add('is-ready');
			} else {
				meta.textContent = formatBytes(item.file.size);
				meta.classList.add('is-ready');
			}

			info.append(label, meta);
			const badge = document.createElement('span');
			badge.className = 'file-badge';
			localizedText(badge, () => tr(dict, item.status === 'ready' ? 'readyBadge' : item.status === 'reading' ? 'readingBadge' : 'failedBadge'));

			const up = document.createElement('button');
			up.type = 'button';
			up.className = 'icon-button';
			up.setAttribute('aria-label', tr(dict,'moveUp',{name:item.file.name}));
			up.title = up.getAttribute('aria-label')!;
			up.textContent = '▲';
			up.disabled = index === 0;
			up.addEventListener('click', () => {
				[items[index - 1], items[index]] = [items[index]!, items[index - 1]!];
				renderList(name, items, onChange);
				onChange();
			});

			const down = document.createElement('button');
			down.type = 'button';
			down.className = 'icon-button';
			down.setAttribute('aria-label', tr(dict,'moveDown',{name:item.file.name}));
			down.title = down.getAttribute('aria-label')!;
			down.textContent = '▼';
			down.disabled = index === items.length - 1;
			down.addEventListener('click', () => {
				[items[index], items[index + 1]] = [items[index + 1]!, items[index]!];
				renderList(name, items, onChange);
				onChange();
			});

			const remove = document.createElement('button');
			remove.type = 'button';
			remove.className = 'icon-button';
			remove.setAttribute('aria-label', tr(dict,'removeFile',{name:item.file.name}));
			remove.title = remove.getAttribute('aria-label')!;
			remove.textContent = '×';
			remove.addEventListener('click', () => {
				const [removed] = items.splice(index, 1);
				revoke(removed?.previewUrl);
				revoke(removed?.thumbUrl);
				renderList(name, items, onChange);
				onChange();
			});

			const controls = document.createElement('span');
			controls.className = 'file-controls';
			controls.append(up, down, remove);
			li.append(thumb, info, badge, controls);
			list.append(li);
		});
		syncWorkspace();
	};

	const runButton = (name: string) => $<HTMLButtonElement>(`[data-run="${name}"]`);

	let uid = 0;
	const nextUid = () => `f${(uid += 1)}`;

	const mergeItems: Named[] = [];
	const imageItems: Named[] = [];
	let splitFile: File | null = null;
	let splitPageCount = 0;
	let compressFile: File | null = null;
	let compressLevel: CompressLevel = 'ringan';
	let orientation: Orientation = 'auto';
	let margin: Margin = 'small';

	let toImageFile: File | null = null;
	let imageFormat: 'png' | 'jpeg' = 'png';
	let imageDpi = 150;

	let pageFile: File | null = null;
	let pageCount = 0;
	let pageRotations: number[] = [];
	let pageRemoved: boolean[] = [];
	let splitPreviewUrl: string | undefined;
	let compressPreviewUrl: string | undefined;
	let toImagePreviewUrl: string | undefined;
	let pagePreviewUrl: string | undefined;
	const singlePages: Record<string, number> = {};
	const revisions: Record<string, number> = {};
	const busy = new Set<string>();
	const results: Partial<Record<string, WorkspaceResult>> = {};
	const zipping = new Set<string>();
	const nextRevision = (name: string) => (revisions[name] = (revisions[name] ?? 0) + 1);


	const updateGabung = () => {
		runButton('gabung')!.disabled =
			mergeItems.length < 2 || mergeItems.some((item) => item.status !== 'ready');
		syncWorkspace();
	};

	const updateGambar = () => {
		runButton('gambar')!.disabled =
			imageItems.length === 0 || imageItems.some((item) => item.status !== 'ready');
		syncWorkspace();
	};

	const updateToImage = () => {
		runButton('ke-gambar')!.disabled = toImageFile === null;
		syncWorkspace();
	};

	const updatePageEdit = () => {
		const kept = pageCount - pageRemoved.filter(Boolean).length;
		const changed = pageRotations.some((angle) => angle !== 0) || pageRemoved.some(Boolean);
		runButton('halaman')!.disabled = pageFile === null || kept === 0 || !changed;
		syncWorkspace();
	};

	const updateSplit = () => {
		const input = $<HTMLInputElement>('#pisah-range');
		const err = $<HTMLElement>('[data-range-error="pisah"]');
		if (!input || !err) return;
		if (!splitFile || splitPageCount === 0) {
			runButton('pisah')!.disabled = true;
			err.hidden = true;
			syncWorkspace();
			return;
		}
		const value = input.value.trim();
		const result = parsePageRange(value, splitPageCount, currentLang());
		err.hidden = value === '' || result.ok;
		localizedText(err,()=>{const result=parsePageRange(value,splitPageCount,currentLang());return result.ok?'':result.message;});
		runButton('pisah')!.disabled = !result.ok;
		syncWorkspace();
	};

	const readItems = async (items: Named[], done: () => void) => {
		for (const item of items) {
			try {
				const info = await readPdfInfo(item.file);
				if (!mergeItems.includes(item)) {
					revoke(info.previewUrl);
					continue;
				}
				item.pages = info.pages;
				item.previewUrl = info.previewUrl;
				item.status = 'ready';
			} catch (error) {
				if (!mergeItems.includes(item)) continue;
				item.status = 'failed';
				item.error = error;
				setError('gabung', () => workspaceErrorMessage(error, tr(dict, 'corruptPdf')));
			}
			done();
		}
	};

	const addMergeFiles = (files: FileList | null) => {
		if (!files) return;
		setError('gabung', null);
		const added: Named[] = acceptedFiles(Array.from(files), 'gabung', 'pdf').map((file) => ({
			file,
			id: nextUid(),
			status: 'reading',
		}));
		mergeItems.push(...added);
		renderList('gabung', mergeItems, updateGabung);
		updateGabung();
		void readItems(added, () => {
			renderList('gabung', mergeItems, updateGabung);
			updateGabung();
		});
	};

	const addImageFiles = (files: FileList | null) => {
		if (!files) return;
		setError('gambar', null);
		acceptedFiles(Array.from(files), 'gambar', 'image').forEach((file) =>
			imageItems.push({
				file,
				id: nextUid(),
				status: 'ready',
				thumbUrl: URL.createObjectURL(file),
			}),
		);
		renderList('gambar', imageItems, updateGambar);
		updateGambar();
	};

	const renderMetaCard = (
		name: string,
		file: File,
		options: { loading?: boolean; pages?: number; previewUrl?: string; error?: unknown },
	) => {
		const meta = $<HTMLElement>(`[data-meta="${name}"]`);
		if (!meta) return;
		meta.hidden = false;
		meta.innerHTML = '';

		const card = document.createElement('div');
		card.className = 'meta-card';

		const thumb = document.createElement('span');
		thumb.className = 'meta-card__thumb';
		if (options.previewUrl) {
			const img = document.createElement('img');
			img.src = options.previewUrl;
			img.alt = '';
			thumb.append(img);
		} else if (options.loading) {
			const spinner = document.createElement('span');
			spinner.className = 'spinner';
			spinner.setAttribute('aria-hidden', 'true');
			thumb.append(spinner);
		} else {
			thumb.textContent = 'PDF';
		}

		const info = document.createElement('span');
		info.className = 'meta-card__info';

		const line = document.createElement('span');
		line.className = 'file-card__name';
		line.textContent = file.name;
		line.title = file.name;

		const sub = document.createElement('span');
		sub.className = 'file-card__meta';
		if (options.loading) {
			sub.textContent = formatBytes(file.size);
		} else if (options.error) {
			localizedText(sub, () => workspaceErrorMessage(options.error, tr(dict, 'corruptPdf')));
			sub.classList.add('is-failed');
		} else {
			localizedText(sub, () => tr(dict,'pageMeta',{pages:options.pages??0,size:formatBytes(file.size)}));
			sub.classList.add('is-ready');
		}

		info.append(line, sub);
		const badge = document.createElement('span');
		badge.className = 'file-badge';
		localizedText(badge, () => tr(dict, options.loading ? 'readingBadge' : options.error ? 'failedBadge' : 'readyBadge'));
		card.dataset.state = options.loading ? 'reading' : options.error ? 'failed' : 'ready';
		card.append(thumb, info, badge);
		meta.append(card);
		singlePages[name] = options.pages ?? 0;
		syncWorkspace();
	};

	const showPdfLoading = (name: string, file: File) =>
		renderMetaCard(name, file, { loading: true });

	const showPdfMeta = (name: string, file: File, pages: number, previewUrl?: string) =>
		renderMetaCard(name, file, { pages, previewUrl });

	const renderPageList = () => {
		const list = $<HTMLOListElement>('[data-page-list]');
		if (!list) return;
		list.innerHTML = '';

		for (let index = 0; index < pageCount; index += 1) {
			const li = document.createElement('li');
			li.className = 'page-card';
			if (pageRemoved[index]) li.classList.add('page-card--removed');

			const name = document.createElement('span');
			name.className = 'page-card__name';
			localizedText(name, () => tr(dict,'page',{page:index+1}));

			const angle = document.createElement('span');
			angle.className = 'page-card__angle';
			angle.textContent = `${pageRotations[index] ?? 0}°`;

			const rotate = document.createElement('button');
			rotate.type = 'button';
			rotate.className = 'icon-button';
			rotate.setAttribute('aria-label', tr(dict,'rotatePage',{page:index+1}));
			rotate.textContent = '↻';
			rotate.addEventListener('click', () => {
				pageRotations[index] = ((pageRotations[index] ?? 0) + 90) % 360;
				renderPageList();
				updatePageEdit();
			});

			const remove = document.createElement('button');
			remove.type = 'button';
			remove.className = 'icon-button';
			remove.setAttribute('aria-pressed', pageRemoved[index] ? 'true' : 'false');
			localizedText(remove, () => pageRemoved[index] ? tr(dict, 'cancel') : tr(dict, 'remove'));
			remove.setAttribute('aria-label', tr(dict,'removePage',{page:index+1}));
			remove.addEventListener('click', () => {
				pageRemoved[index] = !pageRemoved[index];
				renderPageList();
				updatePageEdit();
			});

			li.append(name, angle, rotate, remove);
			list.append(li);
		}
	};

	function acceptedFiles(files: File[], mode: string, kind: 'pdf' | 'image') {
		const rejected = files.filter((file) => !supportedFile(file, kind));
		if (rejected.length) setError(mode, () => rejected.map((file) => tr(dict, kind === 'pdf' ? 'notPdf' : 'notImage', { name: file.name })).join(' · '));
		return files.filter((file) => supportedFile(file, kind));
	}

	function signature(mode: string) {
		if (mode === 'gabung') return JSON.stringify(mergeItems.map((item) => [item.id, item.status]));
		if (mode === 'gambar') return JSON.stringify([imageItems.map((item) => item.id), orientation, margin]);
		return JSON.stringify([revisions[mode], mode === 'pisah' ? $<HTMLInputElement>('#pisah-range')?.value : mode === 'kompres' ? compressLevel : mode === 'ke-gambar' ? [imageFormat, imageDpi] : [pageRotations, pageRemoved]]);
	}

	function renderResult(mode: string) {
		const box = $<HTMLElement>(`[data-result="${mode}"]`)!;
		const result = currentResult(results[mode], signature(mode));
		results[mode] = result;
		box.hidden = !result;
		if (!result) {
			box.querySelector('[data-result-images]')!.replaceChildren();
			return;
		}
		const size = result.files.reduce((sum, file) => sum + file.bytes.byteLength, 0);
		box.querySelector<HTMLElement>('[data-result-name]')!.textContent = result.name;
		box.querySelector<HTMLElement>('[data-result-meta]')!.textContent = tr(dict, mode === 'ke-gambar' ? 'imageResultMeta' : 'resultMeta', { size: formatBytes(size), pages: result.pages });
		const comparison = box.querySelector<HTMLElement>('[data-result-comparison]')!;
		comparison.hidden = result.before === undefined;
		const warning = box.querySelector<HTMLElement>('[data-result-warning]')!;
		warning.hidden = true;
		if (result.before !== undefined) {
			const change = compareSizes(result.before, size);
			comparison.textContent = `${formatBytes(result.before)} → ${formatBytes(size)} · ${change.direction === 'equal' ? tr(dict, 'sameSize') : tr(dict, change.smaller ? 'saved' : 'larger', { saved: change.percent })}`;
			warning.hidden = change.smaller;
		}
		const save = box.querySelector<HTMLButtonElement>('[data-result-download]')!;
		save.textContent = tr(dict, mode === 'ke-gambar' ? 'downloadAll' : 'download');
		save.dataset.i18n = `workspace.pdf.${mode === 'ke-gambar' ? 'downloadAll' : 'download'}`;
		save.className = `btn btn--${warning.hidden ? 'primary' : 'secondary'}`;
		save.disabled = zipping.has(mode);
		const list = box.querySelector<HTMLOListElement>('[data-result-images]')!;
		list.replaceChildren();
		if (mode === 'ke-gambar') result.files.forEach((file) => {
			const row = document.createElement('li');
			row.className = 'output-image';
			const name = document.createElement('span');
			name.textContent = `${file.name} · ${formatBytes(file.bytes.byteLength)}`;
			const button = document.createElement('button');
			button.type = 'button';
			button.className = 'btn btn--secondary';
			button.textContent = tr(dict, 'download');
			button.setAttribute('aria-label', tr(dict, 'downloadFile', { name: file.name }));
			button.addEventListener('click', () => download(file.name, file.bytes, file.mime));
			row.append(name, button);
			list.append(row);
		});
	}

	document.querySelector<HTMLInputElement>('#gabung-input')?.addEventListener('change', (event) => {
		addMergeFiles((event.target as HTMLInputElement).files);
		(event.target as HTMLInputElement).value = '';
	});

	document.querySelector<HTMLInputElement>('#gambar-input')?.addEventListener('change', (event) => {
		addImageFiles((event.target as HTMLInputElement).files);
		(event.target as HTMLInputElement).value = '';
	});

	document.querySelector<HTMLInputElement>('#pisah-input')?.addEventListener('change', async (event) => {
		const input = event.target as HTMLInputElement;
		const file = input.files?.[0] ?? null;
		input.value = '';
		if (!file) return;
		setError('pisah', null);
		if (!acceptedFiles([file], 'pisah', 'pdf').length) return;
		const revision = nextRevision('pisah');

		splitFile = null;
		splitPageCount = 0;
		updateSplit();
		showPdfLoading('pisah', file);

		try {
			const info = await readPdfInfo(file);
			if (revision !== revisions.pisah) { revoke(info.previewUrl); return; }
			revoke(splitPreviewUrl);
			splitPreviewUrl = info.previewUrl;
			splitFile = file;
			splitPageCount = info.pages;
			showPdfMeta('pisah', file, info.pages, info.previewUrl);
			updateSplit();
		} catch (error) {
			if (revision !== revisions.pisah) return;
			revoke(splitPreviewUrl);
			splitPreviewUrl = undefined;
			splitFile = null;
			splitPageCount = 0;
			renderMetaCard('pisah', file, {
				error,
			});
			updateSplit();
		}
	});

	document.querySelector<HTMLInputElement>('#pisah-range')?.addEventListener('input', updateSplit);

	document.querySelector<HTMLInputElement>('#kompres-input')?.addEventListener('change', async (event) => {
		const input = event.target as HTMLInputElement;
		const file = input.files?.[0] ?? null;
		input.value = '';
		if (!file) return;
		setError('kompres', null);
		if (!acceptedFiles([file], 'kompres', 'pdf').length) return;
		const revision = nextRevision('kompres');

		compressFile = null;
		runButton('kompres')!.disabled = true;
		showPdfLoading('kompres', file);

		try {
			const info = await readPdfInfo(file);
			if (revision !== revisions.kompres) { revoke(info.previewUrl); return; }
			revoke(compressPreviewUrl);
			compressPreviewUrl = info.previewUrl;
			compressFile = file;
			showPdfMeta('kompres', file, info.pages, info.previewUrl);
			runButton('kompres')!.disabled = false;
		} catch (error) {
			if (revision !== revisions.kompres) return;
			revoke(compressPreviewUrl);
			compressPreviewUrl = undefined;
			compressFile = null;
			runButton('kompres')!.disabled = true;
			renderMetaCard('kompres', file, {
				error,
			});
		}
	});

	document.querySelector<HTMLInputElement>('#ke-gambar-input')?.addEventListener('change', async (event) => {
		const input = event.target as HTMLInputElement;
		const file = input.files?.[0] ?? null;
		input.value = '';
		if (!file) return;
		setError('ke-gambar', null);
		if (!acceptedFiles([file], 'ke-gambar', 'pdf').length) return;
		const revision = nextRevision('ke-gambar');

		toImageFile = null;
		updateToImage();
		showPdfLoading('ke-gambar', file);

		try {
			const info = await readPdfInfo(file);
			if (revision !== revisions['ke-gambar']) { revoke(info.previewUrl); return; }
			revoke(toImagePreviewUrl);
			toImagePreviewUrl = info.previewUrl;
			toImageFile = file;
			showPdfMeta('ke-gambar', file, info.pages, info.previewUrl);
			updateToImage();
		} catch (error) {
			if (revision !== revisions['ke-gambar']) return;
			revoke(toImagePreviewUrl);
			toImagePreviewUrl = undefined;
			toImageFile = null;
			renderMetaCard('ke-gambar', file, {
				error,
			});
			updateToImage();
		}
	});

	document.querySelector<HTMLInputElement>('#halaman-input')?.addEventListener('change', async (event) => {
		const input = event.target as HTMLInputElement;
		const file = input.files?.[0] ?? null;
		input.value = '';
		if (!file) return;
		setError('halaman', null);
		if (!acceptedFiles([file], 'halaman', 'pdf').length) return;
		const revision = nextRevision('halaman');

		pageFile = null;
		pageCount = 0;
		pageRotations = [];
		pageRemoved = [];
		renderPageList();
		updatePageEdit();
		showPdfLoading('halaman', file);

		try {
			const info = await readPdfInfo(file);
			if (revision !== revisions.halaman) { revoke(info.previewUrl); return; }
			revoke(pagePreviewUrl);
			pagePreviewUrl = info.previewUrl;
			pageFile = file;
			pageCount = info.pages;
			pageRotations = new Array(info.pages).fill(0);
			pageRemoved = new Array(info.pages).fill(false);
			showPdfMeta('halaman', file, info.pages, info.previewUrl);
			renderPageList();
			updatePageEdit();
		} catch (error) {
			if (revision !== revisions.halaman) return;
			revoke(pagePreviewUrl);
			pagePreviewUrl = undefined;
			pageFile = null;
			pageCount = 0;
			pageRotations = [];
			pageRemoved = [];
			renderPageList();
			renderMetaCard('halaman', file, {
				error,
			});
			updatePageEdit();
		}
	});

	document.querySelectorAll<HTMLButtonElement>('[data-image-format]').forEach((button) => {
		button.addEventListener('click', () => {
			imageFormat = button.dataset.imageFormat as 'png' | 'jpeg';
			document.querySelectorAll<HTMLButtonElement>('[data-image-format]').forEach((other) => {
				other.setAttribute('aria-checked', other === button ? 'true' : 'false');
			});
		});
	});

	document.querySelectorAll<HTMLButtonElement>('[data-dpi]').forEach((button) => {
		button.addEventListener('click', () => {
			imageDpi = Number(button.dataset.dpi);
			document.querySelectorAll<HTMLButtonElement>('[data-dpi]').forEach((other) => {
				other.setAttribute('aria-checked', other === button ? 'true' : 'false');
			});
		});
	});

	document.querySelectorAll<HTMLButtonElement>('[data-level]').forEach((button) => {
		button.addEventListener('click', () => {
			compressLevel = button.dataset.level as CompressLevel;
			document.querySelectorAll<HTMLButtonElement>('[data-level]').forEach((other) => {
				other.setAttribute('aria-checked', other === button ? 'true' : 'false');
			});
		});
	});

	document.querySelectorAll<HTMLButtonElement>('[data-orientation]').forEach((button) => {
		button.addEventListener('click', () => {
			orientation = button.dataset.orientation as Orientation;
			document.querySelectorAll<HTMLButtonElement>('[data-orientation]').forEach((other) => {
				other.setAttribute('aria-checked', other === button ? 'true' : 'false');
			});
		});
	});

	document.querySelectorAll<HTMLButtonElement>('[data-margin]').forEach((button) => {
		button.addEventListener('click', () => {
			margin = button.dataset.margin as Margin;
			document.querySelectorAll<HTMLButtonElement>('[data-margin]').forEach((other) => {
				other.setAttribute('aria-checked', other === button ? 'true' : 'false');
			});
		});
	});

	const run = async (name: string, prepare: () => Promise<Parameters<typeof runPdfTask>[0]>, filename: string) => {
		if (busy.has(name)) return;
		const inputSignature = signature(name);
		const pages = name === 'gabung' ? mergeItems.reduce((sum, item) => sum + (item.pages ?? 0), 0) : name === 'gambar' ? imageItems.length : name === 'pisah' ? (() => { const parsed = parsePageRange($<HTMLInputElement>('#pisah-range')!.value, splitPageCount); return parsed.ok ? parsed.pages.length : 0; })() : name === 'halaman' ? pageCount - pageRemoved.filter(Boolean).length : singlePages[name] ?? 0;
		const before = name === 'kompres' ? compressFile?.size : undefined;
		delete results[name];
		busy.add(name);
		const button = runButton(name);
		if (button) {
			button.disabled = true;
			button.setAttribute('aria-busy', 'true');
		}
		const zone = document.querySelector<HTMLElement>(`[data-panel="${name}"] [data-dropzone]`);
		const zoneInput = zone?.querySelector<HTMLInputElement>('[data-dropzone-input]');
		setDropzoneState(zone, 'processing');
		setError(name, null);
		setProgress(name, 0, 0, ()=>tr(dict, 'preparing'));
		syncWorkspace();

		try {
			const task = runPdfTask(await prepare(), (done, total) => setProgress(name, done, total, ()=>''));
			const result = await task.promise;
			if (signature(name) !== inputSignature) return null;
			results[name] = { signature: inputSignature, name: filename, pages: result.pageCount ?? pages, before, files: result.images ?? [{ name: filename, bytes: result.bytes, mime: 'application/pdf' }] };
			renderResult(name);
			$<HTMLElement>(`[data-result="${name}"]`)!.scrollIntoView({ block: 'center', behavior: 'instant' });
			const imageCount = result.images?.length ?? 0;
			toast(() => name === 'ke-gambar' ? tr(dict, 'imagesReady', { count: imageCount }) : tr(dict, 'ready'), { tone: 'success' });
			return result;
		} catch (error) {
			setError(name, ()=>workspaceErrorMessage(error,tr(dict,'processFailed')));
			toast(() => tr(dict, 'processFailed'), { tone: 'error' });
			return null;
		} finally {
			hideProgress(name);
			setDropzoneState(zone, zoneInput?.files?.length ? 'done' : 'empty');
			busy.delete(name);
			if (button) {
				button.disabled = false;
				button.removeAttribute('aria-busy');
			}
			syncWorkspace();
		}
	};

	runButton('gabung')?.addEventListener('click', async () => {
		await run('gabung', async () => ({ op: 'merge', files: await Promise.all(mergeItems.map((item) => readBytes(item.file))) }), 'gabungan.pdf');
	});

	runButton('pisah')?.addEventListener('click', async () => {
		if (!splitFile) return;
		const input = $<HTMLInputElement>('#pisah-range');
		const parsed = parsePageRange(input?.value ?? '', splitPageCount);
		if (!parsed.ok) return;
		const source = splitFile;
		await run('pisah', async () => ({ op: 'split', file: await readBytes(source), pages: parsed.pages }), 'hasil-pisah.pdf');
	});

	runButton('gambar')?.addEventListener('click', async () => {
		await run('gambar', async () => ({ op: 'images', images: await Promise.all(
			imageItems.map(async (item) => ({
				bytes: await readBytes(item.file),
				type: /\.png$/i.test(item.file.name) ? ('png' as const) : ('jpg' as const),
			})),
		), orientation, margin }), 'gambar.pdf');
	});

	runButton('kompres')?.addEventListener('click', async () => {
		if (!compressFile) return;
		const file = compressFile;
		await run(
			'kompres',
			async () => ({ op: 'compress', file: await readBytes(file), level: compressLevel }),
			`${file.name.replace(/\.pdf$/i, '')}-kompres.pdf`,
		);
	});

	runButton('ke-gambar')?.addEventListener('click', async () => {
		if (!toImageFile || busy.has('ke-gambar')) return;
		const file = toImageFile;
		await run('ke-gambar', async () => ({
				op: 'to-images',
				file: await readBytes(file),
				format: imageFormat,
				scale: imageDpi / 72,
			}), 'halaman.zip');
	});

	runButton('halaman')?.addEventListener('click', async () => {
		if (!pageFile) return;
		const file = pageFile;
		const kept = pageCount - pageRemoved.filter(Boolean).length;
		if (kept === 0) return;
		const removed = pageRemoved.flatMap((value, index) => (value ? [index] : []));
		await run(
			'halaman',
			async () => ({
				op: 'edit',
				file: await readBytes(file),
				edits: { rotations: pageRotations, removed },
			}),
			`${file.name.replace(/\.pdf$/i, '')}-diubah.pdf`,
		);
	});
	function syncWorkspace() {
		const panels = document.querySelectorAll<HTMLElement>('.pdf-workspace [data-panel]');
		panels.forEach((panel) => {
			const mode = panel.dataset.panel as PdfMode;
			const items = mode === 'gabung' ? mergeItems : mode === 'gambar' ? imageItems : null;
			const meta = panel.querySelector<HTMLElement>('[data-meta]');
			const filled = items ? items.length > 0 : !!meta && !meta.hidden;
			const parsed = parsePageRange($<HTMLInputElement>('#pisah-range')?.value ?? '', splitPageCount, currentLang());
			const hasFile = mode === 'pisah' ? !!splitFile : mode === 'kompres' ? !!compressFile : mode === 'ke-gambar' ? !!toImageFile : !!pageFile;
			const action = describeAction(mode, {
				files: items?.length ?? Number(filled),
				pages: items ? items.reduce((sum, item) => sum + (item.pages ?? 0), 0) : singlePages[mode] ?? 0,
				selected: mode === 'pisah' ? parsed.ok ? parsed.pages.length : 0 : pageCount - pageRemoved.filter(Boolean).length,
				hasFile,
				pending: items ? items.some((item) => item.status === 'reading') : !!meta?.querySelector('[data-state="reading"]'),
				failed: items ? items.some((item) => item.status === 'failed') : !!meta?.querySelector('[data-state="failed"]'),
				busy: busy.has(mode),
				changed: pageRotations.some((angle) => angle !== 0) || pageRemoved.some(Boolean),
				rangeValid: parsed.ok,
			}, currentLang());
			const summary = panel.querySelector<HTMLElement>('[data-summary]')!;
			summary.id = `pdf-summary-${mode}`;
			summary.textContent = action.reason ?? action.summary;
			const button = runButton(mode)!;
			renderResult(mode);
			const hasResult = !!results[mode];
			const actionKeys = { gabung: 'mergeDownload', pisah: 'splitDownload', kompres: 'compressDownload', gambar: 'createDownload', 'ke-gambar': 'toImages', halaman: 'saveDownload' } as const;
			const labelKey = hasResult ? 'processAgain' : actionKeys[mode];
			button.dataset.i18n = `workspace.pdf.${labelKey}`;
			button.textContent = tr(dict, labelKey);
			button.classList.toggle('btn--primary', !hasResult);
			button.classList.toggle('btn--secondary', hasResult);
			button.disabled = action.reason !== null;
			button.setAttribute('aria-describedby', summary.id);
			const clear = panel.querySelector<HTMLButtonElement>('[data-clear]')!;
			clear.hidden = !filled;
			clear.disabled = busy.has(mode);
			const zone = panel.querySelector<HTMLElement>('[data-dropzone]')!;
			zone.dataset.compact = String(filled);
			setDropzoneState(zone, busy.has(mode) ? 'processing' : 'empty');
			zone.querySelector<HTMLInputElement>('input')!.disabled = busy.has(mode);
			const fileName = zone.querySelector<HTMLElement>('[data-dropzone-file]')!;
			fileName.hidden = true;
			fileName.textContent = '';
			const pick = zone.querySelector<HTMLElement>('.dropzone__pick')!;
			const key = items ? mode === 'gabung' ? 'addPdfs' : 'addImages' : 'replaceFile';
			pick.dataset.i18n = `workspace.pdf.${filled ? key : 'pickFiles'}`;
			pick.textContent = tr(dict, filled ? key : 'pickFiles');
			panel.querySelectorAll<HTMLElement>('.file-controls, [data-page-list], fieldset, .form-grid, #pisah-range').forEach((controls) => { controls.inert = busy.has(mode); });
		});
	}

	document.querySelectorAll<HTMLButtonElement>('[data-clear]').forEach((button) => {
		button.addEventListener('click', () => {
			const mode = button.dataset.clear as PdfMode;
			if (busy.has(mode)) return;
			nextRevision(mode);
			delete results[mode];
			renderResult(mode);
			if (mode === 'gabung' || mode === 'gambar') {
				const items = mode === 'gabung' ? mergeItems : imageItems;
				items.splice(0).forEach((item) => { revoke(item.previewUrl); revoke(item.thumbUrl); });
				renderList(mode, items, mode === 'gabung' ? updateGabung : updateGambar);
			} else {
				const meta = $<HTMLElement>(`[data-meta="${mode}"]`)!;
				meta.hidden = true;
				meta.replaceChildren();
				singlePages[mode] = 0;
				if (mode === 'pisah') {
					splitFile = null;
					splitPageCount = 0;
					revoke(splitPreviewUrl);
					splitPreviewUrl = undefined;
					$<HTMLInputElement>('#pisah-range')!.value = '';
					updateSplit();
				}
				if (mode === 'kompres') {
					compressFile = null;
					revoke(compressPreviewUrl);
					compressPreviewUrl = undefined;
				}
				if (mode === 'ke-gambar') {
					toImageFile = null;
					revoke(toImagePreviewUrl);
					toImagePreviewUrl = undefined;
				}
				if (mode === 'halaman') {
					pageFile = null;
					pageCount = 0;
					pageRotations = [];
					pageRemoved = [];
					revoke(pagePreviewUrl);
					pagePreviewUrl = undefined;
					renderPageList();
				}
			}
			$<HTMLInputElement>(`#${mode}-input`)!.value = '';
			setError(mode, null);
			syncWorkspace();
		});
	});
	document.addEventListener('lang:change', () => {
		renderList('gabung', mergeItems, updateGabung);
		renderList('gambar', imageItems, updateGambar);
		renderPageList();
		syncWorkspace();
	});
	document.querySelectorAll<HTMLButtonElement>('[data-result-again]').forEach((button) => button.addEventListener('click', () => runButton(button.dataset.resultAgain!)?.click()));
	document.querySelectorAll<HTMLButtonElement>('[data-result-reset]').forEach((button) => button.addEventListener('click', () => $<HTMLButtonElement>(`[data-clear="${button.dataset.resultReset}"]`)?.click()));
	document.querySelectorAll<HTMLButtonElement>('[data-result-download]').forEach((button) => button.addEventListener('click', async () => {
		const mode = button.dataset.resultDownload!;
		const result = currentResult(results[mode], signature(mode));
		if (!result || zipping.has(mode)) return;
		if (mode !== 'ke-gambar') {
			const file = result.files[0]!;
			download(file.name, file.bytes, file.mime);
			return;
		}
		zipping.add(mode);
		renderResult(mode);
		try {
			const { zip } = await import('fflate');
			const bytes = await new Promise<Uint8Array>((resolve, reject) => zip(Object.fromEntries(result.files.map((file) => [file.name, file.bytes])), { level: 0 }, (error, data) => error ? reject(error) : resolve(data)));
			if (currentResult(results[mode], signature(mode)) === result) download(result.name, bytes, 'application/zip');
		} catch {
			setError(mode, () => tr(dict, 'zipFailed'));
		} finally {
			zipping.delete(mode);
			renderResult(mode);
		}
	}));
	const workspace = $<HTMLElement>('.pdf-workspace')!;
	for (const event of ['click', 'input', 'change']) workspace.addEventListener(event, () => queueMicrotask(syncWorkspace));
	syncWorkspace();
</script>

