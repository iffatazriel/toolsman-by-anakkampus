---
import Tabs from '../../components/ui/Tabs.astro';
import Dropzone from '../../components/ui/Dropzone.astro';
import Progress from '../../components/ui/Progress.astro';

const tabs = [
	{ id: 'gabung', label: 'Gabung' },
	{ id: 'pisah', label: 'Pisah' },
	{ id: 'kompres', label: 'Kompres' },
	{ id: 'gambar', label: 'Gambar → PDF' },
	{ id: 'ke-gambar', label: 'PDF → Gambar' },
	{ id: 'halaman', label: 'Putar & hapus' },
];
---

<div class="tool-shell">
	<Tabs label="Pilihan alat PDF" items={tabs}>
		<div data-panel="gabung" class="tool-panel">
			<div class="pdf-panel">
				<Dropzone id="gabung-input" label="Seret beberapa PDF ke sini" accept="application/pdf" multiple hint="Maks. 100 MB per berkas · diproses di browser" />
				<ol class="file-list" data-list="gabung" aria-label="Urutan berkas"></ol>
				<p class="field-hint">Seret kartu untuk mengubah urutan, atau pakai tombol ▲ ▼. Urutan ini juga urutan halaman di hasil.</p>
				<div class="pane-actions">
					<button type="button" class="btn btn--primary" data-run="gabung" disabled>Gabung dan unduh</button>
				</div>
				<div data-progress="gabung" hidden><Progress label="Menggabungkan" value={0} /></div>
				<p class="alert" data-error="gabung" role="alert" hidden><span></span></p>
			</div>
		</div>

		<div data-panel="pisah" class="tool-panel" hidden>
			<div class="pdf-panel">
				<Dropzone id="pisah-input" label="Pilih satu PDF" accept="application/pdf" hint="Maks. 100 MB per berkas · diproses di browser" />
				<div class="pdf-meta" data-meta="pisah" hidden></div>
				<label class="field-label" for="pisah-range">Halaman yang diambil</label>
				<input id="pisah-range" class="field-input" type="text" inputmode="numeric" placeholder="mis. 1-3,5" aria-describedby="pisah-range-hint" />
				<p class="field-hint" id="pisah-range-hint">Pisahkan dengan koma. Rentang pakai tanda hubung.</p>
				<p class="field-error" data-range-error="pisah" hidden role="alert"></p>
				<div class="pane-actions">
					<button type="button" class="btn btn--primary" data-run="pisah" disabled>Ambil halaman dan unduh</button>
				</div>
				<div data-progress="pisah" hidden><Progress label="Memisahkan" value={0} /></div>
				<p class="alert" data-error="pisah" role="alert" hidden><span></span></p>
			</div>
		</div>

		<div data-panel="kompres" class="tool-panel" hidden>
			<div class="pdf-panel">
				<Dropzone id="kompres-input" label="Pilih satu PDF" accept="application/pdf" hint="Maks. 100 MB per berkas · diproses di browser" />
				<div class="pdf-meta" data-meta="kompres" hidden></div>
				<fieldset class="fieldset">
					<legend class="field-label">Tingkat kompresi</legend>
					<div class="segmented" role="radiogroup" aria-label="Tingkat kompresi">
						<button type="button" class="segmented__btn" role="radio" aria-checked="true" data-level="ringan">Ringan</button>
						<button type="button" class="segmented__btn" role="radio" aria-checked="false" data-level="sedang">Sedang</button>
						<button type="button" class="segmented__btn" role="radio" aria-checked="false" data-level="maksimal">Maksimal</button>
					</div>
					<p class="field-hint">Ringan menjaga teks dan gambar paling tajam. Maksimal paling kecil, tapi gambar bisa buram.</p>
				</fieldset>
				<div class="compare" data-compare="kompres" hidden aria-live="polite">
					<p class="compare__line"><span data-before></span> → <span data-after></span></p>
					<p class="compare__delta" data-delta></p>
					<p class="alert" data-warn="kompres" hidden><span>Hasil tidak lebih kecil dari berkas asli. Berkasnya tetap bisa diunduh, tapi kompres tidak membantu di sini.</span></p>
				</div>
				<div class="pane-actions">
					<button type="button" class="btn btn--primary" data-run="kompres" disabled>Kompres dan unduh</button>
				</div>
				<div data-progress="kompres" hidden><Progress label="Mengompres" value={0} /></div>
				<p class="alert" data-error="kompres" role="alert" hidden><span></span></p>
			</div>
		</div>

		<div data-panel="gambar" class="tool-panel" hidden>
			<div class="pdf-panel">
				<Dropzone id="gambar-input" label="Pilih JPG atau PNG" accept="image/jpeg,image/png" multiple hint="Maks. 100 MB per berkas · diproses di browser" />
				<ol class="file-list" data-list="gambar" aria-label="Urutan gambar"></ol>
				<div class="form-grid">
					<div>
						<span class="field-label">Orientasi</span>
						<div class="segmented" role="radiogroup" aria-label="Orientasi halaman">
							<button type="button" class="segmented__btn" role="radio" aria-checked="true" data-orientation="auto">Ikuti gambar</button>
							<button type="button" class="segmented__btn" role="radio" aria-checked="false" data-orientation="portrait">Tegak</button>
							<button type="button" class="segmented__btn" role="radio" aria-checked="false" data-orientation="landscape">Mendatar</button>
						</div>
					</div>
					<div>
						<span class="field-label">Margin</span>
						<div class="segmented" role="radiogroup" aria-label="Margin halaman">
							<button type="button" class="segmented__btn" role="radio" aria-checked="false" data-margin="none">Tanpa</button>
							<button type="button" class="segmented__btn" role="radio" aria-checked="true" data-margin="small">Kecil</button>
							<button type="button" class="segmented__btn" role="radio" aria-checked="false" data-margin="large">Besar</button>
						</div>
					</div>
				</div>
				<div class="pane-actions">
					<button type="button" class="btn btn--primary" data-run="gambar" disabled>Buat PDF dan unduh</button>
				</div>
				<div data-progress="gambar" hidden><Progress label="Membuat PDF" value={0} /></div>
				<p class="alert" data-error="gambar" role="alert" hidden><span></span></p>
			</div>
		</div>

		<div data-panel="ke-gambar" class="tool-panel" hidden>
			<div class="pdf-panel">
				<Dropzone id="ke-gambar-input" label="Pilih satu PDF" accept="application/pdf" hint="Maks. 100 MB per berkas · diproses di browser" />
				<div class="pdf-meta" data-meta="ke-gambar" hidden></div>
				<div class="form-grid">
					<div>
						<span class="field-label">Format gambar</span>
						<div class="segmented" role="radiogroup" aria-label="Format gambar">
							<button type="button" class="segmented__btn" role="radio" aria-checked="true" data-image-format="png">PNG</button>
							<button type="button" class="segmented__btn" role="radio" aria-checked="false" data-image-format="jpeg">JPG</button>
						</div>
					</div>
					<div>
						<span class="field-label">Resolusi</span>
						<div class="segmented" role="radiogroup" aria-label="Resolusi gambar">
							<button type="button" class="segmented__btn" role="radio" aria-checked="false" data-dpi="96">96 DPI</button>
							<button type="button" class="segmented__btn" role="radio" aria-checked="true" data-dpi="150">150 DPI</button>
							<button type="button" class="segmented__btn" role="radio" aria-checked="false" data-dpi="300">300 DPI</button>
						</div>
					</div>
				</div>
				<p class="field-hint">300 DPI paling tajam, tapi butuh memori lebih besar untuk PDF dengan banyak halaman.</p>
				<div class="pane-actions">
					<button type="button" class="btn btn--primary" data-run="ke-gambar" disabled>Ubah jadi gambar</button>
				</div>
				<div data-progress="ke-gambar" hidden><Progress label="Membuat gambar" value={0} /></div>
				<p class="alert" data-error="ke-gambar" role="alert" hidden><span></span></p>
				<div data-image-result="ke-gambar" hidden>
					<div class="pane-actions">
						<button type="button" class="btn btn--secondary" data-download-all="ke-gambar">Unduh semua</button>
					</div>
					<p class="field-hint">Peramban bisa memblokir unduhan beruntun. Kalau itu terjadi, pakai tombol Unduh di tiap halaman.</p>
					<ol class="file-list" data-image-list aria-label="Hasil gambar per halaman"></ol>
				</div>
			</div>
		</div>

		<div data-panel="halaman" class="tool-panel" hidden>
			<div class="pdf-panel">
				<Dropzone id="halaman-input" label="Pilih satu PDF" accept="application/pdf" hint="Maks. 100 MB per berkas · diproses di browser" />
				<div class="pdf-meta" data-meta="halaman" hidden></div>
				<p class="field-hint">Tombol ↻ memutar halaman 90°. Tombol Hapus membuang halaman dari hasil. Perubahan baru tersimpan setelah kamu menekan Simpan.</p>
				<ol class="page-list" data-page-list aria-label="Halaman PDF"></ol>
				<div class="pane-actions">
					<button type="button" class="btn btn--primary" data-run="halaman" disabled>Simpan PDF dan unduh</button>
				</div>
				<div data-progress="halaman" hidden><Progress label="Menyimpan" value={0} /></div>
				<p class="alert" data-error="halaman" role="alert" hidden><span></span></p>
			</div>
		</div>
	</Tabs>
</div>

<script>
	import { formatBytes, parsePageRange, reductionPercent } from '../../lib/page-range';
	import { toast } from '../../lib/toast';
	import { runPdfTask } from './pdf-client';
	import type { CompressLevel, Margin, Orientation } from './pdf-ops';

	type ReadState = 'reading' | 'ready' | 'failed';

	type Named = {
		file: File;
		id: string;
		status: ReadState;
		pages?: number;
		previewUrl?: string;
		thumbUrl?: string;
		error?: string;
	};

	const $ = <T extends HTMLElement>(selector: string, root: ParentNode = document) =>
		root.querySelector<T>(selector);

	const setError = (name: string, message: string | null) => {
		const box = $<HTMLElement>(`[data-error="${name}"]`);
		if (!box) return;
		box.hidden = message === null;
		const span = box.querySelector('span');
		if (span) span.textContent = message ?? '';
	};

	const setProgress = (name: string, done: number, total: number, label: string) => {
		const wrap = $<HTMLElement>(`[data-progress="${name}"]`);
		if (!wrap) return;
		wrap.hidden = false;
		const bar = wrap.querySelector<HTMLElement>('[role="progressbar"]');
		const percent = total > 0 ? Math.round((done / total) * 100) : 0;
		bar?.setAttribute('aria-valuenow', String(percent));
		const fill = wrap.querySelector<HTMLElement>('.progress__bar');
		if (fill) fill.style.width = `${percent}%`;
		const hint = wrap.querySelector<HTMLElement>('.text-ink-muted');
		if (hint) hint.textContent = total > 0 ? `${done} / ${total} halaman` : label;
	};

	const hideProgress = (name: string) => {
		const wrap = $<HTMLElement>(`[data-progress="${name}"]`);
		if (wrap) wrap.hidden = true;
	};

	const readBytes = (file: File) => file.arrayBuffer();

	const revoke = (url?: string) => {
		if (url) URL.revokeObjectURL(url);
	};

	const readPdfInfo = async (file: File) => {
		const task = runPdfTask({ op: 'preview', file: await readBytes(file) });
		const result = await task.promise;
		const previewUrl = result.preview
			? URL.createObjectURL(
					new Blob([result.preview.bytes as BlobPart], { type: result.preview.mime }),
				)
			: undefined;
		return { pages: result.pageCount ?? 0, previewUrl };
	};

	const download = (name: string, bytes: Uint8Array, mime = 'application/pdf') => {
		const blob = new Blob([bytes as BlobPart], { type: mime });
		const url = URL.createObjectURL(blob);
		const link = document.createElement('a');
		link.href = url;
		link.download = name;
		document.body.append(link);
		link.click();
		link.remove();
		setTimeout(() => URL.revokeObjectURL(url), 1000);
	};

	const renderList = (name: string, items: Named[], onChange: () => void) => {
		const list = $<HTMLOListElement>(`[data-list="${name}"]`);
		if (!list) return;
		list.innerHTML = '';
		items.forEach((item, index) => {
			const li = document.createElement('li');
			li.className = 'file-card';
			li.dataset.state = item.status;

			if (name === 'gabung') {
				li.draggable = true;
				li.addEventListener('dragstart', (event) => {
					if (!event.dataTransfer) return;
					event.dataTransfer.effectAllowed = 'move';
					event.dataTransfer.setData('text/plain', String(index));
					li.classList.add('file-card--dragging');
				});
				li.addEventListener('dragend', () => {
					li.classList.remove('file-card--dragging');
				});
				li.addEventListener('dragover', (event) => {
					event.preventDefault();
					if (event.dataTransfer) event.dataTransfer.dropEffect = 'move';
					li.classList.add('file-card--dragover');
				});
				li.addEventListener('dragleave', () => {
					li.classList.remove('file-card--dragover');
				});
				li.addEventListener('drop', (event) => {
					event.preventDefault();
					li.classList.remove('file-card--dragover');
					const raw = event.dataTransfer?.getData('text/plain') ?? '';
					const from = Number(raw);
					if (!Number.isInteger(from) || from === index) return;
					const [moved] = items.splice(from, 1);
					if (!moved) return;
					items.splice(index, 0, moved);
					renderList(name, items, onChange);
					onChange();
					toast('Urutan berkas diubah.');
				});
			}

			const thumb = document.createElement('span');
			thumb.className = 'file-card__thumb';
			const imageUrl = item.previewUrl ?? item.thumbUrl;
			if (imageUrl) {
				const img = document.createElement('img');
				img.src = imageUrl;
				img.alt = '';
				img.loading = 'lazy';
				thumb.append(img);
			} else if (item.status === 'reading') {
				const spinner = document.createElement('span');
				spinner.className = 'spinner';
				spinner.setAttribute('aria-hidden', 'true');
				thumb.append(spinner);
			} else {
				thumb.textContent = 'PDF';
			}

			const info = document.createElement('span');
			info.className = 'file-card__info';

			const label = document.createElement('span');
			label.className = 'file-card__name';
			label.textContent = item.file.name;

			const meta = document.createElement('span');
			meta.className = 'file-card__meta';
			if (item.status === 'reading') {
				meta.textContent = 'Membaca PDF…';
			} else if (item.status === 'failed') {
				meta.textContent = item.error ?? 'Tidak bisa dibaca';
				meta.classList.add('is-failed');
			} else if (item.pages !== undefined) {
				meta.textContent = `✓ Siap · ${item.pages} halaman · ${formatBytes(item.file.size)}`;
				meta.classList.add('is-ready');
			} else {
				meta.textContent = `✓ Siap · ${formatBytes(item.file.size)}`;
				meta.classList.add('is-ready');
			}

			info.append(label, meta);

			const up = document.createElement('button');
			up.type = 'button';
			up.className = 'icon-button';
			up.setAttribute('aria-label', `Naikkan ${item.file.name}`);
			up.textContent = '▲';
			up.disabled = index === 0;
			up.addEventListener('click', () => {
				[items[index - 1], items[index]] = [items[index]!, items[index - 1]!];
				renderList(name, items, onChange);
				onChange();
			});

			const down = document.createElement('button');
			down.type = 'button';
			down.className = 'icon-button';
			down.setAttribute('aria-label', `Turunkan ${item.file.name}`);
			down.textContent = '▼';
			down.disabled = index === items.length - 1;
			down.addEventListener('click', () => {
				[items[index], items[index + 1]] = [items[index + 1]!, items[index]!];
				renderList(name, items, onChange);
				onChange();
			});

			const remove = document.createElement('button');
			remove.type = 'button';
			remove.className = 'icon-button';
			remove.setAttribute('aria-label', `Hapus ${item.file.name}`);
			remove.textContent = '×';
			remove.addEventListener('click', () => {
				const [removed] = items.splice(index, 1);
				revoke(removed?.previewUrl);
				revoke(removed?.thumbUrl);
				renderList(name, items, onChange);
				onChange();
			});

			li.append(thumb, info, up, down, remove);
			list.append(li);
		});
	};

	const runButton = (name: string) => $<HTMLButtonElement>(`[data-run="${name}"]`);

	let uid = 0;
	const nextUid = () => `f${(uid += 1)}`;

	const mergeItems: Named[] = [];
	const imageItems: Named[] = [];
	let splitFile: File | null = null;
	let splitPageCount = 0;
	let compressFile: File | null = null;
	let compressLevel: CompressLevel = 'ringan';
	let orientation: Orientation = 'auto';
	let margin: Margin = 'small';
	let compressResult: { before: number; after: number } | null = null;

	let toImageFile: File | null = null;
	let imageFormat: 'png' | 'jpeg' = 'png';
	let imageDpi = 150;
	let renderedImages: { name: string; mime: string; bytes: Uint8Array }[] = [];

	let pageFile: File | null = null;
	let pageCount = 0;
	let pageRotations: number[] = [];
	let pageRemoved: boolean[] = [];
	let splitPreviewUrl: string | undefined;
	let compressPreviewUrl: string | undefined;
	let toImagePreviewUrl: string | undefined;
	let pagePreviewUrl: string | undefined;

	const delay = (ms: number) => new Promise((resolve) => window.setTimeout(resolve, ms));

	const updateGabung = () => {
		runButton('gabung')!.disabled =
			mergeItems.length < 2 || mergeItems.some((item) => item.status !== 'ready');
	};

	const updateGambar = () => {
		runButton('gambar')!.disabled =
			imageItems.length === 0 || imageItems.some((item) => item.status !== 'ready');
	};

	const updateToImage = () => {
		runButton('ke-gambar')!.disabled = toImageFile === null;
	};

	const updatePageEdit = () => {
		const kept = pageCount - pageRemoved.filter(Boolean).length;
		const changed = pageRotations.some((angle) => angle !== 0) || pageRemoved.some(Boolean);
		runButton('halaman')!.disabled = pageFile === null || kept === 0 || !changed;
	};

	const updateSplit = () => {
		const input = $<HTMLInputElement>('#pisah-range');
		const err = $<HTMLElement>('[data-range-error="pisah"]');
		if (!input || !err) return;
		if (!splitFile || splitPageCount === 0) {
			runButton('pisah')!.disabled = true;
			err.hidden = true;
			return;
		}
		const value = input.value.trim();
		const result = parsePageRange(value, splitPageCount);
		err.hidden = value === '' || result.ok;
		if (!result.ok) err.textContent = result.message;
		runButton('pisah')!.disabled = !result.ok;
	};

	const readItems = async (items: Named[], done: () => void) => {
		for (const item of items) {
			try {
				const info = await readPdfInfo(item.file);
				item.pages = info.pages;
				item.previewUrl = info.previewUrl;
				item.status = 'ready';
			} catch {
				item.status = 'failed';
				item.error = 'PDF tidak bisa dibaca';
			}
			done();
		}
	};

	const addMergeFiles = (files: FileList | null) => {
		if (!files) return;
		const added: Named[] = Array.from(files).map((file) => ({
			file,
			id: nextUid(),
			status: 'reading',
		}));
		mergeItems.push(...added);
		renderList('gabung', mergeItems, updateGabung);
		updateGabung();
		void readItems(added, () => {
			renderList('gabung', mergeItems, updateGabung);
			updateGabung();
		});
	};

	const addImageFiles = (files: FileList | null) => {
		if (!files) return;
		Array.from(files).forEach((file) =>
			imageItems.push({
				file,
				id: nextUid(),
				status: 'ready',
				thumbUrl: URL.createObjectURL(file),
			}),
		);
		renderList('gambar', imageItems, updateGambar);
		updateGambar();
	};

	const renderMetaCard = (
		name: string,
		file: File,
		options: { loading?: boolean; pages?: number; previewUrl?: string; error?: string },
	) => {
		const meta = $<HTMLElement>(`[data-meta="${name}"]`);
		if (!meta) return;
		meta.hidden = false;
		meta.innerHTML = '';

		const card = document.createElement('div');
		card.className = 'meta-card';

		const thumb = document.createElement('span');
		thumb.className = 'meta-card__thumb';
		if (options.previewUrl) {
			const img = document.createElement('img');
			img.src = options.previewUrl;
			img.alt = '';
			thumb.append(img);
		} else if (options.loading) {
			const spinner = document.createElement('span');
			spinner.className = 'spinner';
			spinner.setAttribute('aria-hidden', 'true');
			thumb.append(spinner);
		} else {
			thumb.textContent = 'PDF';
		}

		const info = document.createElement('span');
		info.className = 'meta-card__info';

		const line = document.createElement('span');
		line.className = 'file-card__name';
		line.textContent = file.name;

		const sub = document.createElement('span');
		sub.className = 'file-card__meta';
		if (options.loading) {
			sub.textContent = 'Membaca PDF…';
		} else if (options.error) {
			sub.textContent = options.error;
			sub.classList.add('is-failed');
		} else {
			sub.textContent = `✓ Siap · ${options.pages ?? 0} halaman · ${formatBytes(file.size)}`;
			sub.classList.add('is-ready');
		}

		info.append(line, sub);
		card.append(thumb, info);
		meta.append(card);
	};

	const showPdfLoading = (name: string, file: File) =>
		renderMetaCard(name, file, { loading: true });

	const showPdfMeta = (name: string, file: File, pages: number, previewUrl?: string) =>
		renderMetaCard(name, file, { pages, previewUrl });

	const renderPageList = () => {
		const list = $<HTMLOListElement>('[data-page-list]');
		if (!list) return;
		list.innerHTML = '';

		for (let index = 0; index < pageCount; index += 1) {
			const li = document.createElement('li');
			li.className = 'page-card';
			if (pageRemoved[index]) li.classList.add('page-card--removed');

			const name = document.createElement('span');
			name.className = 'page-card__name';
			name.textContent = `Halaman ${index + 1}`;

			const angle = document.createElement('span');
			angle.className = 'page-card__angle';
			angle.textContent = `${pageRotations[index] ?? 0}°`;

			const rotate = document.createElement('button');
			rotate.type = 'button';
			rotate.className = 'icon-button';
			rotate.setAttribute('aria-label', `Putar halaman ${index + 1} 90 derajat`);
			rotate.textContent = '↻';
			rotate.addEventListener('click', () => {
				pageRotations[index] = ((pageRotations[index] ?? 0) + 90) % 360;
				renderPageList();
				updatePageEdit();
			});

			const remove = document.createElement('button');
			remove.type = 'button';
			remove.className = 'icon-button';
			remove.setAttribute('aria-pressed', pageRemoved[index] ? 'true' : 'false');
			remove.textContent = pageRemoved[index] ? 'Batalkan' : 'Hapus';
			remove.setAttribute('aria-label', `Hapus halaman ${index + 1}`);
			remove.addEventListener('click', () => {
				pageRemoved[index] = !pageRemoved[index];
				renderPageList();
				updatePageEdit();
			});

			li.append(name, angle, rotate, remove);
			list.append(li);
		}
	};

	const renderImageResults = () => {
		const box = $<HTMLElement>('[data-image-result="ke-gambar"]');
		const list = $<HTMLOListElement>('[data-image-list]');
		if (!box || !list) return;
		list.innerHTML = '';
		box.hidden = renderedImages.length === 0;

		renderedImages.forEach((image) => {
			const li = document.createElement('li');
			li.className = 'file-card';

			const name = document.createElement('span');
			name.className = 'file-card__name';
			name.textContent = image.name;

			const size = document.createElement('span');
			size.className = 'file-card__size';
			size.textContent = formatBytes(image.bytes.byteLength);

			const save = document.createElement('button');
			save.type = 'button';
			save.className = 'btn btn--secondary';
			save.textContent = 'Unduh';
			save.setAttribute('aria-label', `Unduh ${image.name}`);
			save.addEventListener('click', () => download(image.name, image.bytes, image.mime));

			li.append(name, size, save);
			list.append(li);
		});
	};

	document.querySelector<HTMLInputElement>('#gabung-input')?.addEventListener('change', (event) => {
		addMergeFiles((event.target as HTMLInputElement).files);
		(event.target as HTMLInputElement).value = '';
	});

	document.querySelector<HTMLInputElement>('#gambar-input')?.addEventListener('change', (event) => {
		addImageFiles((event.target as HTMLInputElement).files);
		(event.target as HTMLInputElement).value = '';
	});

	document.querySelector<HTMLInputElement>('#pisah-input')?.addEventListener('change', async (event) => {
		const input = event.target as HTMLInputElement;
		const file = input.files?.[0] ?? null;
		input.value = '';
		if (!file) return;

		splitFile = null;
		splitPageCount = 0;
		updateSplit();
		showPdfLoading('pisah', file);

		try {
			const info = await readPdfInfo(file);
			revoke(splitPreviewUrl);
			splitPreviewUrl = info.previewUrl;
			splitFile = file;
			splitPageCount = info.pages;
			showPdfMeta('pisah', file, info.pages, info.previewUrl);
			updateSplit();
		} catch {
			revoke(splitPreviewUrl);
			splitPreviewUrl = undefined;
			splitFile = null;
			splitPageCount = 0;
			renderMetaCard('pisah', file, {
				error: 'PDF ini tidak bisa dibaca. Mungkin rusak atau terkunci sandi.',
			});
			updateSplit();
		}
	});

	document.querySelector<HTMLInputElement>('#pisah-range')?.addEventListener('input', updateSplit);

	document.querySelector<HTMLInputElement>('#kompres-input')?.addEventListener('change', async (event) => {
		const input = event.target as HTMLInputElement;
		const file = input.files?.[0] ?? null;
		input.value = '';
		if (!file) return;

		compressFile = null;
		compressResult = null;
		runButton('kompres')!.disabled = true;
		renderCompare();
		showPdfLoading('kompres', file);

		try {
			const info = await readPdfInfo(file);
			revoke(compressPreviewUrl);
			compressPreviewUrl = info.previewUrl;
			compressFile = file;
			showPdfMeta('kompres', file, info.pages, info.previewUrl);
			runButton('kompres')!.disabled = false;
		} catch {
			revoke(compressPreviewUrl);
			compressPreviewUrl = undefined;
			compressFile = null;
			runButton('kompres')!.disabled = true;
			renderMetaCard('kompres', file, {
				error: 'PDF ini tidak bisa dibaca. Mungkin rusak atau terkunci sandi.',
			});
		}
	});

	document.querySelector<HTMLInputElement>('#ke-gambar-input')?.addEventListener('change', async (event) => {
		const input = event.target as HTMLInputElement;
		const file = input.files?.[0] ?? null;
		input.value = '';
		if (!file) return;

		toImageFile = null;
		renderedImages = [];
		renderImageResults();
		updateToImage();
		showPdfLoading('ke-gambar', file);

		try {
			const info = await readPdfInfo(file);
			revoke(toImagePreviewUrl);
			toImagePreviewUrl = info.previewUrl;
			toImageFile = file;
			showPdfMeta('ke-gambar', file, info.pages, info.previewUrl);
			updateToImage();
		} catch {
			revoke(toImagePreviewUrl);
			toImagePreviewUrl = undefined;
			toImageFile = null;
			renderMetaCard('ke-gambar', file, {
				error: 'PDF ini tidak bisa dibaca. Mungkin rusak atau terkunci sandi.',
			});
			updateToImage();
		}
	});

	document.querySelector<HTMLInputElement>('#halaman-input')?.addEventListener('change', async (event) => {
		const input = event.target as HTMLInputElement;
		const file = input.files?.[0] ?? null;
		input.value = '';
		if (!file) return;

		pageFile = null;
		pageCount = 0;
		pageRotations = [];
		pageRemoved = [];
		renderPageList();
		updatePageEdit();
		showPdfLoading('halaman', file);

		try {
			const info = await readPdfInfo(file);
			revoke(pagePreviewUrl);
			pagePreviewUrl = info.previewUrl;
			pageFile = file;
			pageCount = info.pages;
			pageRotations = new Array(info.pages).fill(0);
			pageRemoved = new Array(info.pages).fill(false);
			showPdfMeta('halaman', file, info.pages, info.previewUrl);
			renderPageList();
			updatePageEdit();
		} catch {
			revoke(pagePreviewUrl);
			pagePreviewUrl = undefined;
			pageFile = null;
			pageCount = 0;
			pageRotations = [];
			pageRemoved = [];
			renderPageList();
			renderMetaCard('halaman', file, {
				error: 'PDF ini tidak bisa dibaca. Mungkin rusak atau terkunci sandi.',
			});
			updatePageEdit();
		}
	});

	document.querySelectorAll<HTMLButtonElement>('[data-image-format]').forEach((button) => {
		button.addEventListener('click', () => {
			imageFormat = button.dataset.imageFormat as 'png' | 'jpeg';
			document.querySelectorAll<HTMLButtonElement>('[data-image-format]').forEach((other) => {
				other.setAttribute('aria-checked', other === button ? 'true' : 'false');
			});
			renderedImages = [];
			renderImageResults();
		});
	});

	document.querySelectorAll<HTMLButtonElement>('[data-dpi]').forEach((button) => {
		button.addEventListener('click', () => {
			imageDpi = Number(button.dataset.dpi);
			document.querySelectorAll<HTMLButtonElement>('[data-dpi]').forEach((other) => {
				other.setAttribute('aria-checked', other === button ? 'true' : 'false');
			});
			renderedImages = [];
			renderImageResults();
		});
	});

	const renderCompare = () => {
		const box = $<HTMLElement>('[data-compare="kompres"]');
		if (!box || !compressResult || !compressFile) {
			if (box) box.hidden = true;
			return;
		}
		box.hidden = false;
		const { before, after } = compressResult;
		$<HTMLElement>('[data-before]')!.textContent = formatBytes(before);
		$<HTMLElement>('[data-after]')!.textContent = formatBytes(after);
		const saved = reductionPercent(before, after);
		$<HTMLElement>('[data-delta]')!.textContent =
			saved > 0
				? `Hemat ${saved}%`
				: saved === 0
					? 'Ukurannya sama'
					: `${Math.abs(saved)}% lebih besar dari aslinya`;
		const warn = $<HTMLElement>('[data-warn="kompres"]');
		if (warn) warn.hidden = after < before;
	};

	document.querySelectorAll<HTMLButtonElement>('[data-level]').forEach((button) => {
		button.addEventListener('click', () => {
			compressLevel = button.dataset.level as CompressLevel;
			document.querySelectorAll<HTMLButtonElement>('[data-level]').forEach((other) => {
				other.setAttribute('aria-checked', other === button ? 'true' : 'false');
			});
			compressResult = null;
			renderCompare();
		});
	});

	document.querySelectorAll<HTMLButtonElement>('[data-orientation]').forEach((button) => {
		button.addEventListener('click', () => {
			orientation = button.dataset.orientation as Orientation;
			document.querySelectorAll<HTMLButtonElement>('[data-orientation]').forEach((other) => {
				other.setAttribute('aria-checked', other === button ? 'true' : 'false');
			});
		});
	});

	document.querySelectorAll<HTMLButtonElement>('[data-margin]').forEach((button) => {
		button.addEventListener('click', () => {
			margin = button.dataset.margin as Margin;
			document.querySelectorAll<HTMLButtonElement>('[data-margin]').forEach((other) => {
				other.setAttribute('aria-checked', other === button ? 'true' : 'false');
			});
		});
	});

	const busy = new Set<string>();

	const run = async (name: string, request: Parameters<typeof runPdfTask>[0], filename: string) => {
		if (busy.has(name)) return;
		busy.add(name);
		const button = runButton(name);
		if (button) button.disabled = true;
		setError(name, null);
		setProgress(name, 0, 0, 'Menyiapkan…');

		const task = runPdfTask(request, (done, total) => setProgress(name, done, total, ''));
		try {
			const result = await task.promise;
			download(filename, result.bytes);
			toast('PDF siap diunduh.');
			return result;
		} catch (error) {
			setError(name, error instanceof Error ? error.message : 'Gagal memproses PDF.');
			return null;
		} finally {
			hideProgress(name);
			busy.delete(name);
			if (button) button.disabled = false;
		}
	};

	runButton('gabung')?.addEventListener('click', async () => {
		const files = await Promise.all(mergeItems.map((item) => readBytes(item.file)));
		await run('gabung', { op: 'merge', files }, 'gabungan.pdf');
	});

	runButton('pisah')?.addEventListener('click', async () => {
		if (!splitFile) return;
		const input = $<HTMLInputElement>('#pisah-range');
		const parsed = parsePageRange(input?.value ?? '', splitPageCount);
		if (!parsed.ok) return;
		const file = await readBytes(splitFile);
		await run('pisah', { op: 'split', file, pages: parsed.pages }, 'hasil-pisah.pdf');
	});

	runButton('gambar')?.addEventListener('click', async () => {
		const images = await Promise.all(
			imageItems.map(async (item) => ({
				bytes: await readBytes(item.file),
				type: item.file.type === 'image/png' ? ('png' as const) : ('jpg' as const),
			})),
		);
		await run('gambar', { op: 'images', images, orientation, margin }, 'gambar.pdf');
	});

	runButton('kompres')?.addEventListener('click', async () => {
		if (!compressFile) return;
		const file = compressFile;
		const bytes = await readBytes(file);
		const result = await run(
			'kompres',
			{ op: 'compress', file: bytes, level: compressLevel },
			`${file.name.replace(/\.pdf$/i, '')}-kompres.pdf`,
		);
		if (result) {
			compressResult = { before: file.size, after: result.bytes.byteLength };
			renderCompare();
		}
	});

	runButton('ke-gambar')?.addEventListener('click', async () => {
		if (!toImageFile || busy.has('ke-gambar')) return;
		busy.add('ke-gambar');
		const button = runButton('ke-gambar');
		if (button) button.disabled = true;
		setError('ke-gambar', null);
		setProgress('ke-gambar', 0, 0, 'Menyiapkan…');

		const file = toImageFile;
		const task = runPdfTask(
			{
				op: 'to-images',
				file: await readBytes(file),
				format: imageFormat,
				scale: imageDpi / 72,
			},
			(done, total) => setProgress('ke-gambar', done, total, ''),
		);
		try {
			const result = await task.promise;
			renderedImages = result.images ?? [];
			renderImageResults();
			toast(
				renderedImages.length > 1
					? `${renderedImages.length} gambar siap diunduh.`
					: 'Gambar siap diunduh.',
			);
		} catch (error) {
			setError(
				'ke-gambar',
				error instanceof Error ? error.message : 'Gagal membuat gambar.',
			);
		} finally {
			hideProgress('ke-gambar');
			busy.delete('ke-gambar');
			updateToImage();
		}
	});

	document
		.querySelector<HTMLButtonElement>('[data-download-all="ke-gambar"]')
		?.addEventListener('click', async () => {
			for (const image of renderedImages) {
				download(image.name, image.bytes, image.mime);
				await delay(300);
			}
		});

	runButton('halaman')?.addEventListener('click', async () => {
		if (!pageFile) return;
		const file = pageFile;
		const kept = pageCount - pageRemoved.filter(Boolean).length;
		if (kept === 0) return;
		const removed = pageRemoved.flatMap((value, index) => (value ? [index] : []));
		await run(
			'halaman',
			{
				op: 'edit',
				file: await readBytes(file),
				edits: { rotations: pageRotations, removed },
			},
			`${file.name.replace(/\.pdf$/i, '')}-diubah.pdf`,
		);
	});
</script>

<style>
	.pdf-panel {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
	}

	.file-list {
		display: grid;
		gap: var(--space-2);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.file-card {
		display: grid;
		grid-template-columns: 52px minmax(0, 1fr) 44px 44px 44px;
		align-items: center;
		gap: var(--space-2);
		padding: var(--space-2) var(--space-3);
		border: 1px solid var(--border);
		border-radius: var(--radius-md);
		background: var(--surface);
	}

	.file-card[data-state='failed'] {
		border-color: color-mix(in srgb, var(--danger) 45%, var(--border));
	}

	.file-card__thumb {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 52px;
		height: 66px;
		overflow: hidden;
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		background: var(--surface-2);
		color: var(--text-muted);
		font-family: var(--font-mono);
		font-size: 0.6875rem;
	}

	.file-card__thumb img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.file-card__info {
		display: flex;
		flex-direction: column;
		gap: 2px;
		min-width: 0;
	}

	.file-card__meta {
		font-size: 0.75rem;
		color: var(--text-muted);
	}

	.file-card__meta.is-ready {
		color: var(--success);
	}

	.file-card__meta.is-failed {
		color: var(--danger);
	}

	.file-card[draggable='true'] {
		cursor: grab;
	}

	.file-card--dragging {
		opacity: 0.55;
	}

	.file-card--dragover {
		border-color: var(--accent);
		background: var(--accent-soft);
	}

	.file-card__name {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		font-size: 0.9375rem;
	}

	.file-card__size {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--text-muted);
	}

	.file-card .icon-button {
		width: 44px;
		height: 44px;
	}

	.pdf-meta {
		padding: var(--space-3);
		border: 1px solid var(--border);
		border-radius: var(--radius-md);
		background: var(--surface);
	}

	.meta-card {
		display: grid;
		grid-template-columns: 52px minmax(0, 1fr);
		align-items: center;
		gap: var(--space-3);
	}

	.meta-card__thumb {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 52px;
		height: 66px;
		overflow: hidden;
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		background: var(--surface-2);
		color: var(--text-muted);
		font-family: var(--font-mono);
		font-size: 0.6875rem;
	}

	.meta-card__thumb img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.meta-card__info {
		display: flex;
		flex-direction: column;
		gap: 2px;
		min-width: 0;
	}

	.fieldset {
		margin: 0;
		padding: 0;
		border: 0;
		min-width: 0;
	}

	.fieldset .segmented {
		display: flex;
		width: 100%;
	}

	.fieldset .segmented__btn {
		flex: 1;
	}

	.compare {
		padding: var(--space-4);
		border: 1px solid var(--border-strong);
		border-radius: var(--radius-md);
		background: var(--surface-2);
	}

	.compare__line {
		font-family: var(--font-mono);
		font-size: 1.125rem;
		color: var(--text);
	}

	.compare__delta {
		margin-top: var(--space-1);
		font-size: 0.875rem;
		color: var(--text-muted);
	}

	.pdf-panel .alert {
		margin: 0;
	}

	[data-image-list] .file-card {
		grid-template-columns: minmax(0, 1fr) auto auto;
	}

	[data-image-list] .file-card .btn {
		min-height: 44px;
	}

	.page-list {
		display: grid;
		gap: var(--space-2);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.page-card {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto 44px auto;
		align-items: center;
