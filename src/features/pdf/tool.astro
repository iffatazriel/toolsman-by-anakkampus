		padding: var(--space-2) var(--space-3);
		border: 1px solid var(--border);
		border-radius: var(--radius-md);
		background: var(--surface);
	}

	.page-card--removed {
		opacity: 0.55;
	}

	.page-card--removed .page-card__name {
		text-decoration: line-through;
