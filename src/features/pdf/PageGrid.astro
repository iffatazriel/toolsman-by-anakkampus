---
import dict from './i18n';
interface Props { mode: 'pisah' | 'halaman' }
const {mode} = Astro.props;
---
<div class="page-preview" data-page-grid={mode} hidden>
	<p data-grid-summary role="status"></p>
	<p class="field-hint" data-i18n="workspace.pdf.thumbHelp">{dict.id.thumbHelp}</p>
	<div class="grid-navigation" data-grid-navigation>
		<button type="button" class="btn btn--secondary" data-grid-prev></button>
		<span data-grid-window aria-live="polite"></span>
		<button type="button" class="btn btn--secondary" data-grid-next></button>
	</div>
	<ol class="page-thumbnails" data-grid-list aria-label={dict.id.pdfPages} data-i18n-aria="workspace.pdf.pdfPages"></ol>
</div>
<style>
	.page-preview { display: grid; gap: var(--space-3); }
	p { margin: 0; }
	.grid-navigation { display: flex; align-items: center; flex-wrap: wrap; gap: var(--space-2); font-size: .875rem; }
	.page-thumbnails { display: grid; grid-template-columns: repeat(auto-fill, minmax(136px, 1fr)); gap: var(--space-2); padding: 0; margin: 0; list-style: none; }
	.page-preview :global(.page-tile) { min-width: 0; display: flex; flex-direction: column; gap: var(--space-2); padding: var(--space-2); border: 1px solid var(--border); border-radius: var(--radius-md); background: var(--surface); }
	.page-preview :global(.page-tile[data-selected='true']) { border-color: var(--accent); box-shadow: inset 0 0 0 1px var(--accent); background: var(--accent-soft); }
	.page-preview :global(.page-pick) { display: grid; gap: var(--space-2); width: 100%; padding: 0; border: 0; border-radius: var(--radius-sm); color: var(--text); background: transparent; cursor: pointer; }
	.page-preview :global(.page-thumb-frame) { display: flex; align-items: center; justify-content: center; position: relative; width: 100%; aspect-ratio: 1; overflow: hidden; border-radius: var(--radius-sm); background: var(--surface-2); }
	.page-preview :global(.page-thumb-frame img) { width: 100%; height: 100%; object-fit: contain; }
	.page-preview :global(.thumb-status) { font-size: .75rem; color: var(--text-muted); text-align: center; }
	.page-preview :global(.page-caption) { font-size: .875rem; text-align: center; }
	.page-preview :global(.page-deleted) { position: absolute; inset: 0; display: grid; place-items: center; color: var(--danger); background: color-mix(in srgb, var(--surface) 75%, transparent); font-weight: 600; }
	.page-preview :global([data-removed='true'] img) { opacity: .3; }
	.page-preview :global(.page-controls) { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-1); }
	.page-preview :global(.page-controls [data-page-action='remove']) { grid-column: 1 / -1; }
	.page-preview :global(button) { min-height: 44px; }
	.page-preview :global([hidden]), .page-preview[hidden] { display: none; }
</style>
