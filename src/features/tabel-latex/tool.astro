---
import dict from './i18n';
---

<div class="tool-shell latex-shell">
	<div class="option-row">
		<label class="field-label"><span data-i18n="workspace.tabel-latex.direction">{dict.id.direction}</span><select class="field-input" id="table-direction"><option value="forward">Markdown / CSV / TSV → LaTeX</option><option value="reverse" data-i18n="workspace.tabel-latex.reverse">{dict.id.reverse}</option></select></label>
		<label class="field-label"><span data-i18n="workspace.tabel-latex.format">{dict.id.format}</span><select class="field-input" id="table-format"><option value="auto" data-i18n="workspace.tabel-latex.auto">{dict.id.auto}</option><option value="markdown">Markdown</option><option value="csv" data-i18n="workspace.tabel-latex.csv">{dict.id.csv}</option><option value="tsv">TSV (tab)</option></select></label>
	</div>
	<div class="pane-grid pane-grid--split">
		<section class="pane">
			<label class="field-label" for="table-input" data-i18n="workspace.tabel-latex.input">{dict.id.input}</label>
			<textarea id="table-input" class="code-area" maxlength="200000" spellcheck="false">{'| Mata kuliah | SKS |\n| :--- | ---: |\n| Algoritma | 3 |\n| Basis Data | 4 |'}</textarea>
			<p class="field-hint" data-i18n="workspace.tabel-latex.hint">{dict.id.hint}</p>
			<fieldset id="table-options"><legend data-i18n="workspace.tabel-latex.options">{dict.id.options}</legend>
				<div class="checks"><label><input id="table-booktabs" type="checkbox" checked /><span data-i18n="workspace.tabel-latex.booktabs">{dict.id.booktabs}</span></label><label><input id="table-wrap" type="checkbox" /><span data-i18n="workspace.tabel-latex.wrap">{dict.id.wrap}</span></label><label><input id="table-bold" type="checkbox" checked /><span data-i18n="workspace.tabel-latex.bold">{dict.id.bold}</span></label></div>
				<label class="field-label">Caption<input class="field-input" id="table-caption" maxlength="2000" disabled /></label>
				<label class="field-label"><span data-i18n="workspace.tabel-latex.label">{dict.id.label}</span><input class="field-input" id="table-label" placeholder="tab:hasil" maxlength="200" disabled /></label>
				<label class="field-label"><span data-i18n="workspace.tabel-latex.columns">{dict.id.columns}</span><input class="field-input" id="table-columns" placeholder={dict.id.columnsPlaceholder} data-i18n-placeholder="workspace.tabel-latex.columnsPlaceholder" maxlength="2000" spellcheck="false" /></label>
				<p class="field-hint" data-i18n="workspace.tabel-latex.columnHint">{dict.id.columnHint}</p>
			</fieldset>
			<button type="button" class="btn btn--secondary" id="table-clear" data-i18n="workspace.tabel-latex.clear">{dict.id.clear}</button>
		</section>
		<section class="pane">
			<label class="field-label" for="table-output" data-i18n="workspace.tabel-latex.output">{dict.id.output}</label><textarea class="code-area" id="table-output" readonly spellcheck="false"></textarea>
			<div class="actions"><button type="button" class="btn btn--primary" id="table-copy" disabled data-i18n="workspace.tabel-latex.copy">{dict.id.copy}</button><button type="button" class="btn btn--secondary" id="table-download" disabled data-i18n="workspace.tabel-latex.downloadTex">{dict.id.downloadTex}</button></div>
			<p class="field-error" id="table-error" role="alert" hidden></p>
			<p class="field-hint" id="table-status" role="status"></p>
			<p class="field-hint" data-i18n="workspace.tabel-latex.previewHint">{dict.id.previewHint}</p>
		</section>
	</div>
	<section class="pane"><h2 class="pane__title" data-i18n="workspace.tabel-latex.preview">{dict.id.preview}</h2><div class="table-scroll" tabindex="0" role="region" aria-label={dict.id.previewAria} data-i18n-aria="workspace.tabel-latex.previewAria"><table id="table-preview"></table></div></section>
</div>

<script>
	import { copyText } from '../../lib/clipboard';
	import { tr, workspaceErrorMessage } from '../../lib/i18n';
	import { localizedText } from '../../lib/i18n-client';
	import dict from './i18n';
	import { downloadText } from '../../lib/download';
	import { latexToTable, parseTable, resolveColumns, toLatex, toMarkdown } from './table';
	const source = document.querySelector<HTMLTextAreaElement>('#table-input')!;
	const output = document.querySelector<HTMLTextAreaElement>('#table-output')!;
	const direction = document.querySelector<HTMLSelectElement>('#table-direction')!;
	const format = document.querySelector<HTMLSelectElement>('#table-format')!;
	const options = document.querySelector<HTMLFieldSetElement>('#table-options')!;
	const field = (name: string) => document.querySelector<HTMLInputElement>(`#table-${name}`)!;
	const copy = document.querySelector<HTMLButtonElement>('#table-copy')!;
	const download = document.querySelector<HTMLButtonElement>('#table-download')!;
	const errorNode = document.getElementById('table-error')!;
	const status = document.getElementById('table-status')!;
	const preview = document.querySelector<HTMLTableElement>('#table-preview')!;
	let timer: ReturnType<typeof setTimeout>;
	const render = () => {
		clearTimeout(timer); output.value = ''; copy.disabled = true; download.disabled = true; errorNode.hidden = true; preview.replaceChildren(); localizedText(status, () => '');
		const reverse = direction.value === 'reverse';
		options.disabled = reverse; format.disabled = reverse;
		field('caption').disabled = reverse || !field('wrap').checked; field('label').disabled = reverse || !field('wrap').checked;
		localizedText(download, () => tr(dict, reverse ? 'downloadMd' : 'downloadTex'));
		if (!source.value.trim()) return;
		try {
			const table = reverse ? latexToTable(source.value) : parseTable(source.value, format.value as 'auto' | 'markdown' | 'csv' | 'tsv');
			const columns = reverse ? table.alignments : resolveColumns(field('columns').value, table.alignments).alignments;
			output.value = reverse ? toMarkdown(table) : toLatex(table, { booktabs: field('booktabs').checked, wrap: field('wrap').checked, boldHeader: field('bold').checked, caption: field('caption').value, label: field('label').value, columns: field('columns').value });
			const head = document.createElement('thead'), body = document.createElement('tbody');
			[table.headers, ...table.rows].forEach((values, index) => {
				const row = document.createElement('tr');
				values.forEach((value, column) => { const cell = document.createElement(index ? 'td' : 'th'); if (!index) cell.setAttribute('scope', 'col'); cell.textContent = value; cell.style.textAlign = columns[column] === 'r' ? 'right' : columns[column] === 'c' ? 'center' : 'left'; row.append(cell); });
				(index ? body : head).append(row);
			});
			preview.append(head, body); copy.disabled = false; download.disabled = false;
			localizedText(status, () => tr(dict, 'updated', { rows: table.rows.length, columns: table.headers.length }));
		} catch (error) { localizedText(errorNode, () => workspaceErrorMessage(error, tr(dict, 'fallback'))); errorNode.hidden = false; }
	};
	const schedule = () => { clearTimeout(timer); output.value = ''; copy.disabled = true; download.disabled = true; timer = setTimeout(render, 150); };
	source.addEventListener('input', schedule);
	options.addEventListener('input', schedule);
	direction.addEventListener('change', render); format.addEventListener('change', render);
	document.getElementById('table-clear')!.addEventListener('click', () => { source.value = ''; render(); source.focus(); });
	copy.addEventListener('click', async () => { const copied = await copyText(output.value); localizedText(status, () => tr(dict, copied ? 'copied' : 'copyFailed')); });
	download.addEventListener('click', () => { const reverse = direction.value === 'reverse'; downloadText(reverse ? 'tabel.md' : 'tabel.tex', output.value, 'text/plain;charset=utf-8'); });
	render();
</script>

<style>
	.latex-shell { padding: var(--space-4); }
	.option-row, .checks, .actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-bottom: var(--space-3); }
	.option-row > label { flex: 1 1 220px; }
	.code-area { min-height: 260px; }
	fieldset { border: 1px solid var(--border); border-radius: var(--radius-md); padding: var(--space-3); margin-bottom: var(--space-3); min-width: 0; }
	legend { font-weight: 600; padding-inline: var(--space-2); }
	.table-scroll { overflow: auto; max-height: 480px; }
	table { width: 100%; border-collapse: collapse; }
	th, td { border: 1px solid var(--border); padding: var(--space-2) var(--space-3); white-space: pre-wrap; overflow-wrap: anywhere; min-width: 90px; }
	th { background: var(--surface-2); }
</style>
