---
import Dropzone from '../../components/ui/Dropzone.astro';
import Progress from '../../components/ui/Progress.astro';
---

<div class="tool-shell photo-shell">
	<ol class="steps" aria-label="Langkah pas foto">
		<li class="steps__item" data-step-item="1">1 Unggah</li>
		<li class="steps__item" data-step-item="2">2 Latar</li>
		<li class="steps__item" data-step-item="3">3 Ukuran &amp; posisi</li>
		<li class="steps__item" data-step-item="4">4 Unduh</li>
		<li class="steps__item" data-step-item="5">5 Lembar cetak</li>
	</ol>

	<div class="upload-preview" data-photo-preview hidden>
		<span class="upload-preview__thumb">
			<img data-photo-preview-img alt="" />
		</span>
		<span class="upload-preview__info">
			<span class="upload-preview__name" data-photo-preview-name></span>
			<span class="upload-preview__status" data-photo-preview-status role="status" aria-live="polite"></span>
		</span>
	</div>

	<div class="photo-step" data-step="1">
		<Dropzone id="foto-input" label="Pilih foto wajah" accept="image/jpeg,image/png,image/webp" hint="JPG, PNG, atau WEBP, maks. 10 MB. Foto tidak dikirim ke server." />
		<div class="camera-actions">
			<button type="button" class="btn btn--secondary" data-camera-open>Ambil dari kamera</button>
			<p class="field-hint" data-camera-status role="status" aria-live="polite">
				Kamera hanya dipakai di perangkat ini.
			</p>
		</div>
		<div class="camera-panel" data-camera-panel hidden>
			<video
				class="camera-video"
				data-camera-video
				width="360"
				height="480"
				autoplay
				playsinline
				muted
				aria-label="Pratinjau kamera"
			></video>
			<div class="pane-actions">
				<button type="button" class="btn btn--primary" data-camera-capture>Ambil foto</button>
				<button type="button" class="btn btn--secondary" data-camera-close>Batal</button>
			</div>
		</div>
		<p class="field-hint" data-photo-error hidden role="alert"></p>
	</div>

	<div class="photo-step" data-step="2" hidden>
		<div class="progress-box" data-model-box hidden>
			<Progress label="Menyiapkan penghapus latar (sekali saja)…" value={0} />
			<p class="field-hint">Model disimpan di browser setelah selesai, jadi kunjungan berikutnya lebih cepat.</p>
		</div>
		<div class="swatch-row" role="radiogroup" aria-label="Warna latar">
			<button type="button" class="swatch" role="radio" aria-checked="true" data-color="#DB1F26" style="--swatch:#DB1F26" aria-label="Merah"></button>
			<button type="button" class="swatch" role="radio" aria-checked="false" data-color="#0F5BD8" style="--swatch:#0F5BD8" aria-label="Biru"></button>
			<button type="button" class="swatch" role="radio" aria-checked="false" data-color="#FFFFFF" style="--swatch:#FFFFFF" aria-label="Putih"></button>
			<label class="swatch swatch--custom" aria-label="Warna kustom">
				<input type="color" id="foto-custom" value="#3B82F6" />
			</label>
		</div>
		<p class="field-hint">Nilai bawaan bisa berbeda dengan standar instansi. Cek persyaratanmu.</p>
	</div>

	<div class="photo-step photo-step--crop" data-step="3" hidden>
		<div class="segmented" role="radiogroup" aria-label="Ukuran cetak">
			<button type="button" class="segmented__btn" role="radio" aria-checked="false" data-size="2x3">2×3</button>
			<button type="button" class="segmented__btn" role="radio" aria-checked="true" data-size="3x4">3×4</button>
			<button type="button" class="segmented__btn" role="radio" aria-checked="false" data-size="4x6">4×6</button>
		</div>
		<div class="crop-stage" data-stage>
			<canvas id="foto-canvas" aria-label="Pratinjau pas foto"></canvas>
			<label class="check-row">
				<input type="checkbox" id="foto-guide" checked />
				Tampilkan guide wajah
			</label>
		</div>
		<div class="zoom-row">
			<label class="field-label" for="foto-zoom">Zoom</label>
			<input id="foto-zoom" type="range" min="1" max="2" step="0.05" value="1" />
		</div>
		<div class="zoom-row">
			<label class="field-label" for="foto-brightness">Kecerahan</label>
			<input id="foto-brightness" type="range" min="-40" max="40" step="5" value="0" />
			<p class="field-hint" id="foto-brightness-value">0%</p>
		</div>
		<div class="zoom-row">
			<label class="field-label" for="foto-feather">Haluskan tepi</label>
			<input id="foto-feather" type="range" min="0" max="12" step="1" value="0" />
			<p class="field-hint" id="foto-feather-value">0 px</p>
		</div>
		<p class="field-hint">Aturan pas foto tiap instansi bisa berbeda. Cek persyaratanmu.</p>
	</div>

	<div class="photo-step" data-step="4" hidden>
		<div class="pane-actions">
			<button type="button" class="btn btn--primary" id="foto-png">Unduh PNG 300 DPI</button>
			<button type="button" class="btn btn--secondary" id="foto-jpg">Unduh JPG</button>
		</div>
		<p class="field-hint" id="foto-dims"></p>
	</div>

	<div class="photo-step photo-step--sheet" data-step="5" hidden>
		<div class="segmented" role="radiogroup" aria-label="Ukuran kertas">
			<button type="button" class="segmented__btn" role="radio" aria-checked="true" data-paper="4r">
				4R
			</button>
			<button type="button" class="segmented__btn" role="radio" aria-checked="false" data-paper="a4">
				A4
			</button>
		</div>
		<p class="field-hint" id="foto-sheet-hint"></p>
		<div class="sheet-preview">
			<canvas id="foto-sheet" aria-label="Pratinjau lembar cetak"></canvas>
		</div>
		<div class="pane-actions">
			<button type="button" class="btn btn--secondary" id="sheet-png" disabled>
				Unduh lembar PNG
			</button>
			<button type="button" class="btn btn--primary" id="sheet-jpg" disabled>
				Unduh lembar JPG
			</button>
		</div>
		<p class="field-hint">
			Foto disusun dengan jarak potong di latar putih. Cetak tanpa penskalaan pada 300 DPI.
		</p>
	</div>

	<div class="step-nav">
		<button type="button" class="btn btn--secondary" id="foto-back" disabled>Kembali</button>
		<button type="button" class="btn btn--primary" id="foto-next" disabled>Lanjut</button>
	</div>
</div>

<script>
	import { formatBytes } from '../../lib/page-range';
	import { toast } from '../../lib/toast';
	import { enhancePixels } from './enhance';
	import { papers, planSheet, type PaperId } from './print-sheet';
	import { cropForFace, outputPixels, photoSizes, type PhotoSize } from './sizes';
	import { loadPhotoModule } from './segment-client';

	const step = { current: 1 };
	let cutout: HTMLCanvasElement | null = null;
	let bgColor = '#DB1F26';
	let sizeId: PhotoSize['id'] = '3x4';
	let zoom = 1;
	let brightness = 0;
	let feather = 0;
	let paperId: PaperId = '4r';
	let previewUrl: string | null = null;
	let face = { x: 0, y: 0, width: 0, height: 0 };

	const $ = <T extends HTMLElement>(selector: string) => document.querySelector<T>(selector);
	const stepEls = document.querySelectorAll<HTMLElement>('[data-step]');
	const back = $<HTMLButtonElement>('#foto-back')!;
	const next = $<HTMLButtonElement>('#foto-next')!;
	const canvas = $<HTMLCanvasElement>('#foto-canvas')!;
	const photoPreview = $<HTMLElement>('[data-photo-preview]');
	const photoPreviewImg = $<HTMLImageElement>('[data-photo-preview-img]');
	const photoPreviewName = $<HTMLElement>('[data-photo-preview-name]');
	const photoPreviewStatus = $<HTMLElement>('[data-photo-preview-status]');

	const currentSize = () => photoSizes.find((item) => item.id === sizeId)!;

	const setPhotoStatus = (message: string, state: 'loading' | 'ready' | 'failed') => {
		if (!photoPreviewStatus) return;
		photoPreviewStatus.textContent = '';
		photoPreviewStatus.classList.toggle('is-ready', state === 'ready');
		photoPreviewStatus.classList.toggle('is-failed', state === 'failed');
		if (state === 'loading') {
			const spinner = document.createElement('span');
			spinner.className = 'spinner';
			spinner.setAttribute('aria-hidden', 'true');
			photoPreviewStatus.append(spinner);
		}
		photoPreviewStatus.append(document.createTextNode(message));
	};

	const setStep = (value: number) => {
		step.current = value;
		stepEls.forEach((el) => {
			el.hidden = Number(el.dataset.step) !== value;
		});
		document.querySelectorAll<HTMLElement>('[data-step-item]').forEach((el) => {
			el.setAttribute('aria-current', Number(el.dataset.stepItem) === value ? 'step' : 'false');
		});
		back.disabled = value === 1;
		next.disabled = value === 1 || value === 5;
		next.textContent =
			value === 3 ? 'Lanjut ke unduh' : value === 4 ? 'Lanjut ke lembar cetak' : 'Lanjut';
		if (value === 3) draw();
		if (value === 5) drawSheet();
	};

	const defaultFace = (image: HTMLImageElement) => ({
		x: image.naturalWidth * 0.3,
		y: image.naturalHeight * 0.15,
		width: image.naturalWidth * 0.4,
		height: image.naturalHeight * 0.4,
	});

	const compose = (
		target: HTMLCanvasElement,
		width: number,
		height: number,
		featherScale: number,
	) => {
		if (!cutout) return null;
		const size = currentSize();
		const crop = cropForFace(face, size, cutout.width, cutout.height, zoom);

		const subject = document.createElement('canvas');
		subject.width = width;
		subject.height = height;
		const subjectCtx = subject.getContext('2d');
		if (!subjectCtx) return null;
		subjectCtx.drawImage(cutout, crop.x, crop.y, crop.width, crop.height, 0, 0, width, height);

		const imageData = subjectCtx.getImageData(0, 0, width, height);
		enhancePixels(imageData.data, width, height, {
			brightness,
			feather: feather * featherScale,
		});
		subjectCtx.putImageData(imageData, 0, 0);

		target.width = width;
		target.height = height;
		const targetCtx = target.getContext('2d');
		if (!targetCtx) return null;
		targetCtx.fillStyle = bgColor;
		targetCtx.fillRect(0, 0, width, height);
		targetCtx.drawImage(subject, 0, 0);
		return targetCtx;
	};

	const draw = () => {
		if (!cutout) return;
		const out = outputPixels(currentSize(), 300);
		const scale = Math.min(360 / out.width, 480 / out.height);
		const context = compose(canvas, Math.round(out.width * scale), Math.round(out.height * scale), scale);
		if (!context) return;

		const guide = $<HTMLInputElement>('#foto-guide');
		if (guide?.checked) {
			context.strokeStyle = 'rgba(255,255,255,0.85)';
			context.setLineDash([6, 4]);
			context.lineWidth = 2;
			context.beginPath();
			context.ellipse(canvas.width / 2, canvas.height * 0.4, canvas.width * 0.28, canvas.height * 0.22, 0, 0, Math.PI * 2);
			context.stroke();
			context.beginPath();
			context.moveTo(canvas.width * 0.1, canvas.height * 0.78);
			context.lineTo(canvas.width * 0.9, canvas.height * 0.78);
			context.stroke();
		}
	};

	const processPhoto = async (file: File) => {
		const url = URL.createObjectURL(file);
		const image = new Image();
		image.src = url;
		await image.decode();

		cutout = null;
		next.disabled = true;
		setStep(1);

		if (previewUrl) URL.revokeObjectURL(previewUrl);
		previewUrl = URL.createObjectURL(file);
		if (photoPreview && photoPreviewImg && photoPreviewName) {
			photoPreviewImg.src = previewUrl;
			photoPreviewName.textContent = `${file.name} · ${formatBytes(file.size)}`;
			photoPreview.hidden = false;
			setPhotoStatus('Membaca foto…', 'loading');
		}

		const modelBox = $<HTMLElement>('[data-model-box]')!;
		modelBox.hidden = false;
		const bar = modelBox.querySelector<HTMLElement>('.progress__bar')!;
		const label = modelBox.querySelector<HTMLElement>('.text-ink-muted');

		try {
			const removeBackground = await loadPhotoModule((_key, current, total) => {
				const percent = total > 0 ? Math.round((current / total) * 100) : 0;
				bar.style.width = `${percent}%`;
				if (label) label.textContent = `${percent}%`;
				if (percent > 0) setPhotoStatus(`Menghapus latar… ${percent}%`, 'loading');
			});
			setPhotoStatus('Menghapus latar…', 'loading');
			const blob = await removeBackground(file);
			const bitmap = await createImageBitmap(blob);
			cutout = document.createElement('canvas');
			cutout.width = bitmap.width;
			cutout.height = bitmap.height;
			cutout.getContext('2d')!.drawImage(bitmap, 0, 0);
			face = defaultFace(image);
			modelBox.hidden = true;
			next.disabled = false;
			setPhotoStatus('✓ Latar dihapus. Foto siap diatur.', 'ready');
			setStep(2);
		} catch (error) {
			modelBox.hidden = true;
			const message = error instanceof Error ? error.message : 'Gagal memproses foto.';
			setPhotoStatus(`Gagal: ${message}`, 'failed');
			const errorBox = $<HTMLElement>('[data-photo-error]')!;
			errorBox.textContent = message;
			errorBox.hidden = false;
		} finally {
			URL.revokeObjectURL(url);
		}
	};

	const input = $<HTMLInputElement>('#foto-input');
	input?.addEventListener('change', (event) => {
		const file = (event.target as HTMLInputElement).files?.[0];
		if (!file) return;
		if (file.size > 10 * 1024 * 1024) {
			const errorBox = $<HTMLElement>('[data-photo-error]')!;
			errorBox.textContent = 'Foto lebih dari 10 MB. Kecilkan dulu, lalu coba lagi.';
			errorBox.hidden = false;
			return;
		}
		void processPhoto(file);
	});

	const cameraButton = $<HTMLButtonElement>('[data-camera-open]');
	const cameraPanel = $<HTMLElement>('[data-camera-panel]');
	const cameraVideo = $<HTMLVideoElement>('[data-camera-video]');
	const cameraCapture = $<HTMLButtonElement>('[data-camera-capture]');
	const cameraClose = $<HTMLButtonElement>('[data-camera-close]');
	const cameraStatus = $<HTMLElement>('[data-camera-status]');
	let cameraStream: MediaStream | null = null;

	const stopCamera = () => {
		cameraStream?.getTracks().forEach((track) => track.stop());
		cameraStream = null;
		if (cameraVideo) cameraVideo.srcObject = null;
		if (cameraPanel) cameraPanel.hidden = true;
		if (cameraButton) cameraButton.disabled = false;
	};

	if (cameraButton && !navigator.mediaDevices?.getUserMedia) {
		cameraButton.hidden = true;
		if (cameraStatus) {
			cameraStatus.textContent = 'Kamera tidak didukung di peramban ini. Pakai unggah foto.';
		}
	}

	cameraButton?.addEventListener('click', async () => {
		if (!cameraPanel || !cameraVideo || !cameraStatus) return;
		const media = navigator.mediaDevices;
		if (!media?.getUserMedia) return;

		cameraButton.disabled = true;
		cameraStatus.textContent = 'Meminta izin kamera…';

		try {
			cameraStream = await media.getUserMedia({
				video: { facingMode: 'user', width: { ideal: 1280 }, height: { ideal: 1600 } },
				audio: false,
			});
			cameraVideo.srcObject = cameraStream;
			await cameraVideo.play();
			cameraPanel.hidden = false;
			cameraStatus.textContent = 'Posisikan wajah di dalam bingkai, lalu tekan Ambil foto.';
		} catch {
			cameraButton.disabled = false;
			cameraStatus.textContent =
				'Izin kamera ditolak atau kamera tidak tersedia. Pakai unggah foto di atas.';
		}
	});

	cameraCapture?.addEventListener('click', async () => {
		if (!cameraVideo || !cameraStream || !cameraStatus) return;
		if (cameraVideo.videoWidth === 0) {
			cameraStatus.textContent = 'Kamera belum siap. Tunggu sebentar, lalu coba lagi.';
			return;
		}

		const frame = document.createElement('canvas');
		frame.width = cameraVideo.videoWidth;
		frame.height = cameraVideo.videoHeight;
		const frameCtx = frame.getContext('2d');
		if (!frameCtx) return;
		frameCtx.drawImage(cameraVideo, 0, 0, frame.width, frame.height);

		const blob = await new Promise<Blob | null>((resolve) => {
			frame.toBlob(resolve, 'image/jpeg', 0.95);
		});
		if (!blob) {
			cameraStatus.textContent = 'Gagal mengambil foto. Coba lagi.';
			return;
		}

		const file = new File([blob], 'kamera.jpg', { type: 'image/jpeg' });
		stopCamera();
		cameraStatus.textContent = 'Foto diambil. Memproses…';
		await processPhoto(file);
	});

	cameraClose?.addEventListener('click', () => {
		stopCamera();
		if (cameraStatus) cameraStatus.textContent = 'Kamera ditutup. Pakai unggah foto kalau perlu.';
	});

	window.addEventListener('pagehide', stopCamera);

	document.querySelectorAll<HTMLButtonElement>('[data-color]').forEach((button) => {
		button.addEventListener('click', () => {
			bgColor = button.dataset.color ?? bgColor;
			document.querySelectorAll<HTMLButtonElement>('[data-color]').forEach((other) => {
				other.setAttribute('aria-checked', other === button ? 'true' : 'false');
			});
			draw();
		});
	});

	$<HTMLInputElement>('#foto-custom')?.addEventListener('input', (event) => {
		bgColor = (event.target as HTMLInputElement).value;
		draw();
	});

	document.querySelectorAll<HTMLButtonElement>('[data-size]').forEach((button) => {
		button.addEventListener('click', () => {
			sizeId = button.dataset.size as PhotoSize['id'];
			document.querySelectorAll<HTMLButtonElement>('[data-size]').forEach((other) => {
				other.setAttribute('aria-checked', other === button ? 'true' : 'false');
			});
			draw();
		});
	});

	$<HTMLInputElement>('#foto-zoom')?.addEventListener('input', (event) => {
		zoom = Number((event.target as HTMLInputElement).value);
		draw();
	});

	$<HTMLInputElement>('#foto-brightness')?.addEventListener('input', (event) => {
		brightness = Number((event.target as HTMLInputElement).value);
		const label = $<HTMLElement>('#foto-brightness-value');
		if (label) label.textContent = `${brightness}%`;
		draw();
	});

	$<HTMLInputElement>('#foto-feather')?.addEventListener('input', (event) => {
		feather = Number((event.target as HTMLInputElement).value);
		const label = $<HTMLElement>('#foto-feather-value');
		if (label) label.textContent = `${feather} px`;
		draw();
	});

	$<HTMLInputElement>('#foto-guide')?.addEventListener('change', draw);

	const saveBlob = (blob: Blob, filename: string) => {
		const url = URL.createObjectURL(blob);
		const link = document.createElement('a');
		link.href = url;
		link.download = filename;
		document.body.append(link);
		link.click();
		link.remove();
		setTimeout(() => URL.revokeObjectURL(url), 1000);
	};

	const download = (type: 'png' | 'jpg') => {
		if (!cutout) return;
		const size = currentSize();
		const out = outputPixels(size, 300);
		const exportCanvas = document.createElement('canvas');
		const exportCtx = compose(exportCanvas, out.width, out.height, 1);
		if (!exportCtx) return;

		const mime = type === 'png' ? 'image/png' : 'image/jpeg';
		exportCanvas.toBlob((blob) => {
			if (!blob) return;
			saveBlob(blob, `pas-foto-${sizeId}.${type}`);
			toast('Pas foto diunduh.');
		}, mime, 0.95);
	};

	$<HTMLButtonElement>('#foto-png')?.addEventListener('click', () => download('png'));
	$<HTMLButtonElement>('#foto-jpg')?.addEventListener('click', () => download('jpg'));

	const sheetCanvas = $<HTMLCanvasElement>('#foto-sheet')!;
	const sheetHint = $<HTMLElement>('#foto-sheet-hint')!;
	const sheetPng = $<HTMLButtonElement>('#sheet-png')!;
	const sheetJpg = $<HTMLButtonElement>('#sheet-jpg')!;

	const photoTile = () => {
		if (!cutout) return null;
		const out = outputPixels(currentSize(), 300);
		const tile = document.createElement('canvas');
		return compose(tile, out.width, out.height, 1) ? tile : null;
	};

	const drawSheet = () => {
		const paper = papers.find((item) => item.id === paperId)!;
		const tile = photoTile();
		if (!tile) return;

		const plan = planSheet(paper, tile.width, tile.height);
		sheetHint.textContent =
			plan.count > 0
				? `${plan.count} foto ${currentSize().label} per lembar ${paper.label} (${paper.description}).`
				: `Foto ${currentSize().label} tidak muat di kertas ${paper.label}.`;
		sheetPng.disabled = plan.count === 0;
		sheetJpg.disabled = plan.count === 0;

		const scale = Math.min(360 / paper.widthPx, 480 / paper.heightPx);
		sheetCanvas.width = Math.round(paper.widthPx * scale);
		sheetCanvas.height = Math.round(paper.heightPx * scale);
		const context = sheetCanvas.getContext('2d');
		if (!context) return;
		context.fillStyle = '#ffffff';
		context.fillRect(0, 0, sheetCanvas.width, sheetCanvas.height);

		for (const placement of plan.placements) {
			context.drawImage(
				tile,
				placement.x * scale,
				placement.y * scale,
				placement.width * scale,
				placement.height * scale,
			);
		}
	};

	const downloadSheet = (type: 'png' | 'jpg') => {
		const paper = papers.find((item) => item.id === paperId)!;
		const tile = photoTile();
		if (!tile) return;

		const plan = planSheet(paper, tile.width, tile.height);
		if (plan.count === 0) return;

		const sheet = document.createElement('canvas');
		sheet.width = paper.widthPx;
		sheet.height = paper.heightPx;
		const context = sheet.getContext('2d');
		if (!context) return;
		context.fillStyle = '#ffffff';
		context.fillRect(0, 0, sheet.width, sheet.height);
		for (const placement of plan.placements) {
			context.drawImage(tile, placement.x, placement.y, placement.width, placement.height);
		}

		const mime = type === 'png' ? 'image/png' : 'image/jpeg';
		sheet.toBlob(
			(blob) => {
				if (!blob) return;
				saveBlob(blob, `pas-foto-lembar-${paper.id}.${type}`);
				toast('Lembar cetak diunduh.');
			},
			mime,
			0.95,
		);
	};

	document.querySelectorAll<HTMLButtonElement>('[data-paper]').forEach((button) => {
		button.addEventListener('click', () => {
			paperId = button.dataset.paper as PaperId;
			document.querySelectorAll<HTMLButtonElement>('[data-paper]').forEach((other) => {
				other.setAttribute('aria-checked', other === button ? 'true' : 'false');
			});
			drawSheet();
		});
	});

	sheetPng.addEventListener('click', () => downloadSheet('png'));
	sheetJpg.addEventListener('click', () => downloadSheet('jpg'));

	back.addEventListener('click', () => setStep(Math.max(1, step.current - 1)));
	next.addEventListener('click', () => setStep(Math.min(5, step.current + 1)));

	const dims = $<HTMLElement>('#foto-dims');
	const updateDims = () => {
		const size = photoSizes.find((item) => item.id === sizeId)!;
		const out = outputPixels(size, 300);
		if (dims) dims.textContent = `${size.label} · ${out.width} × ${out.height} px · 300 DPI`;
	};
	document.querySelectorAll<HTMLButtonElement>('[data-size]').forEach((button) => {
		button.addEventListener('click', updateDims);
	});
	updateDims();
</script>

