---
import dict from './i18n';
const licenses = [
	{ value: '', label: dict.id.noLicense },
	{ value: 'MIT', label: 'MIT' },
	{ value: 'Apache-2.0', label: 'Apache-2.0' },
	{ value: 'GPL-3.0', label: 'GPL-3.0' },
];
---

<div class="pane-grid pane-grid--split">
	<div class="pane">
		<div class="pane__head">
			<h2 class="pane__title" data-i18n="workspace.generator.fields">{dict.id.fields}</h2>
		</div>

		<form class="form-grid" id="readme-form" autocomplete="off">
			<div>
				<label class="field-label" for="readme-name" data-i18n="workspace.generator.projectName">{dict.id.projectName}</label>
				<input
					class="field-input"
					id="readme-name"
					name="name"
					type="text"
					placeholder="alat-pdf"
				/>
				<p class="field-hint" data-i18n="workspace.generator.readmeNameHint">{dict.id.readmeNameHint}</p>
			</div>

			<div>
				<label class="field-label" for="readme-description" data-i18n="workspace.generator.description">{dict.id.description}</label>
				<textarea
					class="field-input field-textarea"
					id="readme-description"
					name="description"
					rows="2"
					placeholder={dict.id.descriptionPlaceholder} data-i18n-placeholder="workspace.generator.descriptionPlaceholder"
				></textarea>
			</div>

			<div>
				<label class="field-label" for="readme-features" data-i18n="workspace.generator.features">{dict.id.features}</label>
				<textarea
					class="field-input field-textarea"
					id="readme-features"
					name="features"
					rows="4"
					placeholder={dict.id.featuresPlaceholder} data-i18n-placeholder="workspace.generator.featuresPlaceholder"
				></textarea>
				<p class="field-hint" data-i18n="workspace.generator.featureHint">{dict.id.featureHint}</p>
			</div>

			<div>
				<label class="field-label" for="readme-install" data-i18n="workspace.generator.installation">{dict.id.installation}</label>
				<textarea
					class="field-input field-textarea"
					id="readme-install"
					name="install"
					rows="3"
					placeholder="npm install&#10;npm run dev"
				></textarea>
				<p class="field-hint" data-i18n="workspace.generator.installationHint">{dict.id.installationHint}</p>
			</div>

			<div>
				<label class="field-label" for="readme-usage" data-i18n="workspace.generator.usage">{dict.id.usage}</label>
				<textarea
					class="field-input field-textarea"
					id="readme-usage"
					name="usage"
					rows="3"
					placeholder={dict.id.usagePlaceholder} data-i18n-placeholder="workspace.generator.usagePlaceholder"
				></textarea>
			</div>

			<div>
				<label class="field-label" for="readme-license" data-i18n="workspace.generator.license">{dict.id.license}</label>
				<select class="field-input" id="readme-license" name="license">
					{licenses.map((item) => <option value={item.value} data-i18n={item.value === '' ? 'workspace.generator.noLicense' : undefined}>{item.label}</option>)}
				</select>
			</div>

			<div class="check-row">
				<input type="checkbox" id="readme-badge" name="badge" />
				<label for="readme-badge" data-i18n="workspace.generator.badge">{dict.id.badge}</label>
			</div>
			<p class="field-hint check-hint" data-i18n="workspace.generator.badgeHint">{dict.id.badgeHint}</p>

			<p class="field-hint" data-i18n="workspace.generator.readmeHint">{dict.id.readmeHint}</p>
		</form>
	</div>

	<div class="pane">
		<div class="pane__head">
			<h2 class="pane__title" data-i18n="workspace.generator.readmePreview">{dict.id.readmePreview}</h2>
			<div class="pane-actions">
				<button type="button" class="btn btn--secondary" id="readme-copy" disabled data-i18n="workspace.generator.copyMd">{dict.id.copyMd}</button>
				<button type="button" class="btn btn--primary" id="readme-download" data-task-action disabled data-i18n="workspace.generator.downloadMd">{dict.id.downloadMd}</button>
			</div>
		</div>
		<div class="preview prose" id="readme-preview" hidden></div>
		<p class="preview-empty" id="readme-preview-empty" data-i18n="workspace.generator.readmeEmpty">{dict.id.readmeEmpty}</p>
	</div>
</div>

<script>
	import { tr, currentLang } from '../../lib/i18n';
	import dict from './i18n';
	import { copyText } from '../../lib/clipboard';
	import { downloadText } from '../../lib/download';
	import { markdownFilename } from '../../lib/files';
	import { toast } from '../../lib/toast';
	import { generateReadme, type ReadmeLicense } from '../../lib/readme';
	import { renderMarkdown } from './render-markdown';

	const form = document.getElementById('readme-form') as HTMLFormElement | null;
	const name = document.getElementById('readme-name') as HTMLInputElement | null;
	const description = document.getElementById('readme-description') as HTMLTextAreaElement | null;
	const features = document.getElementById('readme-features') as HTMLTextAreaElement | null;
	const install = document.getElementById('readme-install') as HTMLTextAreaElement | null;
	const usage = document.getElementById('readme-usage') as HTMLTextAreaElement | null;
	const license = document.getElementById('readme-license') as HTMLSelectElement | null;
	const badge = document.getElementById('readme-badge') as HTMLInputElement | null;
	const preview = document.getElementById('readme-preview');
	const empty = document.getElementById('readme-preview-empty');
	const copy = document.getElementById('readme-copy') as HTMLButtonElement | null;
	const download = document.getElementById('readme-download') as HTMLButtonElement | null;

	if (
		form &&
		name &&
		description &&
		features &&
		install &&
		usage &&
		license &&
		badge &&
		preview &&
		empty &&
		copy &&
		download
	) {
		let markdown = '';

		const update = () => {
			markdown = generateReadme({
				name: name.value,
				description: description.value,
				features: features.value,
				install: install.value,
				usage: usage.value,
				license: license.value as ReadmeLicense | '',
				showLicenseBadge: badge.checked,
			}, currentLang());

			const blank = markdown === '';
			preview.innerHTML = blank ? '' : renderMarkdown(markdown);
			preview.hidden = blank;
			empty.hidden = !blank;
			copy.disabled = blank;
			download.disabled = blank;
		};

		document.addEventListener('lang:change', update);
		form.addEventListener('input', update);
		form.addEventListener('change', update);
		form.addEventListener('submit', (event) => event.preventDefault());

		copy.addEventListener('click', async () => {
			const copied = await copyText(markdown);
			toast(() => tr(dict, copied ? 'readmeCopied' : 'copyFailed'), { tone: copied ? 'success' : 'error' });
		});

		download.addEventListener('click', () => {
			downloadText(markdownFilename(markdown), markdown);
			toast(() => tr(dict, 'readmeDownloaded'), { tone: 'success' });
		});

		update();
	}
</script>
