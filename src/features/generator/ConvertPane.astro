---
import dict from './i18n';
const modes = [
	{ id: 'json-csv', label: 'JSON → CSV' },
	{ id: 'csv-json', label: 'CSV → JSON' },
	{ id: 'json-yaml', label: 'JSON → YAML' },
	{ id: 'yaml-json', label: 'YAML → JSON' },
];

---

<div class="pane-grid pane-grid--split">
	<div class="pane">
		<div class="pane__head">
			<h2 class="pane__title" data-i18n="workspace.generator.input">{dict.id.input}</h2>
			<div class="segmented" role="radiogroup" aria-label={dict.id.direction} data-i18n-aria="workspace.generator.direction">
				{
					modes.map((mode, index) => (
						<button
							type="button"
							class="segmented__btn"
							role="radio"
							aria-checked={index === 0 ? 'true' : 'false'}
							data-convert-mode={mode.id}
						>
							{mode.label}
						</button>
					))
				}
			</div>
		</div>
		<label class="sr-only" for="convert-input" data-i18n="workspace.generator.source">{dict.id.source}</label>
		<textarea
			id="convert-input"
			class="code-area"
			spellcheck="false"
			placeholder='[{"nama":"Budi","umur":21}]'></textarea>
		<p class="field-hint" data-i18n="workspace.generator.csvHint">{dict.id.csvHint}</p>
		<div class="alert" id="convert-error" role="alert" hidden>
			<p id="convert-error-text"></p>
		</div>
	</div>

	<div class="pane">
		<div class="pane__head">
			<h2 class="pane__title" data-i18n="workspace.generator.output">{dict.id.output}</h2>
			<div class="pane-actions">
				<button type="button" class="btn btn--secondary" id="convert-copy" disabled data-i18n="workspace.generator.copy">{dict.id.copy}</button>
				<button type="button" class="btn btn--primary" id="convert-download" disabled data-i18n="workspace.generator.download">{dict.id.download}</button>
			</div>
		</div>
		<pre class="code-block" id="convert-output" hidden><code id="convert-code"></code></pre>
		<p class="preview-empty" id="convert-empty" data-i18n="workspace.generator.convertEmpty">{dict.id.convertEmpty}</p>
	</div>
</div>

<script>
	import { tr, currentLang } from '../../lib/i18n';
	import dict from './i18n';
	import { localizedText } from '../../lib/i18n-client';
	import { copyText } from '../../lib/clipboard';
	import { downloadText } from '../../lib/download';
	import { csvToJson, jsonToCsv, jsonToYaml, yamlToJson } from '../../lib/convert';
	import { toast } from '../../lib/toast';

	const input = document.getElementById('convert-input') as HTMLTextAreaElement | null;
	const output = document.getElementById('convert-output');
	const code = document.getElementById('convert-code');
	const empty = document.getElementById('convert-empty');
	const errorBox = document.getElementById('convert-error');
	const errorText = document.getElementById('convert-error-text');
	const copy = document.getElementById('convert-copy') as HTMLButtonElement | null;
	const download = document.getElementById('convert-download') as HTMLButtonElement | null;
	const modeButtons = Array.from(
		document.querySelectorAll<HTMLButtonElement>('[data-convert-mode]'),
	);

	const extensions: Record<string, string> = {
		'json-csv': 'csv',
		'csv-json': 'json',
		'json-yaml': 'yaml',
		'yaml-json': 'json',
	};

	const converters = {
		'json-csv': jsonToCsv,
		'csv-json': csvToJson,
		'json-yaml': jsonToYaml,
		'yaml-json': yamlToJson,
	};

	if (input && output && code && empty && errorBox && errorText && copy && download) {
		let mode = 'json-csv';
		let result = '';

		const showError = (message: (() => string) | null) => {
			errorBox.hidden = message === null;
			localizedText(errorText, message ?? (() => ''));
			if (message) input.setAttribute('aria-invalid', 'true');
			else input.removeAttribute('aria-invalid');
		};

		const run = () => {
			showError(null);
			const converter = converters[mode as keyof typeof converters];
			const source = input.value;
			const outcome = converter(source, currentLang());

			if (outcome.ok) {
				result = outcome.text;
				const blank = result === '';
				code.textContent = result;
				output.hidden = blank;
				empty.hidden = !blank;
				copy.disabled = blank;
				download.disabled = blank;
			} else {
				result = '';
				code.textContent = '';
				output.hidden = true;
				empty.hidden = false;
				copy.disabled = true;
				download.disabled = true;
				showError(() => { const translated = converter(source, currentLang()); return translated.ok ? '' : translated.error; });
			}
		};

		modeButtons.forEach((button) => {
			button.addEventListener('click', () => {
				mode = button.dataset.convertMode ?? 'json-csv';
				modeButtons.forEach((other) =>
					other.setAttribute('aria-checked', other === button ? 'true' : 'false'),
				);
				run();
			});
		});

		input.addEventListener('input', run);

		copy.addEventListener('click', async () => {
			const copied = await copyText(result);
			toast(() => tr(dict, copied ? 'resultCopied' : 'copyFailed'), { tone: copied ? 'success' : 'error' });
		});

		download.addEventListener('click', () => {
			const extension = extensions[mode] ?? 'txt';
			downloadText(`hasil.${extension}`, result, 'text/plain;charset=utf-8');
			toast(() => tr(dict, 'downloaded'), { tone: 'success' });
		});

		run();
	}
</script>
