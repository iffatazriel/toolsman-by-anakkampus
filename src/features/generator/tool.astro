---
import Tabs from '../../components/ui/Tabs.astro';
import ConvertPane from './ConvertPane.astro';
import GitignorePane from './GitignorePane.astro';
import JsonPane from './JsonPane.astro';
import LicensePane from './LicensePane.astro';
import MarkdownPane from './MarkdownPane.astro';
import ReadmePane from './ReadmePane.astro';

const tabs = [
	{ id: 'markdown', label: 'Markdown' },
	{ id: 'readme', label: 'README' },
	{ id: 'json', label: 'JSON' },
	{ id: 'convert', label: 'Konversi' },
	{ id: 'gitignore', label: '.gitignore' },
	{ id: 'license', label: 'Lisensi' },
];
---

<div class="tool-shell">
	<Tabs label="Pilihan Generator" items={tabs}>
		<div data-panel="markdown" class="tool-panel">
			<MarkdownPane />
		</div>
		<div data-panel="readme" class="tool-panel" hidden>
			<ReadmePane />
		</div>
		<div data-panel="json" class="tool-panel" hidden>
			<JsonPane />
		</div>
		<div data-panel="convert" class="tool-panel" hidden>
			<ConvertPane />
		</div>
		<div data-panel="gitignore" class="tool-panel" hidden>
			<GitignorePane />
		</div>
		<div data-panel="license" class="tool-panel" hidden>
			<LicensePane />
		</div>
	</Tabs>
</div>
