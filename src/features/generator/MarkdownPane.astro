---
import dict from './i18n';
import Icon from '../../components/ui/Icon.astro';
import type { IconName } from '../../lib/icons';
import type { ToolbarAction } from '../../lib/markdown-toolbar';

const toolbarItems: { action: ToolbarAction; label: string; labelKey: string; icon: IconName }[] = [
	{ action: 'bold', label: dict.id.bold, labelKey: 'workspace.generator.bold', icon: 'bold' },
	{ action: 'italic', label: dict.id.italic, labelKey: 'workspace.generator.italic', icon: 'italic' },
	{ action: 'heading', label: dict.id.heading, labelKey: 'workspace.generator.heading', icon: 'heading' },
	{ action: 'list', label: dict.id.list, labelKey: 'workspace.generator.list', icon: 'list' },
	{ action: 'code', label: dict.id.code, labelKey: 'workspace.generator.code', icon: 'code' },
	{ action: 'link', label: dict.id.link, labelKey: 'workspace.generator.link', icon: 'link' },
	{ action: 'table', label: dict.id.table, labelKey: 'workspace.generator.table', icon: 'table' },
];
---

<div class="pane-grid pane-grid--split">
	<div class="pane">
		<div class="pane__head">
			<h2 class="pane__title" id="md-editor-title">Editor</h2>
			<div class="pane-actions">
				<button type="button" class="btn btn--secondary" id="md-copy" disabled data-i18n="workspace.generator.copy">{dict.id.copy}</button>
				<button type="button" class="btn btn--primary" id="md-download" disabled data-i18n="workspace.generator.downloadMd">{dict.id.downloadMd}</button>
			</div>
		</div>

		<div class="toolbar" role="toolbar" aria-label={dict.id.formatMarkdown} data-i18n-aria="workspace.generator.formatMarkdown" id="md-toolbar">
			{
				toolbarItems.map((item) => (
					<button
						type="button"
						class="toolbar__btn"
						data-action={item.action}
						aria-label={item.label} data-i18n-aria={item.labelKey}
					>
						<Icon name={item.icon} size={20} />
					</button>
				))
			}
		</div>

		<label class="sr-only" for="md-input" data-i18n="workspace.generator.markdownText">{dict.id.markdownText}</label>
		<textarea
			id="md-input"
			class="code-area"
			spellcheck="false"
			aria-labelledby="md-editor-title"
			placeholder={dict.id.markdownPlaceholder} data-i18n-placeholder="workspace.generator.markdownPlaceholder"
		></textarea>
	</div>

	<div class="pane">
		<div class="pane__head">
			<h2 class="pane__title" data-i18n="workspace.generator.preview">{dict.id.preview}</h2>
		</div>
		<div class="preview prose" id="md-preview" hidden></div>
		<p class="preview-empty" id="md-preview-empty" data-i18n="workspace.generator.markdownEmpty">{dict.id.markdownEmpty}</p>
	</div>
</div>

<script>
	import { tr } from '../../lib/i18n';
	import dict from './i18n';
	import { copyText } from '../../lib/clipboard';
	import { downloadText } from '../../lib/download';
	import { markdownFilename } from '../../lib/files';
	import { applyToolbar, type ToolbarAction } from '../../lib/markdown-toolbar';
	import { toast } from '../../lib/toast';
	import { renderMarkdown } from './render-markdown';

	const input = document.getElementById('md-input') as HTMLTextAreaElement | null;
	const preview = document.getElementById('md-preview');
	const empty = document.getElementById('md-preview-empty');
	const toolbar = document.getElementById('md-toolbar');
	const copy = document.getElementById('md-copy') as HTMLButtonElement | null;
	const download = document.getElementById('md-download') as HTMLButtonElement | null;

	if (input && preview && empty && toolbar && copy && download) {
		let queued = false;

		const render = () => {
			queued = false;
			const value = input.value;
			const blank = value.trim() === '';
			preview.innerHTML = blank ? '' : renderMarkdown(value);
			preview.hidden = blank;
			empty.hidden = !blank;
			copy.disabled = blank;
			download.disabled = blank;
		};

		const schedule = () => {
			if (queued) return;
			queued = true;
			requestAnimationFrame(render);
		};

		input.addEventListener('input', schedule);

		toolbar.addEventListener('click', (event) => {
			const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-action]');
			if (!button?.dataset.action) return;

			const next = applyToolbar(
				{ value: input.value, start: input.selectionStart, end: input.selectionEnd },
				button.dataset.action as ToolbarAction,
			);

			input.value = next.value;
			input.focus();
			input.setSelectionRange(next.start, next.end);
			render();
		});

		copy.addEventListener('click', async () => {
			const copied = await copyText(input.value);
			toast(() => tr(dict, copied ? 'markdownCopied' : 'copyFailed'), { tone: copied ? 'success' : 'error' });
		});

		download.addEventListener('click', () => {
			downloadText(markdownFilename(input.value), input.value);
			toast(() => tr(dict, 'markdownDownloaded'), { tone: 'success' });
		});

		render();
	}
</script>
