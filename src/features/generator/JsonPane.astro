---
import dict from './i18n';
import Icon from '../../components/ui/Icon.astro';
---

<div class="pane-grid pane-grid--split">
	<div class="pane">
		<div class="pane__head">
			<h2 class="pane__title" id="json-input-title">Input</h2>
			<div class="pane-actions">
				<button type="button" class="btn btn--secondary" data-json="format">Format</button>
				<button type="button" class="btn btn--secondary" data-json="minify">Minify</button>
			</div>
		</div>

		<label class="sr-only" for="json-input" data-i18n="workspace.generator.jsonText">{dict.id.jsonText}</label>
		<textarea
			id="json-input"
			class="code-area"
			spellcheck="false"
			aria-labelledby="json-input-title"
			placeholder='{"proyek": "toolsman", "alat": 6}'
		></textarea>

		<div class="alert" id="json-error" role="alert" hidden>
			<Icon name="alert" size={16} />
			<p id="json-error-text"></p>
		</div>
	</div>

	<div class="pane">
		<div class="pane__head">
			<h2 class="pane__title" data-i18n="workspace.generator.output">{dict.id.output}</h2>
			<div class="pane-actions">
				<div class="segmented" role="group" aria-label={dict.id.view} data-i18n-aria="workspace.generator.view">
					<button type="button" class="segmented__btn" data-view="teks" aria-pressed="true" data-i18n="workspace.generator.text">{dict.id.text}</button>
					<button type="button" class="segmented__btn" data-view="pohon" aria-pressed="false" data-i18n="workspace.generator.tree">{dict.id.tree}</button>
				</div>
				<button type="button" class="btn btn--primary" id="json-copy" disabled data-i18n="workspace.generator.copy">{dict.id.copy}</button>
			</div>
		</div>

		<pre class="code-block" id="json-output" hidden><code id="json-output-code"></code></pre>
		<div class="json-tree-wrap" id="json-tree" hidden></div>

		<div class="preview-empty" id="json-empty">
			<p data-i18n="workspace.generator.jsonEmpty">{dict.id.jsonEmpty}</p>
			<button type="button" class="btn btn--secondary mt-3" id="json-sample" data-i18n="workspace.generator.sample">{dict.id.sample}</button>
		</div>
	</div>
</div>

<script>
	import { tr, currentLang } from '../../lib/i18n';
	import dict from './i18n';
	import { localizedText } from '../../lib/i18n-client';
	import { copyText } from '../../lib/clipboard';
	import {
		formatJson,
		parseJson,
		highlightJson,
		minifyJson,
		renderJsonTree,
		type JsonError,
	} from '../../lib/json-tools';
	import { toast } from '../../lib/toast';

	const input = document.getElementById('json-input') as HTMLTextAreaElement | null;
	const errorBox = document.getElementById('json-error');
	const errorText = document.getElementById('json-error-text');
	const output = document.getElementById('json-output');
	const outputCode = document.getElementById('json-output-code');
	const tree = document.getElementById('json-tree');
	const empty = document.getElementById('json-empty');
	const copy = document.getElementById('json-copy') as HTMLButtonElement | null;
	const sample = document.getElementById('json-sample');
	const viewButtons = Array.from(
		document.querySelectorAll<HTMLButtonElement>('[data-view]'),
	);

	if (
		input &&
		errorBox &&
		errorText &&
		output &&
		outputCode &&
		tree &&
		empty &&
		copy &&
		sample
	) {
		let currentText = '';
		let currentData: unknown = null;
		let view: 'teks' | 'pohon' = 'teks';

		const paint = () => {
			const blank = currentText === '';
			empty.hidden = !blank;
			output.hidden = blank || view !== 'teks';
			tree.hidden = blank || view !== 'pohon';
		};

		const clearError = () => {
			errorBox.hidden = true;
			localizedText(errorText, () => '');
			input.removeAttribute('aria-invalid');
			input.removeAttribute('aria-describedby');
		};

		const showError = (error: JsonError) => {
			const source = input.value;
			localizedText(errorText, () => { const parsed = parseJson(source, currentLang()); const detail = parsed.ok ? error : parsed.error; return tr(dict, 'jsonPosition', { line: detail.line, column: detail.column, message: detail.message }); });
			errorBox.hidden = false;
			input.setAttribute('aria-invalid', 'true');
			input.setAttribute('aria-describedby', 'json-error-text');
			input.focus();
			const at = Math.min(error.index, input.value.length);
			input.setSelectionRange(at, at);
		};

		const reset = () => {
			currentText = '';
			currentData = null;
			outputCode.textContent = '';
			tree.innerHTML = '';
			copy.disabled = true;
			paint();
		};

		const run = (mode: 'format' | 'minify') => {
			clearError();
			const result = mode === 'format' ? formatJson(input.value, currentLang()) : minifyJson(input.value, currentLang());

			if (!result.ok) {
				reset();
				showError(result.error);
				return;
			}

			currentText = result.text;
			currentData = result.data;
			outputCode.innerHTML = highlightJson(result.text);
			tree.innerHTML = renderJsonTree(result.data, { openDepth: 1, lang: currentLang() });
			copy.disabled = false;
			paint();
		};

		document.querySelectorAll<HTMLButtonElement>('[data-json]').forEach((button) => {
			button.addEventListener('click', () => {
				run(button.dataset.json === 'minify' ? 'minify' : 'format');
			});
		});

		viewButtons.forEach((button) => {
			button.addEventListener('click', () => {
				view = button.dataset.view === 'pohon' ? 'pohon' : 'teks';
				viewButtons.forEach((other) =>
					other.setAttribute('aria-pressed', other === button ? 'true' : 'false'),
				);
				paint();
			});
		});

		input.addEventListener('input', () => {
			clearError();
			reset();
		});

		copy.addEventListener('click', async () => {
			const copied = await copyText(currentText);
			toast(() => tr(dict, copied ? 'jsonCopied' : 'copyFailed'), { tone: copied ? 'success' : 'error' });
		});

		sample.addEventListener('click', () => {
			input.value = '{\n  "proyek": "toolsman",\n  "alat": 6,\n  "gratis": true\n}';
			input.focus();
			run('format');
		});

		document.addEventListener('lang:change', () => {
			if (!currentText) return;
			const opened = Array.from(tree.querySelectorAll('details'), node => node.open);
			tree.innerHTML = renderJsonTree(currentData, { openDepth: 1, lang: currentLang() });
			tree.querySelectorAll('details').forEach((node, index) => { node.open = opened[index] ?? node.open; });
		});
		paint();
	}
</script>
