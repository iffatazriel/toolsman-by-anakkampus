---
import dict from './i18n';
import { defaultGitignoreGroups, gitignoreGroups } from '../../lib/gitignore';
---

<div class="pane-grid pane-grid--split">
	<div class="pane">
		<div class="pane__head">
			<h2 class="pane__title" data-i18n="workspace.generator.stack">{dict.id.stack}</h2>
		</div>
		<p class="field-hint" data-i18n="workspace.generator.stackHint">{dict.id.stackHint}</p>

		<div class="check-grid">
			{
				gitignoreGroups.map((group) => (
					<label class="check-row">
						<input
							type="checkbox"
							value={group.id}
							checked={defaultGitignoreGroups.includes(group.id)}
							data-gitignore-group
						/>
						<span data-i18n={group.id === 'env' ? 'workspace.generator.groupSecrets' : group.id === 'logs' ? 'workspace.generator.groupLogs' : group.id === 'coverage' ? 'workspace.generator.groupTests' : undefined}>{group.label}</span>
					</label>
				))
			}
		</div>
	</div>

	<div class="pane">
		<div class="pane__head">
			<h2 class="pane__title" data-i18n="workspace.generator.gitignoreOutput">{dict.id.gitignoreOutput}</h2>
			<div class="pane-actions">
				<button type="button" class="btn btn--secondary" id="gitignore-copy" disabled data-i18n="workspace.generator.copy">{dict.id.copy}</button>
				<button
					type="button"
					class="btn btn--primary"
					id="gitignore-download"
					disabled
				 data-i18n="workspace.generator.gitignoreDownload">{dict.id.gitignoreDownload}</button>
			</div>
		</div>

		<pre class="code-block" id="gitignore-output" hidden><code id="gitignore-code"></code></pre>
		<p class="preview-empty" id="gitignore-empty" data-i18n="workspace.generator.gitignoreEmpty">{dict.id.gitignoreEmpty}</p>
	</div>
</div>

<script>
	import { tr, currentLang } from '../../lib/i18n';
	import dict from './i18n';
	import { copyText } from '../../lib/clipboard';
	import { downloadText } from '../../lib/download';
	import { buildGitignore } from '../../lib/gitignore';
	import { toast } from '../../lib/toast';

	const boxes = Array.from(
		document.querySelectorAll<HTMLInputElement>('[data-gitignore-group]'),
	);
	const output = document.getElementById('gitignore-output');
	const code = document.getElementById('gitignore-code');
	const empty = document.getElementById('gitignore-empty');
	const copy = document.getElementById('gitignore-copy') as HTMLButtonElement | null;
	const download = document.getElementById('gitignore-download') as HTMLButtonElement | null;

	if (boxes.length > 0 && output && code && empty && copy && download) {
		let text = '';

		const update = () => {
			text = buildGitignore(
				boxes.filter((box) => box.checked).map((box) => box.value),
				currentLang(),
			);
			const blank = text === '';
			code.textContent = text;
			output.hidden = blank;
			empty.hidden = !blank;
			copy.disabled = blank;
			download.disabled = blank;
		};

		document.addEventListener('lang:change', update);
		boxes.forEach((box) => box.addEventListener('change', update));

		copy.addEventListener('click', async () => {
			const copied = await copyText(text);
			toast(() => tr(dict, copied ? 'gitignoreCopied' : 'copyFailed'), { tone: copied ? 'success' : 'error' });
		});

		download.addEventListener('click', () => {
			downloadText('.gitignore', text, 'text/plain;charset=utf-8');
			toast(() => tr(dict, 'gitignoreDownloaded'), { tone: 'success' });
		});

		update();
	}
</script>

<style>
	.check-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
		gap: 0 var(--space-3);
	}
</style>
