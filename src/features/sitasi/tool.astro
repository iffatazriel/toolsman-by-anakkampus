---
import dict from './i18n';
---

<div class="tool-shell sitasi-shell">
	<label class="field-label" for="citation-style" data-i18n="workspace.sitasi.style">{dict.id.style}</label>
	<select class="field-input" id="citation-style"><option value="apa">APA 7</option><option value="ieee">IEEE</option></select>
	<p class="field-hint" data-i18n="workspace.sitasi.hint">{dict.id.hint}</p>
	<div class="pane-grid pane-grid--split">
		<form class="pane" id="citation-form">
			<label class="field-label"><span data-i18n="workspace.sitasi.type">{dict.id.type}</span><select class="field-input" name="type"><option value="book" data-i18n="workspace.sitasi.book">{dict.id.book}</option><option value="journal" data-i18n="workspace.sitasi.journal">{dict.id.journal}</option><option value="web" data-i18n="workspace.sitasi.web">{dict.id.web}</option></select></label>
			<fieldset><legend class="field-label" data-i18n="workspace.sitasi.authors">{dict.id.authors}</legend><div id="citation-authors"></div><button class="btn btn--secondary" type="button" id="citation-add-author" data-i18n="workspace.sitasi.addAuthor">{dict.id.addAuthor}</button></fieldset>
			<label class="field-label"><span data-i18n="workspace.sitasi.year">{dict.id.year}</span><input class="field-input" name="year" inputmode="numeric" pattern="[0-9]{4}" maxlength="4" placeholder={dict.id.yearPlaceholder} data-i18n-placeholder="workspace.sitasi.yearPlaceholder" /></label>
			<label class="field-label"><span data-i18n="workspace.sitasi.title">{dict.id.title}</span><input class="field-input" name="title" required maxlength="2000" /></label>
			<label class="field-label"><span id="citation-publisher-label" data-i18n="workspace.sitasi.publisher">{dict.id.publisher}</span><input class="field-input" name="publisher" maxlength="500" /></label>
			<div id="citation-journal" hidden>
				<label class="field-label">Volume<input class="field-input" name="volume" maxlength="50" /></label>
				<label class="field-label"><span data-i18n="workspace.sitasi.issue">{dict.id.issue}</span><input class="field-input" name="issue" maxlength="50" /></label>
				<label class="field-label"><span data-i18n="workspace.sitasi.pages">{dict.id.pages}</span><input class="field-input" name="pages" placeholder="12-24" maxlength="100" /></label>
			</div>
			<label class="field-label">DOI<input class="field-input" name="doi" placeholder="10.1234/contoh" maxlength="1000" /></label>
			<label class="field-label">URL<input class="field-input" name="url" type="url" placeholder="https://…" maxlength="2000" /></label>
			<label class="field-label" id="citation-access-field" hidden><span data-i18n="workspace.sitasi.accessed">{dict.id.accessed}</span><input class="field-input" name="accessed" type="date" /></label>
			<button class="btn btn--primary" type="submit" data-i18n="workspace.sitasi.add">{dict.id.add}</button>
		</form>
		<div class="pane">
			<h2 class="pane__title" data-i18n="workspace.sitasi.bibliography">{dict.id.bibliography}</h2>
			<p class="field-hint" data-i18n="workspace.sitasi.listHint">{dict.id.listHint}</p>
			<p id="citation-empty" data-i18n="workspace.sitasi.empty">{dict.id.empty}</p>
			<div id="citation-list"></div>
			<div class="pane-actions"><button class="btn btn--secondary" type="button" id="citation-copy-all" disabled data-i18n="workspace.sitasi.copyAll">{dict.id.copyAll}</button><button class="btn btn--secondary" type="button" id="citation-download" disabled data-i18n="workspace.sitasi.download">{dict.id.download}</button><button class="btn btn--secondary" type="button" id="citation-bibtex" disabled data-i18n="workspace.sitasi.bibtex">{dict.id.bibtex}</button></div>
		</div>
	</div>
	<p id="citation-error" class="field-error" role="alert" hidden></p>
	<p id="citation-status" class="field-hint" role="status"></p>
</div>

<script>
	import { tr, WorkspaceError, workspaceErrorMessage } from '../../lib/i18n';
	import { localizedText } from '../../lib/i18n-client';
	import dict from './i18n';
	import { copyText } from '../../lib/clipboard';
	import { downloadText } from '../../lib/download';
	import { citation, bibtex, orderedEntries, readEntries, validateEntry, type Entry, type Style } from './citation';
	const form = document.querySelector<HTMLFormElement>('#citation-form')!;
	const style = document.querySelector<HTMLSelectElement>('#citation-style')!;
	const authors = document.querySelector<HTMLElement>('#citation-authors')!;
	const list = document.querySelector<HTMLElement>('#citation-list')!;
	const error = document.querySelector<HTMLElement>('#citation-error')!;
	const status = document.querySelector<HTMLElement>('#citation-status')!;
	const key = 'toolsman-sitasi-v1';
	let entries: Entry[] = [];
	const showError = (message: () => string) => { localizedText(error, message); error.hidden = false; };
	const addAuthor = () => {
		if (authors.children.length >= 200) { showError(() => tr(dict, 'maxAuthors')); return; }
		const row = document.createElement('div');
		row.className = 'citation-author';
		for (const [field, text] of [['first', 'firstName'], ['last', 'lastName']] as const) {
			const label = document.createElement('label');
			label.className = 'field-label';
			const span = document.createElement('span'); localizedText(span, () => tr(dict, text)); label.append(span);
			const input = document.createElement('input');
			input.className = 'field-input'; input.dataset.author = field; input.maxLength = 200;
			label.append(input); row.append(label);
		}
		const remove = document.createElement('button');
		remove.type = 'button'; remove.className = 'btn btn--ghost'; localizedText(remove, () => tr(dict, 'removeAuthor'));
		remove.addEventListener('click', () => { row.remove(); document.querySelector<HTMLButtonElement>('#citation-add-author')!.focus(); });
		row.append(remove); authors.append(row);
		row.querySelector('input')!.focus();
	};
	const sorted = () => orderedEntries(entries, style.value as Style);
	const allText = () => sorted().map((e, i) => citation(e, style.value as Style, i + 1).text).join('\n\n');
	const copy = async (text: string, plainFallback = false) => { const copied = await copyText(text); localizedText(status, () => tr(dict, plainFallback ? (copied ? 'plainFallback' : 'plainFailed') : (copied ? 'copied' : 'copyFailed'))); };
	const save = () => { try { localStorage.setItem(key, JSON.stringify(entries)); } catch { showError(() => tr(dict, 'saveFailed')); } };
	const render = () => {
		list.replaceChildren();
		document.getElementById('citation-empty')!.hidden = entries.length > 0;
		for (const id of ['citation-copy-all', 'citation-download', 'citation-bibtex']) document.querySelector<HTMLButtonElement>(`#${id}`)!.disabled = entries.length === 0;
		sorted().forEach((entry, i) => {
			const result = citation(entry, style.value as Style, i + 1);
			const item = document.createElement('section'); item.className = 'citation-entry';
			const preview = document.createElement('p'); preview.innerHTML = result.html;
			const inline = document.createElement('p'); inline.textContent = tr(dict, 'inText', { citation: result.inText });
			item.append(preview, inline);
			const button = (text: string, action: () => void) => { const b = document.createElement('button'); b.type = 'button'; b.className = 'btn btn--secondary'; b.textContent = text; b.addEventListener('click', action); item.append(b); };
			button(tr(dict, 'copyText'), () => void copy(result.text));
			button(tr(dict, 'copyRich'), () => { void (async () => {
				try {
					await navigator.clipboard.write([new ClipboardItem({ 'text/html': new Blob([result.html], { type: 'text/html' }), 'text/plain': new Blob([result.text], { type: 'text/plain' }) })]);
					localizedText(status, () => tr(dict, 'richCopied'));
				} catch { await copy(result.text, true); }
			})(); });
			button(tr(dict, 'removeSource'), () => { entries = entries.filter((e) => e.id !== entry.id); save(); render(); style.focus(); });
			list.append(item);
		});
	};
	document.getElementById('citation-add-author')!.addEventListener('click', addAuthor);
	const type = form.elements.namedItem('type') as HTMLSelectElement;
	type.addEventListener('change', () => {
		document.getElementById('citation-journal')!.hidden = type.value !== 'journal';
		document.getElementById('citation-access-field')!.hidden = type.value !== 'web';
		localizedText(document.getElementById('citation-publisher-label'), () => tr(dict, type.value === 'journal' ? 'journalName' : type.value === 'web' ? 'siteName' : 'publisher'));
	});
	form.addEventListener('submit', (event) => {
		event.preventDefault(); error.hidden = true;
		try {
			if (entries.length >= 500) throw new WorkspaceError(dict, 'full');
			const data = Object.fromEntries(new FormData(form)) as Record<string, string>;
			const people = Array.from(authors.children).map((row) => ({ first: row.querySelector<HTMLInputElement>('[data-author="first"]')!.value.trim(), last: row.querySelector<HTMLInputElement>('[data-author="last"]')!.value.trim() }));
			if (people.some((a) => a.first && !a.last)) throw new WorkspaceError(dict, 'authorError');
			const entry: Entry = { id: crypto.randomUUID(), type: type.value as Entry['type'], authors: people.filter((a) => a.last), year: data.year.trim(), title: data.title.trim(), publisher: data.publisher.trim(), volume: type.value === 'journal' ? data.volume.trim() : '', issue: type.value === 'journal' ? data.issue.trim() : '', pages: type.value === 'journal' ? data.pages.trim() : '', doi: data.doi.trim(), url: data.url.trim(), accessed: type.value === 'web' ? data.accessed : '' };
			validateEntry(entry); entries.push(entry); save(); render(); localizedText(status, () => tr(dict, 'added'));
		} catch (problem) { showError(() => workspaceErrorMessage(problem, tr(dict, 'fallback'))); }
	});
	style.addEventListener('change', render);
	document.getElementById('citation-copy-all')!.addEventListener('click', () => void copy(allText()));
	document.getElementById('citation-download')!.addEventListener('click', () => downloadText('daftar-pustaka.txt', allText(), 'text/plain;charset=utf-8'));
	document.getElementById('citation-bibtex')!.addEventListener('click', () => downloadText('referensi.bib', sorted().map((e, i) => bibtex(e, i + 1)).join('\n\n'), 'text/plain;charset=utf-8'));
	try { const raw = localStorage.getItem(key); if (raw) entries = readEntries(raw); } catch { showError(() => tr(dict, 'loadFailed')); }
	document.addEventListener('lang:change', render);
	addAuthor(); render();
</script>

<style>
	.sitasi-shell { padding: var(--space-4); }
	fieldset { border: 1px solid var(--border); border-radius: var(--radius-md); padding: var(--space-3); min-width: 0; }
	#citation-list { overflow-wrap: anywhere; }
	:global(.citation-author) { display: flex; flex-wrap: wrap; align-items: end; gap: var(--space-2); margin-bottom: var(--space-3); }
	:global(.citation-author label) { flex: 1 1 120px; }
	:global(.citation-entry) { border-bottom: 1px solid var(--border); padding-block: var(--space-3); }
	:global(.citation-entry .btn) { margin: var(--space-1); }
	.pane-actions { flex-wrap: wrap; }
</style>
