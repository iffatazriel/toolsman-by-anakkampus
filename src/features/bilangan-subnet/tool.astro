---
import Tabs from '../../components/ui/Tabs.astro';
---

<div class="tool-shell bilangan-shell">
	<Tabs label="Bilangan dan jaringan" items={[{ id: 'bilangan', label: 'Konverter bilangan' }, { id: 'subnet', label: 'Subnet IPv4' }]}>
		<section data-panel="bilangan" class="pane">
			<label class="field-label" for="number-input">Bilangan bulat (maksimal 4.096 digit)</label>
			<textarea id="number-input" class="code-area" spellcheck="false" placeholder="Contoh: -255 atau FF"></textarea>
			<div class="option-row">
				<label class="field-label">Basis input<select id="number-base" class="field-input"><option value="10">10 (desimal)</option><option value="2">2 (biner)</option><option value="8">8 (oktal)</option><option value="16">16 (heksadesimal)</option><option value="custom">Khusus</option></select></label>
				<label class="field-label">Basis khusus (input/hasil)<input id="number-custom" class="field-input" type="number" min="2" max="36" step="1" value="36" /></label>
				<label><input id="number-group" type="checkbox" /> Kelompokkan digit</label>
				<label class="field-label">Komplemen dua<select id="number-bits" class="field-input"><option value="0">Tanpa tampilan bit</option>{[8,16,32,64].map((n) => <option value={n}>{n} bit signed</option>)}</select></label>
			</div>
			<p class="field-hint">Tanda negatif didukung. Spasi dan garis bawah diabaikan. Prefiks 0b/0o/0x boleh dipakai pada basis yang cocok. Komplemen dua dibatasi rentang signed dari lebar bit pilihanmu.</p>
			<button type="button" class="btn btn--primary" id="number-run">Konversi</button>
			<p class="field-error" role="alert" id="number-error" hidden></p>
			<label class="field-label" for="number-output">Semua basis</label><textarea readonly class="code-area" id="number-output"></textarea>
			<button type="button" class="btn btn--secondary" id="number-copy" disabled>Salin hasil</button>
		</section>
		<section data-panel="subnet" class="pane" hidden>
			<div class="option-row"><label class="field-label">IP atau IP/CIDR<input class="field-input" id="subnet-ip" value="192.168.1.10/24" /></label><label class="field-label">CIDR atau mask (jika IP tanpa /)<input class="field-input" id="subnet-mask" placeholder="24 atau 255.255.255.0" /></label></div>
			<button type="button" class="btn btn--primary" id="subnet-run">Hitung subnet</button>
			<p class="field-error" role="alert" id="subnet-error" hidden></p>
			<label class="field-label" for="subnet-output">Hasil jaringan</label><textarea readonly class="code-area" id="subnet-output"></textarea>
			<p class="field-hint">Kelas A–E adalah klasifikasi lama; perhitungan memakai CIDR. “Publik” bukan pemeriksaan routing atau daftar alamat khusus yang lengkap. /31 dihitung untuk point-to-point; broadcast menampilkan akhir blok.</p>
			<div class="option-row"><label class="field-label">Bagi berdasarkan<select class="field-input" id="subnet-mode"><option value="count">Jumlah subnet (pangkat dua)</option><option value="hosts">Kebutuhan host tiap subnet</option></select></label><label class="field-label">Jumlah<input class="field-input" id="subnet-amount" type="number" min="1" step="1" value="4" /></label></div>
			<p class="field-hint">Kebutuhan 1 host memakai /32; 2 host memakai /31 point-to-point. Untuk LAN biasa dengan network dan broadcast, gunakan kebutuhan minimal 3 host.</p>
			<button type="button" class="btn btn--secondary" id="subnet-split">Bagi subnet</button>
			<label class="field-label" for="subnet-list">Daftar subnet (maksimal 256)</label><textarea readonly class="code-area" id="subnet-list"></textarea>
			<button type="button" class="btn btn--secondary" id="subnet-copy" disabled>Salin hasil jaringan dan pembagian</button>
		</section>
	</Tabs>
	<p class="field-hint" role="status" id="bilangan-status"></p>
</div>

<script>
	import { copyText } from '../../lib/clipboard';
	import { convertInteger, grouped, parseInteger, splitSubnet, subnet, twosComplement } from './network';
	const input = <T extends HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(id: string) => document.getElementById(id) as T;
	const numberOutput = input<HTMLTextAreaElement>('number-output');
	const subnetOutput = input<HTMLTextAreaElement>('subnet-output');
	const subnetList = input<HTMLTextAreaElement>('subnet-list');
	const copyNumber = document.querySelector<HTMLButtonElement>('#number-copy')!;
	const copySubnet = document.querySelector<HTMLButtonElement>('#subnet-copy')!;
	const numberError = document.getElementById('number-error')!;
	const subnetError = document.getElementById('subnet-error')!;
	const message = (node: HTMLElement, error: unknown) => { node.textContent = error instanceof Error ? error.message : 'Periksa isian kamu.'; node.hidden = false; };
	document.getElementById('number-run')!.addEventListener('click', () => {
		numberError.hidden = true; numberOutput.value = ''; copyNumber.disabled = true;
		try {
			const source = input<HTMLTextAreaElement>('number-input').value;
			const custom = input<HTMLInputElement>('number-custom').valueAsNumber;
			const base = input<HTMLSelectElement>('number-base').value;
			const radix = base === 'custom' ? custom : Number(base);
			const group = input<HTMLInputElement>('number-group').checked;
			numberOutput.value = convertInteger(source, radix, custom, group).map((item) => `Basis ${item.base}: ${item.value}`).join('\n\n');
			const bits = Number(input<HTMLSelectElement>('number-bits').value);
			if (bits) {
				try {
					const result = twosComplement(parseInteger(source, radix), bits);
					numberOutput.value += `\n\nKomplemen dua ${bits} bit:\n${group ? grouped(result.binary) : result.binary}\nHEX: ${group ? grouped(result.hex) : result.hex}`;
				} catch (error) { message(numberError, error); }
			}
			copyNumber.disabled = false;
		} catch (error) { message(numberError, error); }
	});
	const address = () => [input<HTMLInputElement>('subnet-ip').value, input<HTMLInputElement>('subnet-mask').value] as const;
	const describe = (s: ReturnType<typeof subnet>) => `Network: ${s.network}/${s.prefix}\nBroadcast / akhir blok: ${s.broadcast}\nHost pertama: ${s.first}\nHost terakhir: ${s.last}\nJumlah host: ${s.hosts}\nMask: ${s.mask}\nMask biner: ${s.binary}\nWildcard: ${s.wildcard}\nKelas IP: ${s.ipClass}\nJenis IP: ${s.scope}`;
	const calculate = (split: boolean) => {
		subnetError.hidden = true; subnetOutput.value = ''; subnetList.value = ''; copySubnet.disabled = true;
		try {
			subnetOutput.value = describe(subnet(...address()));
			if (split) subnetList.value = splitSubnet(...address(), input<HTMLSelectElement>('subnet-mode').value as 'count' | 'hosts', input<HTMLInputElement>('subnet-amount').valueAsNumber).map((s, i) => `${i + 1}. ${s.network}/${s.prefix} | ${s.first} – ${s.last} | ${s.hosts} host | akhir ${s.broadcast}`).join('\n');
			copySubnet.disabled = false;
		} catch (error) { message(subnetError, error); }
	};
	document.getElementById('subnet-run')!.addEventListener('click', () => calculate(false));
	document.getElementById('subnet-split')!.addEventListener('click', () => calculate(true));
	const copy = async (value: string) => { document.getElementById('bilangan-status')!.textContent = await copyText(value) ? 'Hasil disalin.' : 'Gagal menyalin. Pilih hasilnya lalu tekan Ctrl+C.'; };
	copyNumber.addEventListener('click', () => void copy(numberOutput.value));
	copySubnet.addEventListener('click', () => void copy([subnetOutput.value, subnetList.value].filter(Boolean).join('\n\n')));
	document.querySelector('[data-panel="bilangan"]')!.addEventListener('input', (event) => { if (event.target === numberOutput) return; numberOutput.value = ''; copyNumber.disabled = true; numberError.hidden = true; });
	document.querySelector('[data-panel="subnet"]')!.addEventListener('input', (event) => { if (event.target === subnetOutput || event.target === subnetList) return; subnetOutput.value = ''; subnetList.value = ''; copySubnet.disabled = true; subnetError.hidden = true; });
</script>

<style>
	.bilangan-shell { padding: var(--space-4); }
	.option-row { display: flex; flex-wrap: wrap; align-items: end; gap: var(--space-3); }
	.option-row > label { flex: 1 1 170px; }
	.code-area { min-height: 180px; }
</style>
