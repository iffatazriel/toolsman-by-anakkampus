---
import dict from './i18n';
---

<div class="tool-shell ipk-shell">
	<div class="pane-grid pane-grid--split">
		<div class="pane">
			<label class="field-label" for="ipk-scale" data-i18n="workspace.kalkulator-ipk.scale">{dict.id.scale}</label>
			<select class="field-input" id="ipk-scale"><option value="ab">A, AB, B, BC, C, D, E</option><option value="plus">A, A-, B+, B, B-, C+, C, D, E</option></select>
			<p class="field-hint" data-i18n="workspace.kalkulator-ipk.scaleHint">{dict.id.scaleHint}</p>
			<div id="ipk-values" class="ipk-values"></div>
		</div>
		<div class="pane">
			<h2 class="pane__title" data-i18n="workspace.kalkulator-ipk.summary">{dict.id.summary}</h2>
			<p id="ipk-summary" class="ipk-summary" role="status"></p>
			<h3 class="pane__title" data-i18n="workspace.kalkulator-ipk.target">{dict.id.target}</h3>
			<label class="field-label"><span data-i18n="workspace.kalkulator-ipk.targetLabel">{dict.id.targetLabel}</span><input class="field-input" id="ipk-target" type="number" min="0" max="4" step="0.01" value="3.5" /></label>
			<label class="field-label"><span data-i18n="workspace.kalkulator-ipk.remaining">{dict.id.remaining}</span><input class="field-input" id="ipk-remaining" type="number" min="0.5" max="1000" step="0.5" value="20" /></label>
			<p id="ipk-target-result" role="status"></p>
			<p class="field-hint" data-i18n="workspace.kalkulator-ipk.hint">{dict.id.hint}</p>
		</div>
	</div>
	<div id="ipk-semesters"></div>
	<div class="pane-actions"><button class="btn btn--primary" id="ipk-add-semester" data-task-action type="button" data-i18n="workspace.kalkulator-ipk.addSemester">{dict.id.addSemester}</button><button class="btn btn--secondary" id="ipk-copy" type="button" data-i18n="workspace.kalkulator-ipk.copy">{dict.id.copy}</button><button class="btn btn--secondary" id="ipk-export" type="button" data-i18n="workspace.kalkulator-ipk.export">{dict.id.export}</button><label class="btn btn--secondary" for="ipk-import" data-i18n="workspace.kalkulator-ipk.import">{dict.id.import}</label><input id="ipk-import" type="file" accept="application/json,.json" /><button class="btn btn--ghost" id="ipk-reset" type="button" data-i18n="workspace.kalkulator-ipk.reset">{dict.id.reset}</button></div>
	<p class="field-hint" role="status" id="ipk-status"></p>
	<p class="field-error" role="alert" id="ipk-error" hidden></p>
</div>

<script>
	import { tr, WorkspaceError, workspaceErrorMessage } from '../../lib/i18n';
	import { localizedText } from '../../lib/i18n-client';
	import dict from './i18n';
	import { copyText } from '../../lib/clipboard';
	import { downloadText } from '../../lib/download';
	import { changeScale, cumulative, initialData, parseData, summarize, targetAverage, type GpaData, type Semester } from './gpa';
	const scale = document.querySelector<HTMLSelectElement>('#ipk-scale')!;
	const semesters = document.querySelector<HTMLElement>('#ipk-semesters')!;
	const weights = document.querySelector<HTMLElement>('#ipk-values')!;
	const summary = document.querySelector<HTMLElement>('#ipk-summary')!;
	const error = document.querySelector<HTMLElement>('#ipk-error')!;
	const status = document.querySelector<HTMLElement>('#ipk-status')!;
	const target = document.querySelector<HTMLInputElement>('#ipk-target')!;
	const remaining = document.querySelector<HTMLInputElement>('#ipk-remaining')!;
	const targetResult = document.querySelector<HTMLElement>('#ipk-target-result')!;
	const key = 'toolsman-ipk-v1';
	let data = initialData();
	const showError = (text: () => string) => { localizedText(error, text); error.hidden = false; };
	try { const raw = localStorage.getItem(key); if (raw) data = parseData(raw); } catch { showError(() => tr(dict, 'loadFailed')); }
	const save = () => { try { localStorage.setItem(key, JSON.stringify(data)); } catch { showError(() => tr(dict, 'saveFailed')); } };
	const display = (value: number | null) => value === null ? '—' : value.toFixed(2);
	const calculate = () => {
		if (weights.querySelector('input:invalid') || semesters.querySelector('input:invalid')) {
			localizedText(summary, () => tr(dict, 'fixSummary'));
			localizedText(targetResult, () => tr(dict, 'fixGrades'));
			return;
		}
		try {
			const total = cumulative(data.semesters, data.values);
			localizedText(summary, () => tr(dict, 'cumulative', { gpa: display(total.gpa), credits: total.credits }));
			data.semesters.forEach((semester) => {
				const result = summarize(semester.courses, data.values);
				const node = document.getElementById(`ips-${semester.id}`);
				localizedText(node, () => tr(dict, 'semesterSummary', { gpa: display(result.gpa), credits: result.credits }));
			});
			try {
				const result = targetAverage(total, remaining.valueAsNumber, target.valueAsNumber, Math.max(...Object.values(data.values)));
				localizedText(targetResult, () => tr(dict, result.reached ? 'reached' : result.possible ? 'needed' : 'impossible', { average: result.needed.toFixed(2), max: Math.max(...Object.values(data.values)).toFixed(2) }));
			} catch (problem) { localizedText(targetResult, () => workspaceErrorMessage(problem, tr(dict, 'targetFallback'))); }
		} catch (problem) { showError(() => workspaceErrorMessage(problem, tr(dict, 'gradeFallback'))); }
	};
	const button = (text: () => string, action: () => void) => { const b = document.createElement('button'); b.type = 'button'; b.className = 'btn btn--secondary'; localizedText(b, text); b.addEventListener('click', action); return b; };
	const field = (text: () => string, input: HTMLInputElement | HTMLSelectElement) => { const label = document.createElement('label'); label.className = 'field-label'; const span = document.createElement('span'); localizedText(span, text); label.append(span, input); return label; };
	const input = (value: string) => { const node = document.createElement('input'); node.className = 'field-input'; node.value = value; node.maxLength = 200; return node; };
	const changed = () => { error.hidden = true; save(); calculate(); };
	const renderCourses = (semester: Semester, container: HTMLElement) => {
		container.replaceChildren();
		semester.courses.forEach((course) => {
			const row = document.createElement('div'); row.className = 'ipk-course';
			const name = input(course.name);
			name.addEventListener('input', () => { course.name = name.value; changed(); });
			const credits = input(String(course.credits)); credits.type = 'number'; credits.min = '0'; credits.max = '30'; credits.step = 'any'; credits.required = true;
			credits.addEventListener('input', () => {
				if (!credits.validity.valid || !Number.isFinite(credits.valueAsNumber)) { showError(() => tr(dict, 'creditsError')); calculate(); return; }
				course.credits = credits.valueAsNumber; changed();
			});
			const grade = document.createElement('select'); grade.className = 'field-input';
			for (const g of ['', ...Object.keys(data.values)]) { const option = document.createElement('option'); option.value = g; localizedText(option, () => g || tr(dict, 'noGrade')); grade.append(option); }
			grade.value = course.grade; grade.addEventListener('change', () => { course.grade = grade.value; changed(); });
			row.append(field(() => tr(dict, 'course'), name), field(() => tr(dict, 'credits'), credits), field(() => tr(dict, 'grade'), grade), button(() => tr(dict, 'removeCourse'), () => { semester.courses = semester.courses.filter((c) => c.id !== course.id); render(); changed(); document.getElementById(`add-${semester.id}`)!.focus(); }));
			container.append(row);
		});
	};
	const render = () => {
		scale.value = data.scale; weights.replaceChildren(); semesters.replaceChildren();
		for (const [grade, value] of Object.entries(data.values)) {
			const weight = input(String(value)); weight.type = 'number'; weight.min = '0'; weight.max = '4'; weight.step = 'any'; weight.required = true;
			weight.addEventListener('input', () => {
				if (!weight.validity.valid || !Number.isFinite(weight.valueAsNumber)) { showError(() => tr(dict, 'weightError')); calculate(); return; }
				data.values[grade] = weight.valueAsNumber; changed();
			}); weights.append(field(() => grade, weight));
		}
		data.semesters.forEach((semester) => {
			const section = document.createElement('section'); section.className = 'pane ipk-semester';
			const name = input(semester.name); name.addEventListener('input', () => { semester.name = name.value; changed(); });
			const ips = document.createElement('p'); ips.id = `ips-${semester.id}`; ips.className = 'ipk-summary';
			const rows = document.createElement('div'); renderCourses(semester, rows);
			const add = button(() => tr(dict, 'addCourse'), () => { if (semester.courses.length >= 100) { showError(() => tr(dict, 'coursesError')); return; } semester.courses.push({ id: crypto.randomUUID(), name: '', credits: 3, grade: '' }); renderCourses(semester, rows); changed(); rows.lastElementChild!.querySelector('input')!.focus(); }); add.id = `add-${semester.id}`;
			section.append(field(() => tr(dict, 'semesterName'), name), ips, rows, add, button(() => tr(dict, 'removeSemester'), () => { if (!confirm(tr(dict, 'removeConfirm', { name: semester.name }))) return; data.semesters = data.semesters.filter((s) => s.id !== semester.id); render(); changed(); document.getElementById('ipk-add-semester')!.focus(); }));
			semesters.append(section);
		}); calculate();
	};
	scale.addEventListener('change', () => { if (!confirm(tr(dict, 'scaleConfirm'))) { scale.value = data.scale; return; } data = changeScale(data, scale.value as GpaData['scale']); render(); changed(); });
	[target, remaining].forEach((node) => node.addEventListener('input', calculate));
	document.getElementById('ipk-add-semester')!.addEventListener('click', () => { if (data.semesters.length >= 50) { showError(() => tr(dict, 'semestersError')); return; } data.semesters.push({ id: crypto.randomUUID(), name: `Semester ${data.semesters.length + 1}`, courses: [] }); render(); changed(); semesters.lastElementChild!.querySelector('input')!.focus(); });
	document.getElementById('ipk-copy')!.addEventListener('click', async () => { const text = [summary.textContent, ...data.semesters.map((s) => { const result = summarize(s.courses, data.values); return `${s.name}: ${tr(dict, 'semesterSummary', { gpa: display(result.gpa), credits: result.credits })}`; })].join('\n'); const copied = await copyText(text); localizedText(status, () => tr(dict, copied ? 'copied' : 'copyFailed')); });
	document.getElementById('ipk-export')!.addEventListener('click', () => downloadText('ipk.json', JSON.stringify(data, null, 2), 'application/json;charset=utf-8'));
	const upload = document.querySelector<HTMLInputElement>('#ipk-import')!;
	upload.addEventListener('change', async () => {
		const file = upload.files?.[0]; if (!file) return;
		try {
			if (file.size > 1_000_000) throw new WorkspaceError(dict, 'sizeError');
			const imported = parseData(await file.text());
			if (!confirm(tr(dict, 'importConfirm'))) return;
			data = imported; render(); changed(); localizedText(status, () => tr(dict, 'imported'));
		} catch (problem) { showError(() => workspaceErrorMessage(problem, tr(dict, 'jsonError'))); }
		finally { upload.value = ''; }
	});
	document.getElementById('ipk-reset')!.addEventListener('click', () => { if (!confirm(tr(dict, 'resetConfirm'))) return; data = initialData(); render(); changed(); localizedText(status, () => tr(dict, 'resetDone')); });
	render();
</script>

<style>
	.ipk-shell { padding: var(--space-4); }
	.ipk-values { display: flex; flex-wrap: wrap; gap: var(--space-2); }
	:global(.ipk-values label) { width: 80px; }
	:global(.ipk-course) { display: flex; flex-wrap: wrap; gap: var(--space-2); align-items: end; margin-block: var(--space-3); }
	:global(.ipk-course label) { flex: 1 1 130px; }
	:global(.ipk-course label:first-child) { flex: 2 1 200px; }
	:global(.ipk-semester) { margin-block: var(--space-4); }
	:global(.ipk-summary) { font-family: var(--font-mono); font-size: 1.125rem; }
	.pane-actions { flex-wrap: wrap; }
	#ipk-import { max-width: 100%; }
</style>
