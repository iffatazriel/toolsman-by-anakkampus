---
---

<div class="tool-shell code-image-shell">
	<div class="pane-grid pane-grid--split">
		<div class="pane">
			<div class="pane__head">
				<h2 class="pane__title">Kode</h2>
				<select class="field-input ci-language" id="ci-language">
					<option value="javascript">JavaScript</option>
					<option value="typescript">TypeScript</option>
					<option value="xml">HTML</option>
					<option value="css">CSS</option>
					<option value="json">JSON</option>
					<option value="bash">Bash</option>
					<option value="python">Python</option>
					<option value="sql">SQL</option>
					<option value="markdown">Markdown</option>
					<option value="plaintext">Teks biasa</option>
				</select>
			</div>

			<label class="sr-only" for="ci-code">Kode yang akan dijadikan gambar</label>
			<textarea
				id="ci-code"
				class="code-area"
				spellcheck="false"
				placeholder="const halo = 'dunia';"></textarea>

			<div class="form-grid">
				<div>
					<span class="field-label">Tema gambar</span>
					<div class="segmented" role="group" aria-label="Tema gambar">
						<button type="button" class="segmented__btn" data-ci-theme="light" aria-pressed="true">
							Terang
						</button>
						<button type="button" class="segmented__btn" data-ci-theme="dark" aria-pressed="false">
							Gelap
						</button>
					</div>
				</div>

				<div>
					<label class="field-label" for="ci-padding">Padding</label>
					<input id="ci-padding" type="range" min="16" max="64" step="4" value="32" />
					<p class="field-hint" id="ci-padding-value">32 px</p>
				</div>

				<div>
					<label class="field-label" for="ci-radius">Sudut</label>
					<input id="ci-radius" type="range" min="0" max="28" step="2" value="12" />
					<p class="field-hint" id="ci-radius-value">12 px</p>
				</div>
			</div>

			<div class="pane-actions">
				<button type="button" class="btn btn--primary" id="ci-download" disabled>
					Unduh PNG
				</button>
			</div>

			<div class="ci-status-row">
				<span class="spinner" id="ci-spinner" hidden aria-hidden="true"></span>
				<p class="field-hint" id="ci-status" role="status" aria-live="polite">
					Tempel kode untuk melihat pratinjau.
				</p>
			</div>

			<div class="alert" id="ci-error" role="alert" hidden>
				<p id="ci-error-text"></p>
			</div>
		</div>

		<div class="pane">
			<div class="pane__head">
				<h2 class="pane__title">Pratinjau</h2>
				<span class="field-hint" id="ci-size"></span>
			</div>

			<div class="ci-preview">
				<canvas id="ci-canvas" aria-label="Pratinjau gambar kode" hidden></canvas>
				<p class="preview-empty" id="ci-empty">Pratinjau muncul setelah ada kode.</p>
			</div>
		</div>
	</div>
</div>

<script>
	import hljs from 'highlight.js/lib/core';
	import bash from 'highlight.js/lib/languages/bash';
	import css from 'highlight.js/lib/languages/css';
	import javascript from 'highlight.js/lib/languages/javascript';
	import json from 'highlight.js/lib/languages/json';
	import markdown from 'highlight.js/lib/languages/markdown';
	import python from 'highlight.js/lib/languages/python';
	import sql from 'highlight.js/lib/languages/sql';
	import typescript from 'highlight.js/lib/languages/typescript';
	import xml from 'highlight.js/lib/languages/xml';
	import { escapeHtml } from '../../lib/html';
	import { toast } from '../../lib/toast';
	import {
		clampPadding,
		clampRadius,
		codeFileName,
		groupRunsByLine,
		parseHighlightHtml,
		themePalette,
		tokenColor,
		type CodeTheme,
	} from './code-image';

	hljs.registerLanguage('javascript', javascript);
	hljs.registerLanguage('typescript', typescript);
	hljs.registerLanguage('xml', xml);
	hljs.registerLanguage('css', css);
	hljs.registerLanguage('json', json);
	hljs.registerLanguage('bash', bash);
	hljs.registerLanguage('python', python);
	hljs.registerLanguage('sql', sql);
	hljs.registerLanguage('markdown', markdown);

	const input = document.getElementById('ci-code') as HTMLTextAreaElement | null;
	const language = document.getElementById('ci-language') as HTMLSelectElement | null;
	const padding = document.getElementById('ci-padding') as HTMLInputElement | null;
	const paddingLabel = document.getElementById('ci-padding-value');
	const radius = document.getElementById('ci-radius') as HTMLInputElement | null;
	const radiusLabel = document.getElementById('ci-radius-value');
	const downloadButton = document.getElementById('ci-download') as HTMLButtonElement | null;
	const canvas = document.getElementById('ci-canvas') as HTMLCanvasElement | null;
	const empty = document.getElementById('ci-empty');
	const status = document.getElementById('ci-status');
	const size = document.getElementById('ci-size');
	const spinner = document.getElementById('ci-spinner');
	const errorBox = document.getElementById('ci-error');
	const errorText = document.getElementById('ci-error-text');
	const themeButtons = Array.from(
		document.querySelectorAll<HTMLButtonElement>('[data-ci-theme]'),
	);

	if (
		input &&
		language &&
		padding &&
		paddingLabel &&
		radius &&
		radiusLabel &&
		downloadButton &&
		canvas &&
		empty &&
		status &&
		size &&
		spinner &&
		errorBox &&
		errorText
	) {
		let theme: CodeTheme = 'light';
		let timer: number | undefined;
		let job = 0;
		let hasImage = false;

		const setError = (message: string | null) => {
			errorBox.hidden = message === null;
			errorText.textContent = message ?? '';
		};

		const drawRoundedRect = (
			context: CanvasRenderingContext2D,
			width: number,
			height: number,
			corner: number,
		) => {
			const value = Math.min(corner, width / 2, height / 2);
			context.beginPath();
			context.moveTo(value, 0);
			context.lineTo(width - value, 0);
			context.quadraticCurveTo(width, 0, width, value);
			context.lineTo(width, height - value);
			context.quadraticCurveTo(width, height, width - value, height);
			context.lineTo(value, height);
			context.quadraticCurveTo(0, height, 0, height - value);
			context.lineTo(0, value);
			context.quadraticCurveTo(0, 0, value, 0);
			context.closePath();
		};

		const render = async () => {
			const current = ++job;
			setError(null);

			const code = input.value;
			if (code.trim() === '') {
				canvas.hidden = true;
				empty.hidden = false;
				downloadButton.disabled = true;
				hasImage = false;
				status.textContent = 'Tempel kode untuk melihat pratinjau.';
				size.textContent = '';
				return;
			}

			spinner.hidden = false;
			status.textContent = 'Membuat gambar…';

			try {
				const highlighted =
					language.value === 'plaintext'
						? escapeHtml(code)
						: hljs.highlight(code, { language: language.value, ignoreIllegals: true }).value;
				const lines = groupRunsByLine(parseHighlightHtml(highlighted));

				try {
					await document.fonts.load('500 16px "JetBrains Mono"');
					await document.fonts.ready;
				} catch {
					// Font sistem tetap dipakai kalau font khusus gagal dimuat.
				}

				const pad = clampPadding(Number(padding.value));
				const corner = clampRadius(Number(radius.value));
				const fontSize = 16;
				const lineHeight = 26;
				const palette = themePalette(theme);
				const font = `500 ${fontSize}px "JetBrains Mono", ui-monospace, monospace`;

				const measure = document.createElement('canvas').getContext('2d');
				if (!measure) throw new Error('Canvas tidak tersedia di peramban ini.');
				measure.font = font;

				let maxWidth = 0;
				for (const line of lines) {
					let width = 0;
					for (const run of line) width += measure.measureText(run.text).width;
					maxWidth = Math.max(maxWidth, width);
				}

				const width = Math.max(320, Math.ceil(maxWidth + pad * 2 + 2));
				const height = Math.max(160, lines.length * lineHeight + pad * 2);
				const scale = 2;

				canvas.width = width * scale;
				canvas.height = height * scale;
				const context = canvas.getContext('2d');
				if (!context) throw new Error('Canvas tidak tersedia di peramban ini.');

				context.scale(scale, scale);
				context.clearRect(0, 0, width, height);
				drawRoundedRect(context, width, height, corner);
				context.fillStyle = palette.background;
				context.fill();
				context.strokeStyle = palette.border;
				context.lineWidth = 1;
				context.stroke();

				context.font = font;
				context.textBaseline = 'middle';
				lines.forEach((line, index) => {
					let x = pad;
					const y = pad + index * lineHeight + lineHeight / 2;
					for (const run of line) {
						context.fillStyle = tokenColor(run.className, theme);
						context.fillText(run.text, x, y);
						x += context.measureText(run.text).width;
					}
				});

				if (current !== job) return;
				canvas.hidden = false;
				empty.hidden = true;
				downloadButton.disabled = false;
				hasImage = true;
				size.textContent = `${width * scale} × ${height * scale} px`;
				status.textContent = 'PNG siap diunduh';
			} catch (error) {
				if (current !== job) return;
				canvas.hidden = true;
				empty.hidden = false;
				downloadButton.disabled = true;
				hasImage = false;
				status.textContent = 'Gagal membuat gambar';
				setError(error instanceof Error ? error.message : 'Gagal membuat gambar.');
			} finally {
				if (current === job) spinner.hidden = true;
			}
		};

		const schedule = () => {
			window.clearTimeout(timer);
			timer = window.setTimeout(() => void render(), 220);
		};

		input.addEventListener('input', schedule);
		language.addEventListener('change', () => void render());

		themeButtons.forEach((button) => {
			button.addEventListener('click', () => {
				theme = button.dataset.ciTheme === 'dark' ? 'dark' : 'light';
				themeButtons.forEach((other) =>
					other.setAttribute('aria-pressed', other === button ? 'true' : 'false'),
				);
				void render();
			});
		});

		padding.addEventListener('input', () => {
			paddingLabel.textContent = `${clampPadding(Number(padding.value))} px`;
			schedule();
		});

		radius.addEventListener('input', () => {
			radiusLabel.textContent = `${clampRadius(Number(radius.value))} px`;
			schedule();
		});

		downloadButton.addEventListener('click', () => {
			if (!hasImage) return;
			canvas.toBlob((blob) => {
				if (!blob) {
					toast('Gagal membuat PNG.', { tone: 'error' });
					return;
				}
				const url = URL.createObjectURL(blob);
				const link = document.createElement('a');
				link.href = url;
				link.download = codeFileName(language.value);
				document.body.append(link);
				link.click();
				link.remove();
				setTimeout(() => URL.revokeObjectURL(url), 1000);
				toast('Gambar kode diunduh.', { tone: 'success' });
			}, 'image/png');
		});

		input.value = "const halo = 'dunia';\nconsole.log(halo);";
		void render();
	}
</script>

<style>
	.code-image-shell {
		padding: var(--space-4);
	}

	.ci-language {
		width: auto;
		min-width: 150px;
	}

	.ci-preview {
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: 320px;
		padding: var(--space-3);
		border: 1px dashed var(--border-strong);
		border-radius: var(--radius-md);
		background: var(--surface-2);
		overflow: auto;
	}

	.ci-preview canvas {
		max-width: 100%;
		height: auto;
		border-radius: var(--radius-sm);
	}

	.ci-preview canvas[hidden] {
		display: none;
	}

	.ci-status-row {
		display: flex;
		align-items: center;
		gap: var(--space-2);
	}

	.ci-status-row .field-hint {
		margin: 0;
	}
</style>
