---
import Dropzone from '../../components/ui/Dropzone.astro';
---

<div class="tool-shell kompres-shell">
	<Dropzone
		id="img-input"
		label="Pilih gambar"
		accept="image/jpeg,image/png,image/webp"
		hint="JPG, PNG, atau WebP, maks. 25 MB. Gambar tidak dikirim ke server."
	/>

	<div class="upload-preview" data-img-preview hidden>
		<span class="upload-preview__thumb">
			<img data-img-original alt="" />
		</span>
		<span class="upload-preview__info">
			<span class="upload-preview__name" data-img-name></span>
			<span class="upload-preview__status" data-img-status role="status" aria-live="polite"></span>
		</span>
	</div>

	<div class="pane-grid pane-grid--split" data-img-workspace hidden>
		<div class="pane">
			<div class="pane__head">
				<h2 class="pane__title">Pengaturan</h2>
			</div>

			<div class="form-grid">
				<div>
					<span class="field-label">Format hasil</span>
					<div class="segmented" role="radiogroup" aria-label="Format hasil">
						<button type="button" class="segmented__btn" role="radio" aria-checked="true" data-img-format="jpeg">
							JPG
						</button>
						<button type="button" class="segmented__btn" role="radio" aria-checked="false" data-img-format="webp">
							WebP
						</button>
						<button type="button" class="segmented__btn" role="radio" aria-checked="false" data-img-format="png">
							PNG
						</button>
					</div>
				</div>

				<div>
					<label class="field-label" for="img-quality">Kualitas</label>
					<input id="img-quality" type="range" min="40" max="100" step="5" value="80" />
					<p class="field-hint" id="img-quality-value">80%</p>
				</div>

				<div>
					<label class="field-label" for="img-max">Batas dimensi</label>
					<select class="field-input" id="img-max">
						<option value="0">Ikuti ukuran asli</option>
						<option value="1920" selected>Maks. 1920 px</option>
						<option value="1280">Maks. 1280 px</option>
						<option value="800">Maks. 800 px</option>
					</select>
					<p class="field-hint">Sisi terpanjang diperkecil. Gambar kecil tidak diperbesar.</p>
				</div>
			</div>

			<p class="field-hint">
				PNG mengabaikan kualitas dan biasanya paling besar. WebP paling kecil untuk foto.
			</p>

			<div class="pane-actions">
				<button type="button" class="btn btn--primary" id="img-download" disabled>
					Unduh hasil
				</button>
			</div>

			<div class="alert" id="img-error" role="alert" hidden>
				<p id="img-error-text"></p>
			</div>
		</div>

		<div class="pane">
			<div class="pane__head">
				<h2 class="pane__title">Hasil</h2>
				<span class="field-hint" id="img-state">Belum ada gambar</span>
			</div>

			<div class="img-result">
				<img id="img-preview" alt="Pratinjau hasil kompres" hidden />
				<p class="preview-empty" id="img-empty">Pilih gambar untuk melihat hasilnya.</p>
			</div>

			<dl class="img-stats" id="img-stats" hidden>
				<div>
					<dt>Ukuran</dt>
					<dd id="img-size"></dd>
				</div>
				<div>
					<dt>Dimensi</dt>
					<dd id="img-dims"></dd>
				</div>
				<div>
					<dt>Selisih</dt>
					<dd id="img-saving"></dd>
				</div>
			</dl>
		</div>
	</div>
</div>

<script>
	import { formatBytes } from '../../lib/page-range';
	import { dropzoneOf, setDropzoneState } from '../../lib/dropzone';
	import { toast } from '../../lib/toast';
	import {
		fitWithin,
		mimeFor,
		outputFileName,
		qualityFor,
		type OutputFormat,
	} from './image-ops';

	const input = document.getElementById('img-input') as HTMLInputElement | null;
	const preview = document.querySelector<HTMLElement>('[data-img-preview]');
	const original = document.querySelector<HTMLImageElement>('[data-img-original]');
	const previewName = document.querySelector<HTMLElement>('[data-img-name]');
	const previewStatus = document.querySelector<HTMLElement>('[data-img-status]');
	const workspace = document.querySelector<HTMLElement>('[data-img-workspace]');
	const quality = document.getElementById('img-quality') as HTMLInputElement | null;
	const qualityLabel = document.getElementById('img-quality-value');
	const maxSelect = document.getElementById('img-max') as HTMLSelectElement | null;
	const downloadButton = document.getElementById('img-download') as HTMLButtonElement | null;
	const resultImage = document.getElementById('img-preview') as HTMLImageElement | null;
	const empty = document.getElementById('img-empty');
	const stats = document.getElementById('img-stats');
	const sizeText = document.getElementById('img-size');
	const dimsText = document.getElementById('img-dims');
	const savingText = document.getElementById('img-saving');
	const stateText = document.getElementById('img-state');
	const errorBox = document.getElementById('img-error');
	const errorText = document.getElementById('img-error-text');

	if (
		input &&
		preview &&
		original &&
		previewName &&
		previewStatus &&
		workspace &&
		quality &&
		qualityLabel &&
		maxSelect &&
		downloadButton &&
		resultImage &&
		empty &&
		stats &&
		sizeText &&
		dimsText &&
		savingText &&
		stateText &&
		errorBox &&
		errorText
	) {
		let file: File | null = null;
		let bitmap: ImageBitmap | null = null;
		let originalUrl = '';
		let resultUrl = '';
		let resultBlob: Blob | null = null;
		let format: OutputFormat = 'jpeg';
		let timer: number | undefined;
		let job = 0;

		const setStatus = (message: string, loading: boolean) => {
			stateText.textContent = '';
			if (loading) {
				const spinner = document.createElement('span');
				spinner.className = 'spinner';
				spinner.setAttribute('aria-hidden', 'true');
				stateText.append(spinner);
			}
			stateText.append(document.createTextNode(message));
		};

		const setError = (message: string | null) => {
			errorBox.hidden = message === null;
			errorText.textContent = message ?? '';
		};

		const saveBlob = (blob: Blob, name: string) => {
			const url = URL.createObjectURL(blob);
			const link = document.createElement('a');
			link.href = url;
			link.download = name;
			document.body.append(link);
			link.click();
			link.remove();
			setTimeout(() => URL.revokeObjectURL(url), 1000);
		};

		const zone = dropzoneOf('img-input');

		const process = async () => {
			const source = bitmap;
			if (!source || !file) return;
			const current = ++job;
			setError(null);
			setStatus('Memproses…', true);
			setDropzoneState(zone, 'processing');

			try {
				const max = Number(maxSelect.value);
				const fitted = max > 0
					? fitWithin(source.width, source.height, max, max)
					: { width: source.width, height: source.height, scaled: false };

				const canvas = document.createElement('canvas');
				canvas.width = fitted.width;
				canvas.height = fitted.height;
				const context = canvas.getContext('2d');
				if (!context) throw new Error('Kanvas tidak tersedia di peramban ini.');

				if (format !== 'png') {
					context.fillStyle = '#ffffff';
					context.fillRect(0, 0, canvas.width, canvas.height);
				}
				context.imageSmoothingEnabled = true;
				context.imageSmoothingQuality = 'high';
				context.drawImage(source, 0, 0, canvas.width, canvas.height);

				const blob = await new Promise<Blob | null>((resolve) => {
					canvas.toBlob(
						resolve,
						mimeFor(format),
						qualityFor(format, Number(quality.value) / 100),
					);
				});
				if (current !== job) return;
				if (!blob) throw new Error('Gambar gagal dibuat dalam format ini.');

				resultBlob = blob;
				if (resultUrl) URL.revokeObjectURL(resultUrl);
				resultUrl = URL.createObjectURL(blob);
				resultImage.src = resultUrl;
				resultImage.hidden = false;
				empty.hidden = true;
				stats.hidden = false;

				sizeText.textContent = `${formatBytes(file.size)} → ${formatBytes(blob.size)}`;
				dimsText.textContent = fitted.scaled
					? `${fitted.width} × ${fitted.height} px (asli ${source.width} × ${source.height})`
					: `${fitted.width} × ${fitted.height} px`;
				const saving = Math.round((1 - blob.size / file.size) * 100);
				savingText.textContent =
					saving > 0 ? `${saving}% lebih kecil` : saving === 0 ? 'Ukurannya sama' : `${Math.abs(saving)}% lebih besar`;
				downloadButton.disabled = false;
				setStatus('Siap diunduh', false);
				setDropzoneState(zone, 'done');
			} catch (error) {
				if (current !== job) return;
				resultBlob = null;
				downloadButton.disabled = true;
				setStatus('Gagal memproses', false);
				setError(error instanceof Error ? error.message : 'Gagal memproses gambar.');
				setDropzoneState(zone, 'empty');
			}
		};

		const schedule = () => {
			window.clearTimeout(timer);
			timer = window.setTimeout(() => void process(), 180);
		};

		input.addEventListener('change', async (event) => {
			const selected = (event.target as HTMLInputElement).files?.[0] ?? null;
			input.value = '';
			if (!selected) return;

			if (!selected.type.startsWith('image/')) {
				setError('Berkas ini bukan gambar.');
				return;
			}
			if (selected.size > 25 * 1024 * 1024) {
				setError('Gambar lebih dari 25 MB. Kecilkan dulu atau pilih berkas lain.');
				return;
			}

			setError(null);
			file = selected;
			bitmap?.close();
			bitmap = null;
			resultBlob = null;
			downloadButton.disabled = true;
			stats.hidden = true;
			resultImage.hidden = true;
			empty.hidden = false;
			if (resultUrl) URL.revokeObjectURL(resultUrl);
			resultUrl = '';

			if (originalUrl) URL.revokeObjectURL(originalUrl);
			originalUrl = URL.createObjectURL(selected);
			original.src = originalUrl;
			previewName.textContent = `${selected.name} · ${formatBytes(selected.size)}`;
			preview.hidden = false;
			previewStatus.classList.remove('is-ready', 'is-failed');
			previewStatus.textContent = 'Membaca gambar…';
			workspace.hidden = false;
			setStatus('Menyiapkan…', true);

			try {
				bitmap = await createImageBitmap(selected);
				previewStatus.textContent = `Gambar siap · ${bitmap.width} × ${bitmap.height} px`;
				previewStatus.classList.add('is-ready');
				void process();
			} catch {
				previewStatus.textContent = 'Gagal membaca gambar.';
				previewStatus.classList.add('is-failed');
				setStatus('Gagal membaca', false);
				setError('Gambar tidak bisa dibaca. Coba JPG atau PNG lain.');
			}
		});

		document.querySelectorAll<HTMLButtonElement>('[data-img-format]').forEach((button) => {
			button.addEventListener('click', () => {
				format = (button.dataset.imgFormat as OutputFormat) ?? 'jpeg';
				document.querySelectorAll<HTMLButtonElement>('[data-img-format]').forEach((other) => {
					other.setAttribute('aria-checked', other === button ? 'true' : 'false');
				});
				void process();
			});
		});

		quality.addEventListener('input', () => {
			qualityLabel.textContent = `${quality.value}%`;
			schedule();
		});

		maxSelect.addEventListener('change', () => void process());

		downloadButton.addEventListener('click', () => {
			if (!resultBlob || !file) return;
			saveBlob(resultBlob, outputFileName(file.name, format));
			toast('Gambar diunduh.', { tone: 'success' });
		});
	}
</script>

<style>
	.kompres-shell {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
		padding: var(--space-4);
	}

	.upload-preview {
		display: grid;
		grid-template-columns: 64px minmax(0, 1fr);
		align-items: center;
		gap: var(--space-3);
		padding: var(--space-2) var(--space-3);
		border: 1px solid var(--border);
		border-radius: var(--radius-md);
		background: var(--surface);
	}

	.upload-preview[hidden] {
		display: none;
	}

	.upload-preview__thumb {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 64px;
		height: 64px;
		overflow: hidden;
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		background: var(--surface-2);
	}

	.upload-preview__thumb img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.upload-preview__info {
		display: flex;
		flex-direction: column;
		gap: 2px;
		min-width: 0;
	}

	.upload-preview__name {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		font-size: 0.9375rem;
	}

	.upload-preview__status {
		font-size: 0.8125rem;
		color: var(--text-muted);
	}

	.upload-preview__status.is-ready {
		color: var(--success);
	}

	.upload-preview__status.is-failed {
		color: var(--danger);
	}

	.img-result {
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: 320px;
		padding: var(--space-3);
		border: 1px dashed var(--border-strong);
		border-radius: var(--radius-md);
		background: var(--surface-2);
	}

	.img-result img {
		max-width: 100%;
		max-height: 420px;
		width: auto;
		height: auto;
		border-radius: var(--radius-sm);
	}

	.img-result img[hidden] {
		display: none;
	}

	.img-stats {
		display: grid;
		gap: var(--space-2);
		margin: 0;
	}

	.img-stats[hidden] {
		display: none;
	}

	.img-stats div {
		display: grid;
		grid-template-columns: 90px minmax(0, 1fr);
		gap: var(--space-2);
		padding: var(--space-2) var(--space-3);
		border: 1px solid var(--border);
		border-radius: var(--radius-md);
		background: var(--surface-2);
	}

	.img-stats dt {
		color: var(--text-muted);
		font-size: 0.875rem;
	}

	.img-stats dd {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 0.875rem;
	}

	#img-state {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		margin: 0;
	}
</style>
