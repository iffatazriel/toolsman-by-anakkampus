---
import dict from './i18n';
import Dropzone from '../../components/ui/Dropzone.astro';
---

<div class="tool-shell kompres-shell">
	<Dropzone
		id="img-input"
		label={dict.id.choose} labelKey="workspace.kompres-gambar.choose"
		accept="image/jpeg,image/png,image/webp"
		hint={dict.id.hint} hintKey="workspace.kompres-gambar.hint"
	/>

	<div class="upload-preview" data-img-preview hidden>
		<span class="upload-preview__thumb">
			<img data-img-original alt="" />
		</span>
		<span class="upload-preview__info">
			<span class="upload-preview__name" data-img-name></span>
			<span class="upload-preview__status" data-img-status role="status" aria-live="polite"></span>
		</span>
	</div>

	<div class="pane-grid pane-grid--split" data-img-workspace hidden>
		<div class="pane">
			<div class="pane__head">
				<h2 class="pane__title" data-i18n="workspace.kompres-gambar.settings">{dict.id.settings}</h2>
			</div>

			<div class="form-grid">
				<div>
					<span class="field-label" data-i18n="workspace.kompres-gambar.format">{dict.id.format}</span>
					<div class="segmented" role="radiogroup" aria-label={dict.id.format} data-i18n-aria="workspace.kompres-gambar.format">
						<button type="button" class="segmented__btn" role="radio" aria-checked="true" data-img-format="jpeg">
							JPG
						</button>
						<button type="button" class="segmented__btn" role="radio" aria-checked="false" data-img-format="webp">
							WebP
						</button>
						<button type="button" class="segmented__btn" role="radio" aria-checked="false" data-img-format="png">
							PNG
						</button>
					</div>
				</div>

				<div>
					<label class="field-label" for="img-quality" data-i18n="workspace.kompres-gambar.quality">{dict.id.quality}</label>
					<input id="img-quality" type="range" min="40" max="100" step="5" value="80" />
					<p class="field-hint" id="img-quality-value">80%</p>
				</div>

				<div>
					<label class="field-label" for="img-max" data-i18n="workspace.kompres-gambar.limit">{dict.id.limit}</label>
					<select class="field-input" id="img-max">
						<option value="0" data-i18n="workspace.kompres-gambar.original">{dict.id.original}</option>
						<option value="1920" selected data-i18n="workspace.kompres-gambar.max1920">{dict.id.max1920}</option>
						<option value="1280" data-i18n="workspace.kompres-gambar.max1280">{dict.id.max1280}</option>
						<option value="800" data-i18n="workspace.kompres-gambar.max800">{dict.id.max800}</option>
					</select>
					<p class="field-hint" data-i18n="workspace.kompres-gambar.resizeHint">{dict.id.resizeHint}</p>
				</div>
			</div>

			<p class="field-hint" data-i18n="workspace.kompres-gambar.formatHint">{dict.id.formatHint}</p>

			<div class="pane-actions">
				<button type="button" class="btn btn--primary" id="img-download" data-task-action disabled data-i18n="workspace.kompres-gambar.download">{dict.id.download}</button>
			</div>

			<div class="alert" id="img-error" role="alert" hidden>
				<p id="img-error-text"></p>
			</div>
		</div>

		<div class="pane">
			<div class="pane__head">
				<h2 class="pane__title" data-i18n="workspace.kompres-gambar.result">{dict.id.result}</h2>
				<span class="field-hint" id="img-state" data-i18n="workspace.kompres-gambar.initial">{dict.id.initial}</span>
			</div>

			<div class="img-result">
				<img id="img-preview" alt={dict.id.alt} data-i18n-alt="workspace.kompres-gambar.alt" hidden />
				<p class="preview-empty" id="img-empty" data-i18n="workspace.kompres-gambar.empty">{dict.id.empty}</p>
			</div>

			<dl class="img-stats" id="img-stats" hidden>
				<div>
					<dt data-i18n="workspace.kompres-gambar.size">{dict.id.size}</dt>
					<dd id="img-size"></dd>
				</div>
				<div>
					<dt data-i18n="workspace.kompres-gambar.dimensions">{dict.id.dimensions}</dt>
					<dd id="img-dims"></dd>
				</div>
				<div>
					<dt data-i18n="workspace.kompres-gambar.difference">{dict.id.difference}</dt>
					<dd id="img-saving"></dd>
				</div>
			</dl>
		</div>
	</div>
</div>

<script>
	import { formatBytes } from '../../lib/page-range';
	import { dropzoneOf, setDropzoneState } from '../../lib/dropzone';
	import { toast } from '../../lib/toast';
	import { tr } from '../../lib/i18n';
	import { localizedText } from '../../lib/i18n-client';
	import dict from './i18n';
	import {
		fitWithin,
		mimeFor,
		outputFileName,
		qualityFor,
		type OutputFormat,
	} from './image-ops';

	const input = document.getElementById('img-input') as HTMLInputElement | null;
	const preview = document.querySelector<HTMLElement>('[data-img-preview]');
	const original = document.querySelector<HTMLImageElement>('[data-img-original]');
	const previewName = document.querySelector<HTMLElement>('[data-img-name]');
	const previewStatus = document.querySelector<HTMLElement>('[data-img-status]');
	const workspace = document.querySelector<HTMLElement>('[data-img-workspace]');
	const quality = document.getElementById('img-quality') as HTMLInputElement | null;
	const qualityLabel = document.getElementById('img-quality-value');
	const maxSelect = document.getElementById('img-max') as HTMLSelectElement | null;
	const downloadButton = document.getElementById('img-download') as HTMLButtonElement | null;
	const resultImage = document.getElementById('img-preview') as HTMLImageElement | null;
	const empty = document.getElementById('img-empty');
	const stats = document.getElementById('img-stats');
	const sizeText = document.getElementById('img-size');
	const dimsText = document.getElementById('img-dims');
	const savingText = document.getElementById('img-saving');
	const stateText = document.getElementById('img-state');
	const errorBox = document.getElementById('img-error');
	const errorText = document.getElementById('img-error-text');

	if (
		input &&
		preview &&
		original &&
		previewName &&
		previewStatus &&
		workspace &&
		quality &&
		qualityLabel &&
		maxSelect &&
		downloadButton &&
		resultImage &&
		empty &&
		stats &&
		sizeText &&
		dimsText &&
		savingText &&
		stateText &&
		errorBox &&
		errorText
	) {
		let file: File | null = null;
		let bitmap: ImageBitmap | null = null;
		let originalUrl = '';
		let resultUrl = '';
		let resultBlob: Blob | null = null;
		let format: OutputFormat = 'jpeg';
		let timer: number | undefined;
		let job = 0;

		const setStatus = (message: () => string, loading: boolean) => {
			stateText.removeAttribute('data-i18n');
			stateText.textContent = '';
			if (loading) {
				const spinner = document.createElement('span');
				spinner.className = 'spinner';
				spinner.setAttribute('aria-hidden', 'true');
				stateText.append(spinner);
			}
			const text = document.createElement('span');
			localizedText(text, message);
			stateText.append(text);
		};

		const setError = (message: (() => string) | null) => {
			errorBox.hidden = message === null;
			localizedText(errorText, message ?? (() => ''));
		};

		const saveBlob = (blob: Blob, name: string) => {
			const url = URL.createObjectURL(blob);
			const link = document.createElement('a');
			link.href = url;
			link.download = name;
			document.body.append(link);
			link.click();
			link.remove();
			setTimeout(() => URL.revokeObjectURL(url), 1000);
		};

		const zone = dropzoneOf('img-input');

		const process = async () => {
			const source = bitmap;
			if (!source || !file) return;
			const current = ++job;
			setError(null);
			setStatus(() => tr(dict, 'processing'), true);
			let failureKey: keyof typeof dict.id = 'failed';
			setDropzoneState(zone, 'processing');

			try {
				const max = Number(maxSelect.value);
				const fitted = max > 0
					? fitWithin(source.width, source.height, max, max)
					: { width: source.width, height: source.height, scaled: false };

				const canvas = document.createElement('canvas');
				canvas.width = fitted.width;
				canvas.height = fitted.height;
				const context = canvas.getContext('2d');
				if (!context) { failureKey = 'canvasUnavailable'; throw new Error(); }

				if (format !== 'png') {
					context.fillStyle = '#ffffff';
					context.fillRect(0, 0, canvas.width, canvas.height);
				}
				context.imageSmoothingEnabled = true;
				context.imageSmoothingQuality = 'high';
				context.drawImage(source, 0, 0, canvas.width, canvas.height);

				const blob = await new Promise<Blob | null>((resolve) => {
					canvas.toBlob(
						resolve,
						mimeFor(format),
						qualityFor(format, Number(quality.value) / 100),
					);
				});
				if (current !== job) return;
				if (!blob) { failureKey = 'encodeFailed'; throw new Error(); }

				resultBlob = blob;
				if (resultUrl) URL.revokeObjectURL(resultUrl);
				resultUrl = URL.createObjectURL(blob);
				resultImage.src = resultUrl;
				resultImage.hidden = false;
				empty.hidden = true;
				stats.hidden = false;

				sizeText.textContent = `${formatBytes(file.size)} → ${formatBytes(blob.size)}`;
				localizedText(dimsText, () => fitted.scaled ? tr(dict, 'scaled', { width: fitted.width, height: fitted.height, originalWidth: source.width, originalHeight: source.height }) : `${fitted.width} × ${fitted.height} px`);
				const saving = Math.round((1 - blob.size / file.size) * 100);
				localizedText(savingText, () => tr(dict, saving > 0 ? 'smaller' : saving === 0 ? 'same' : 'larger', { n: Math.abs(saving) }));
				downloadButton.disabled = false;
				setStatus(() => tr(dict, 'ready'), false);
				setDropzoneState(zone, 'done');
			} catch {
				if (current !== job) return;
				resultBlob = null;
				downloadButton.disabled = true;
				setStatus(() => tr(dict, 'processingFailed'), false);
				setError(() => tr(dict, failureKey));
				setDropzoneState(zone, 'empty');
			}
		};

		const schedule = () => {
			window.clearTimeout(timer);
			timer = window.setTimeout(() => void process(), 180);
		};

		input.addEventListener('change', async (event) => {
			const selected = (event.target as HTMLInputElement).files?.[0] ?? null;
			input.value = '';
			if (!selected) return;

			if (!selected.type.startsWith('image/')) {
				setError(() => tr(dict, 'notImage'));
				return;
			}
			if (selected.size > 25 * 1024 * 1024) {
				setError(() => tr(dict, 'tooLarge'));
				return;
			}

			setError(null);
			file = selected;
			bitmap?.close();
			bitmap = null;
			resultBlob = null;
			downloadButton.disabled = true;
			stats.hidden = true;
			resultImage.hidden = true;
			empty.hidden = false;
			if (resultUrl) URL.revokeObjectURL(resultUrl);
			resultUrl = '';

			if (originalUrl) URL.revokeObjectURL(originalUrl);
			originalUrl = URL.createObjectURL(selected);
			original.src = originalUrl;
			previewName.textContent = `${selected.name} · ${formatBytes(selected.size)}`;
			preview.hidden = false;
			previewStatus.classList.remove('is-ready', 'is-failed');
			localizedText(previewStatus, () => tr(dict, 'reading'));
			workspace.hidden = false;
			setStatus(() => tr(dict, 'preparing'), true);

			try {
				bitmap = await createImageBitmap(selected);
				const { width, height } = bitmap;
				localizedText(previewStatus, () => tr(dict, 'imageReady', { width, height }));
				previewStatus.classList.add('is-ready');
				void process();
			} catch {
				localizedText(previewStatus, () => tr(dict, 'readFailed'));
				previewStatus.classList.add('is-failed');
				setStatus(() => tr(dict, 'readingFailed'), false);
				setError(() => tr(dict, 'cannotRead'));
			}
		});

		document.querySelectorAll<HTMLButtonElement>('[data-img-format]').forEach((button) => {
			button.addEventListener('click', () => {
				format = (button.dataset.imgFormat as OutputFormat) ?? 'jpeg';
				document.querySelectorAll<HTMLButtonElement>('[data-img-format]').forEach((other) => {
					other.setAttribute('aria-checked', other === button ? 'true' : 'false');
				});
				void process();
			});
		});

		quality.addEventListener('input', () => {
			qualityLabel.textContent = `${quality.value}%`;
			schedule();
		});

		maxSelect.addEventListener('change', () => void process());

		downloadButton.addEventListener('click', () => {
			if (!resultBlob || !file) return;
			saveBlob(resultBlob, outputFileName(file.name, format));
			toast(() => tr(dict, 'downloaded'), { tone: 'success' });
		});
	}
</script>

<style>
	.kompres-shell {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
		padding: var(--space-4);
	}

	.upload-preview {
		display: grid;
		grid-template-columns: 64px minmax(0, 1fr);
		align-items: center;
		gap: var(--space-3);
		padding: var(--space-2) var(--space-3);
		border: 1px solid var(--border);
		border-radius: var(--radius-md);
		background: var(--surface);
	}

	.upload-preview[hidden] {
		display: none;
	}

	.upload-preview__thumb {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 64px;
		height: 64px;
		overflow: hidden;
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		background: var(--surface-2);
	}

	.upload-preview__thumb img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.upload-preview__info {
		display: flex;
		flex-direction: column;
		gap: 2px;
		min-width: 0;
	}

	.upload-preview__name {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		font-size: 0.9375rem;
	}

	.upload-preview__status {
		font-size: 0.8125rem;
		color: var(--text-muted);
	}

	.upload-preview__status.is-ready {
		color: light-dark(#187a4c, #3dbe86);
	}

	.upload-preview__status.is-failed {
		color: var(--danger);
	}

	.img-result {
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: 320px;
		padding: var(--space-3);
		border: 1px dashed var(--border-strong);
		border-radius: var(--radius-md);
		background: var(--surface-2);
	}

	.img-result img {
		max-width: 100%;
		max-height: 420px;
		width: auto;
		height: auto;
		border-radius: var(--radius-sm);
	}

	.img-result img[hidden] {
		display: none;
	}

	.img-stats {
		display: grid;
		gap: var(--space-2);
		margin: 0;
	}

	.img-stats[hidden] {
		display: none;
	}

	.img-stats div {
		display: grid;
		grid-template-columns: 90px minmax(0, 1fr);
		gap: var(--space-2);
		padding: var(--space-2) var(--space-3);
		border: 1px solid var(--border);
		border-radius: var(--radius-md);
		background: var(--surface-2);
	}

	.img-stats dt {
		color: var(--text-muted);
		font-size: 0.875rem;
	}

	.img-stats dd {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 0.875rem;
	}

	#img-state {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		margin: 0;
	}
</style>
