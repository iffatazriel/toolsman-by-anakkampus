---
import dict from './i18n';
---
<div class="tool-shell diagram-shell">
	<div class="diagram-render-host" aria-hidden="true" inert></div>
	<div class="share-banner" data-share-banner hidden>
		<p data-i18n="workspace.diagram.readOnly">{dict.id.readOnly}</p>
		<button type="button" class="btn btn--secondary" data-share-edit data-i18n="workspace.diagram.draft">{dict.id.draft}</button>
	</div>

	<div class="diagram-bar">
		<label class="field-label" for="diagram-template">Template</label>
		<select id="diagram-template" class="field-input diagram-select">
			<option value="" data-i18n="workspace.diagram.chooseTemplate">{dict.id.chooseTemplate}</option>
			<option value="flowchart">Flowchart</option>
			<option value="sequence">Sequence</option>
			<option value="erd">ERD</option>
			<option value="class">Class</option>
			<option value="gantt">Gantt</option>
			<option value="state">State</option>
		</select>
		<div class="pane-actions">
			<button type="button" class="btn btn--secondary" id="diagram-copy" data-i18n="workspace.diagram.copyCode">{dict.id.copyCode}</button>
			<button type="button" class="btn btn--secondary" id="diagram-png" disabled data-i18n="workspace.diagram.downloadPng">{dict.id.downloadPng}</button>
			<button type="button" class="btn btn--secondary" id="diagram-svg" disabled data-i18n="workspace.diagram.downloadSvg">{dict.id.downloadSvg}</button>
			<button type="button" class="btn btn--secondary" id="diagram-share" data-i18n="workspace.diagram.share">{dict.id.share}</button>
			<button
				type="button"
				class="btn btn--ghost"
				id="diagram-drawio"
				aria-haspopup="dialog"
			 data-i18n="workspace.diagram.visual">{dict.id.visual}</button>
		</div>
	</div>

	<div class="share-link-box" data-share-result hidden>
		<label class="sr-only" for="diagram-share-url" data-i18n="workspace.diagram.readOnlyLink">{dict.id.readOnlyLink}</label>
		<input class="field-input" id="diagram-share-url" readonly />
		<button type="button" class="btn btn--secondary" id="diagram-share-copy" data-i18n="workspace.diagram.copyLink">{dict.id.copyLink}</button>
	</div>

	<dialog
		id="diagram-drawio-dialog"
		class="modal drawio-modal"
		aria-labelledby="drawio-title"
	>
		<div class="drawio-head">
			<h2 class="pane__title" id="drawio-title">Editor draw.io</h2>
			<button type="button" class="btn btn--ghost" id="drawio-close" data-i18n="workspace.diagram.close">{dict.id.close}</button>
		</div>
		<p class="field-hint drawio-note" data-i18n="workspace.diagram.externalNote">{dict.id.externalNote}</p>
		<div class="drawio-frame-wrap">
			<iframe
				id="drawio-frame"
				title="Editor diagrams.net"
				loading="lazy"
				allow="clipboard-read; clipboard-write"
			></iframe>
		</div>
		<div class="drawio-foot">
			<a
				class="btn btn--secondary"
				href="https://app.diagrams.net/"
				target="_blank"
				rel="noopener noreferrer"
			><span data-i18n="workspace.diagram.newTab">{dict.id.newTab}</span><span class="sr-only" data-i18n="workspace.diagram.opensTab">{dict.id.opensTab}</span>
			</a>
		</div>
	</dialog>

	<div class="segmented diagram-mobile-tabs" role="tablist" aria-label={dict.id.panels} data-i18n-aria="workspace.diagram.panels">
		<button
			type="button"
			class="segmented__btn"
			role="tab"
			id="diagram-tab-code"
			aria-controls="diagram-pane-code"
			aria-selected="true"
			tabindex="0"
			data-diagram-tab="code"
		 data-i18n="workspace.diagram.code">{dict.id.code}</button>
		<button
			type="button"
			class="segmented__btn"
			role="tab"
			id="diagram-tab-preview"
			aria-controls="diagram-pane-preview"
			aria-selected="false"
			tabindex="-1"
			data-diagram-tab="preview"
		 data-i18n="workspace.diagram.preview">{dict.id.preview}</button>
	</div>

	<div class="diagram-split" id="diagram-split">
		<div class="pane" id="diagram-pane-code" data-diagram-pane="code">
			<div class="pane__head">
				<h2 class="pane__title" id="diagram-editor-title" data-i18n="workspace.diagram.code">{dict.id.code}</h2>
				<p class="field-hint" id="diagram-status" aria-live="polite" data-i18n="workspace.diagram.saved">{dict.id.saved}</p>
			</div>
			<label class="sr-only" for="diagram-input" data-i18n="workspace.diagram.mermaidCode">{dict.id.mermaidCode}</label>
			<textarea
				id="diagram-input"
				class="code-area"
				spellcheck="false"
				aria-labelledby="diagram-editor-title"
				aria-describedby="diagram-error"
			></textarea>
			<div class="alert" id="diagram-error" role="alert" hidden>
				<p id="diagram-error-text"></p>
			</div>
		</div>

		<div class="pane" id="diagram-pane-preview" data-diagram-pane="preview">
			<div class="pane__head">
				<h2 class="pane__title" data-i18n="workspace.diagram.preview">{dict.id.preview}</h2>
			</div>
			<div class="diagram-zoom" role="group" aria-label={dict.id.zoomControls} data-i18n-aria="workspace.diagram.zoomControls">
				<button class="btn btn--secondary" type="button" data-diagram-zoom="fit" data-i18n="workspace.diagram.fit">{dict.id.fit}</button>
				<button class="btn btn--secondary" type="button" data-diagram-zoom="out" aria-label={dict.id.zoomOut} data-i18n-aria="workspace.diagram.zoomOut">−</button>
				<output id="diagram-zoom-level" aria-live="polite">100%</output>
				<button class="btn btn--secondary" type="button" data-diagram-zoom="in" aria-label={dict.id.zoomIn} data-i18n-aria="workspace.diagram.zoomIn">+</button>
				<button class="btn btn--secondary" type="button" data-diagram-zoom="reset" aria-label={dict.id.actualSize} data-i18n-aria="workspace.diagram.actualSize">100%</button>
			</div>
			<div class="diagram-loading" id="diagram-loading" hidden>
				<span class="spinner" aria-hidden="true"></span><span data-i18n="workspace.diagram.loading">{dict.id.loading}</span></div>
			<div class="preview diagram-preview" id="diagram-preview" tabindex="0" role="region" aria-label={dict.id.preview} data-i18n-aria="workspace.diagram.preview" aria-live="polite"></div>
		</div>
	</div>
</div>

<script>
 import {tr,currentLang} from "../../lib/i18n";
 import {localizedText} from "../../lib/i18n-client";
 import dict from "./i18n";
	import { toast } from '../../lib/toast';
	import { copyText } from '../../lib/clipboard';
	import { downloadText } from '../../lib/download';
	import {
		buildSessionUrl,
		decodeSession,
		encodeSession,
		sessionTokenFromHash,
		SessionTooLargeError,
	} from '../../lib/share-session';
	import { getTemplate } from './templates';
	import { extractLineFromMermaidError } from './error-line';
	import { diagramScale } from './zoom';

	const STORAGE_KEY = 'toolsman-diagram-draft';
	const isDark = () => {
		const forced = document.documentElement.dataset.theme;
		if (forced === 'dark' || forced === 'light') return forced === 'dark';
		return matchMedia('(prefers-color-scheme: dark)').matches;
	};
	const DEFAULT_CODE = 'flowchart TD\n  A[Mulai] --> B[Selesai]';

	const input = document.getElementById('diagram-input') as HTMLTextAreaElement | null;
	const preview = document.getElementById('diagram-preview');
	const select = document.getElementById('diagram-template') as HTMLSelectElement | null;
	const status = document.getElementById('diagram-status');
	const errorBox = document.getElementById('diagram-error');
	const errorText = document.getElementById('diagram-error-text');
	const copyButton = document.getElementById('diagram-copy');
	const pngButton = document.getElementById('diagram-png') as HTMLButtonElement | null;
	const svgButton = document.getElementById('diagram-svg') as HTMLButtonElement | null;
	const loadingBox = document.getElementById('diagram-loading');

	if (input && preview && select && status && errorBox && errorText && copyButton && pngButton && svgButton) {
		let mermaidPromise: Promise<typeof import('mermaid').default> | null = null;
		let svgText = '';
		let renderId = 0;
		let saveTimer: number | undefined;
		let zoom = 1;
		let fitting = true;
		const availableWidth = () => {
			const style = getComputedStyle(preview);
			return preview.clientWidth - parseFloat(style.paddingLeft) - parseFloat(style.paddingRight);
		};
		const renderHost = document.querySelector<HTMLElement>('.diagram-render-host')!;
		const zoomButtons = document.querySelectorAll<HTMLButtonElement>('[data-diagram-zoom]');
		const setZoom = (value: number) => {
			const svg = preview.querySelector('svg');
			if (!svg) return;
			zoom = value;
			const box = svg.viewBox.baseVal;
			svg.style.maxWidth = 'none';
			svg.style.width = `${box.width * zoom}px`;
			svg.style.height = `${box.height * zoom}px`;
			document.getElementById('diagram-zoom-level')!.textContent = `${Math.round(zoom * 100)}%`;
		};
		const fitPreview = () => {
			const svg = preview.querySelector('svg');
			if (fitting && svg && preview.clientWidth > 0) {
				setZoom(diagramScale('fit', zoom, availableWidth(), svg.viewBox.baseVal.width));
			}
		};
		new ResizeObserver(fitPreview).observe(preview);
		zoomButtons.forEach(button => {
			button.disabled = true;
			button.addEventListener('click', () => {
				const svg = preview.querySelector('svg');
				fitting = button.dataset.diagramZoom === 'fit';
				if (svg) setZoom(diagramScale(button.dataset.diagramZoom!, zoom, availableWidth(), svg.viewBox.baseVal.width));
			});
		});

		const loadMermaid = () => {
			mermaidPromise ??= import('mermaid').then((module) => {
				module.default.initialize({
					startOnLoad: false,
					securityLevel: 'strict',
					theme: isDark() ? 'dark' : 'default',
					themeVariables: isDark() ? { edgeLabelBackground: '#252320' } : {},
				});
				return module.default;
			});
			return mermaidPromise;
		};

		const setError = (message: (()=>string) | null, line?: number) => {
			if (message === null) {
				errorBox.hidden = true;
				localizedText(errorText,()=> '');
				input.removeAttribute('aria-invalid');
				return;
			}
			errorBox.hidden = false;
			localizedText(errorText,()=>line?tr(dict,'position',{line,message:message!()}):message!());
			input.setAttribute('aria-invalid', 'true');
		};

		const setButtons = (enabled: boolean) => {
			pngButton.disabled = !enabled;
			svgButton.disabled = !enabled;
			zoomButtons.forEach(button => { button.disabled = !enabled; });
		};

		const render = async () => {
			const code = input.value;
			const current = ++renderId;

			if (code.trim() === '') {
				preview.innerHTML = '';
				setError(null);
				setButtons(false);
				if (loadingBox) loadingBox.hidden = true;
				return;
			}

			if (loadingBox) loadingBox.hidden = false;

			try {
				const mermaid = await loadMermaid();
				await mermaid.parse(code);
				const { svg } = await mermaid.render(`diagram-${current}`, code, renderHost);
				if (current !== renderId) return;
				svgText = svg;
				preview.innerHTML = svg;
				const width = preview.querySelector('svg')!.viewBox.baseVal.width;
				fitting = true;
				setZoom(diagramScale('fit', 1, availableWidth(), width));
				setError(null);
				setButtons(true);
			} catch (error) {
				if (current !== renderId) return;
				const issue = extractLineFromMermaidError(error,code,currentLang());
 setError(()=>extractLineFromMermaidError(error,code,currentLang()).message,issue.line);
				setButtons(false);
			} finally {
				if (current === renderId && loadingBox) loadingBox.hidden = true;
			}
		};

		const save = () => {
			localizedText(status,()=>tr(dict,'saving'));
			window.clearTimeout(saveTimer);
			saveTimer = window.setTimeout(() => {
				try {
					localStorage.setItem(STORAGE_KEY, input.value);
					localizedText(status,()=>tr(dict,'saved'));
				} catch {
					localizedText(status,()=>tr(dict,'saveFailed'));
				}
			}, 400);
		};

		input.addEventListener('input', () => {
			select.value = '';
			save();
			void render();
		});

		select.addEventListener('change', () => {
			const template = getTemplate(select.value);
			if (!template) return;
			input.value = template.code;
			save();
			void render();
			input.focus();
		});

		copyButton.addEventListener('click', async () => {
			const copied = await copyText(input.value);
			toast(()=> copied ? tr(dict,'copied') : tr(dict,'copyFailed'), { tone: copied ? 'success' : 'error' });
		});

		const download = (name: string, blob: Blob) => {
			const url = URL.createObjectURL(blob);
			const link = document.createElement('a');
			link.href = url;
			link.download = name;
			document.body.append(link);
			link.click();
			link.remove();
			setTimeout(() => URL.revokeObjectURL(url), 1000);
		};

		svgButton.addEventListener('click', () => {
			if (!svgText) return;
			download('diagram.svg', new Blob([svgText], { type: 'image/svg+xml' }));
		});

		pngButton.addEventListener('click', async () => {
			if (!svgText) return;
			const svgEl = new DOMParser().parseFromString(svgText, 'image/svg+xml').documentElement as unknown as SVGSVGElement;
			const box = svgEl.viewBox.baseVal;
			const width = Math.max(1, Math.round(box.width));
			const height = Math.max(1, Math.round(box.height));
			svgEl.setAttribute('width', String(width));
			svgEl.setAttribute('height', String(height));
			const image = new Image();
			const url = URL.createObjectURL(new Blob([new XMLSerializer().serializeToString(svgEl)], { type: 'image/svg+xml;charset=utf-8' }));
			image.src = url;
			await image.decode();
			const canvas = document.createElement('canvas');
			canvas.width = width * 2;
			canvas.height = height * 2;
			const context = canvas.getContext('2d');
			if (!context) return;
			context.fillStyle = '#ffffff';
			context.fillRect(0, 0, canvas.width, canvas.height);
			context.drawImage(image, 0, 0, canvas.width, canvas.height);
			URL.revokeObjectURL(url);
			canvas.toBlob((blob) => {
				if (blob) download('diagram.png', blob);
			}, 'image/png');
		});

		const shareBanner = document.querySelector<HTMLElement>('[data-share-banner]');
		const shareEdit = document.querySelector<HTMLButtonElement>('[data-share-edit]');
		const shareButton = document.querySelector<HTMLButtonElement>('#diagram-share');
		const shareResult = document.querySelector<HTMLElement>('[data-share-result]');
		const shareUrl = document.querySelector<HTMLInputElement>('#diagram-share-url');
		const shareCopy = document.querySelector<HTMLButtonElement>('#diagram-share-copy');

		const loadShared = async () => {
			const token = sessionTokenFromHash(location.hash);
			if (!token) return;

			try {
				const payload = (await decodeSession(token)) as {
					v?: number;
					type?: string;
					code?: string;
				};
				if (payload?.v !== 1 || payload.type !== 'diagram' || typeof payload.code !== 'string') {
					throw new Error(tr(dict,'sessionUnknown'));
				}

				input.value = payload.code;
				input.readOnly = true;
				select.disabled = true;
				if (shareBanner) shareBanner.hidden = false;
				localizedText(status,()=>tr(dict,'fromLink'));
				await render();
			} catch (error) {
				if (shareBanner) shareBanner.hidden = true;
				localizedText(status,()=>error instanceof Error && error.message.includes('terlalu panjang')
						? tr(dict,'truncatedStatus')
						: tr(dict,'invalidStatus'));
				toast(()=> error instanceof Error && error.message.includes('terlalu panjang')
						? tr(dict,'truncated')
						: tr(dict,'invalid'),
					{ tone: 'error' },
				);
			}
		};

		shareEdit?.addEventListener('click', () => {
			input.readOnly = false;
			select.disabled = false;
			if (shareBanner) shareBanner.hidden = true;
			history.replaceState(null, '', location.pathname);
			save();
			localizedText(status,()=>tr(dict,'saved'));
			toast(()=> tr(dict,'draftOpened'), { tone: 'success' });
			input.focus();
		});

		shareButton?.addEventListener('click', async () => {
			try {
				const token = await encodeSession({ v: 1, type: 'diagram', code: input.value });
				const url = buildSessionUrl(`${location.origin}/tools/diagram/`, token);
				if (shareUrl && shareResult) {
					shareUrl.value = url;
					shareResult.hidden = false;
				}
				const copied = await copyText(url);
				toast(()=> copied
						? tr(dict,'linkCopiedCount',{count:url.length})
						: tr(dict,'linkCreated',{count:url.length}),
					{ tone: copied ? 'success' : 'neutral' },
				);
			} catch (error) {
				if (shareResult) shareResult.hidden = true;
				if (error instanceof SessionTooLargeError) {
					toast(()=> tr(dict,'tooLong',{length:error.length,limit:error.limit}),
						{ tone: 'error' },
					);
					return;
				}
				toast(()=> tr(dict,'linkFailed'), { tone: 'error' });
			}
		});

		shareCopy?.addEventListener('click', async () => {
			if (!shareUrl) return;
			const copied = await copyText(shareUrl.value);
			toast(()=> copied ? tr(dict,'linkCopied') : tr(dict,'linkCopyFailed'), { tone: copied ? 'success' : 'error' });
		});

		const saved = localStorage.getItem(STORAGE_KEY);
		input.value = saved && saved.trim() !== '' ? saved : DEFAULT_CODE;
		localizedText(status,()=>tr(dict,'saved'));
		void render();
		void loadShared();
	}

	const mobileTabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-diagram-tab]'));
	const mobilePanes = Array.from(document.querySelectorAll<HTMLElement>('[data-diagram-pane]'));
	const mobileTablist = document.querySelector<HTMLElement>('.diagram-mobile-tabs');

	const selectMobilePane = (name: string, focus = false) => {
		mobileTabs.forEach((tab) => {
			const active = tab.dataset.diagramTab === name;
			tab.setAttribute('aria-selected', active ? 'true' : 'false');
			tab.tabIndex = active ? 0 : -1;
			if (active && focus) tab.focus();
		});
		mobilePanes.forEach((pane) => {
			pane.dataset.mobileActive = pane.dataset.diagramPane === name ? 'true' : 'false';
		});
	};

	mobileTabs.forEach((tab) => {
		tab.addEventListener('click', () => {
			selectMobilePane(tab.dataset.diagramTab ?? 'code');
		});
	});

	mobileTablist?.addEventListener('keydown', (event) => {
		if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return;
		const current = mobileTabs.findIndex((tab) => tab === document.activeElement);
		if (current === -1) return;
		event.preventDefault();
		const step = event.key === 'ArrowRight' ? 1 : -1;
		const next = mobileTabs[(current + step + mobileTabs.length) % mobileTabs.length];
		if (next?.dataset.diagramTab) selectMobilePane(next.dataset.diagramTab, true);
	});

	selectMobilePane('code');

	const DRAWIO_ORIGIN = 'https://embed.diagrams.net';
	const drawioButton = document.getElementById('diagram-drawio');
	const drawioDialog = document.getElementById('diagram-drawio-dialog') as HTMLDialogElement | null;
	const drawioFrame = document.getElementById('drawio-frame') as HTMLIFrameElement | null;
	const drawioClose = document.getElementById('drawio-close');

	const openDrawio = () => {
		if (!drawioDialog || !drawioFrame || drawioDialog.open) return;
		if (drawioFrame.dataset.loaded !== 'true') {
			drawioFrame.src = `${DRAWIO_ORIGIN}/?embed=1&proto=json&spin=1&ui=min&libraries=1&saveAndExit=1`;
			drawioFrame.dataset.loaded = 'true';
		}
		drawioDialog.showModal();
	};

	drawioButton?.addEventListener('click', openDrawio);
	drawioClose?.addEventListener('click', () => drawioDialog?.close());

	window.addEventListener('message', (event) => {
		if (event.origin !== DRAWIO_ORIGIN) return;
		const frameWindow = drawioFrame?.contentWindow;
		if (!frameWindow) return;

		let message: { event?: string; xml?: string; exit?: boolean } | null = null;
		try {
			message =
				typeof event.data === 'string' ? JSON.parse(event.data) : (event.data as typeof message);
		} catch {
			return;
		}
		if (!message) return;

		if (message.event === 'init') {
			frameWindow.postMessage(
				JSON.stringify({ action: 'load', xml: '', autosave: 0 }),
				DRAWIO_ORIGIN,
			);
		}

		if (message.event === 'save') {
			if (message.xml) {
				downloadText('diagram.drawio', message.xml, 'application/xml;charset=utf-8');
				toast(()=> tr(dict,'drawioDownloaded'), { tone: 'success' });
			}
			if (message.exit) drawioDialog?.close();
		}

		if (message.event === 'exit') drawioDialog?.close();
	});
</script>

<style>
	.diagram-bar {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		gap: var(--space-3);
		padding: var(--space-3) var(--space-4);
		border-bottom: 1px solid var(--border);
	}

	.diagram-select {
		width: auto;
		min-width: 200px;
	}

	.share-banner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-3);
		padding: var(--space-2) var(--space-3);
		border-bottom: 1px solid var(--border);
		background: var(--accent-soft);
		font-size: 0.875rem;
	}

	.share-banner[hidden] {
		display: none;
	}

	.share-link-box {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		padding: var(--space-3) var(--space-4);
		border-bottom: 1px solid var(--border);
	}

	.share-link-box[hidden] {
		display: none;
	}

	.share-link-box .field-input {
		flex: 1 1 240px;
		font-family: var(--font-mono);
		font-size: 0.8125rem;
	}

	.diagram-mobile-tabs {
		display: none;
		margin: var(--space-3) var(--space-4) 0;
	}

	@media (max-width: 767px) {
		.diagram-mobile-tabs {
			display: inline-flex;
		}

		.diagram-split {
			padding-top: var(--space-3);
		}

		.diagram-split .pane[data-diagram-pane]:not([data-mobile-active='true']) {
			display: none;
		}
	}

	.diagram-split {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: var(--space-4);
		padding: var(--space-4);
	}

	@media (min-width: 900px) {
		.diagram-split {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		}
	}

	.diagram-preview {
