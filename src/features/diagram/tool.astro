<div class="tool-shell diagram-shell">
	<div class="share-banner" data-share-banner hidden>
		<p>Diagram ini dibuka dari link dan hanya-baca.</p>
		<button type="button" class="btn btn--secondary" data-share-edit>Buka sebagai draf</button>
	</div>

	<div class="diagram-bar">
		<label class="field-label" for="diagram-template">Template</label>
		<select id="diagram-template" class="field-input diagram-select">
			<option value="">Pilih template…</option>
			<option value="flowchart">Flowchart</option>
			<option value="sequence">Sequence</option>
			<option value="erd">ERD</option>
			<option value="class">Class</option>
			<option value="gantt">Gantt</option>
			<option value="state">State</option>
		</select>
		<div class="pane-actions">
			<button type="button" class="btn btn--secondary" id="diagram-copy">Salin kode</button>
			<button type="button" class="btn btn--secondary" id="diagram-png" disabled>Unduh PNG</button>
			<button type="button" class="btn btn--secondary" id="diagram-svg" disabled>Unduh SVG</button>
			<button type="button" class="btn btn--secondary" id="diagram-share">Bagikan</button>
			<button
				type="button"
				class="btn btn--ghost"
				id="diagram-drawio"
				aria-haspopup="dialog"
			>
				Editor Visual (draw.io)
			</button>
		</div>
	</div>

	<div class="share-link-box" data-share-result hidden>
		<label class="sr-only" for="diagram-share-url">Link hanya-baca</label>
		<input class="field-input" id="diagram-share-url" readonly />
		<button type="button" class="btn btn--secondary" id="diagram-share-copy">Salin link</button>
	</div>

	<dialog
		id="diagram-drawio-dialog"
		class="modal drawio-modal"
		aria-labelledby="drawio-title"
	>
		<div class="drawio-head">
			<h2 class="pane__title" id="drawio-title">Editor draw.io</h2>
			<button type="button" class="btn btn--ghost" id="drawio-close">Tutup</button>
		</div>
		<p class="field-hint drawio-note">
			Editor diagrams.net dimuat dari situs mereka. Tekan Save &amp; Exit untuk mengunduh
			berkas <code>.drawio</code> ke perangkatmu. Diagram di sini tidak otomatis masuk ke
			Toolsman.
		</p>
		<div class="drawio-frame-wrap">
			<iframe
				id="drawio-frame"
				title="Editor diagrams.net"
				loading="lazy"
				allow="clipboard-read; clipboard-write"
			></iframe>
		</div>
		<div class="drawio-foot">
			<a
				class="btn btn--secondary"
				href="https://app.diagrams.net/"
				target="_blank"
				rel="noopener noreferrer"
			>
				Buka di tab baru
				<span class="sr-only">(membuka tab baru)</span>
			</a>
		</div>
	</dialog>

	<div class="segmented diagram-mobile-tabs" role="tablist" aria-label="Panel diagram">
		<button
			type="button"
			class="segmented__btn"
			role="tab"
			id="diagram-tab-code"
			aria-controls="diagram-pane-code"
			aria-selected="true"
			tabindex="0"
			data-diagram-tab="code"
		>
			Kode
		</button>
		<button
			type="button"
			class="segmented__btn"
			role="tab"
			id="diagram-tab-preview"
			aria-controls="diagram-pane-preview"
			aria-selected="false"
			tabindex="-1"
			data-diagram-tab="preview"
		>
			Pratinjau
		</button>
	</div>

	<div class="diagram-split" id="diagram-split">
		<div class="pane" id="diagram-pane-code" data-diagram-pane="code">
			<div class="pane__head">
				<h2 class="pane__title" id="diagram-editor-title">Kode</h2>
				<p class="field-hint" id="diagram-status" aria-live="polite">Tersimpan otomatis</p>
			</div>
			<label class="sr-only" for="diagram-input">Kode Mermaid</label>
			<textarea
				id="diagram-input"
				class="code-area"
				spellcheck="false"
				aria-labelledby="diagram-editor-title"
				aria-describedby="diagram-error"
			></textarea>
			<div class="alert" id="diagram-error" role="alert" hidden>
				<p id="diagram-error-text"></p>
			</div>
		</div>

		<div class="pane" id="diagram-pane-preview" data-diagram-pane="preview">
			<div class="pane__head">
				<h2 class="pane__title">Pratinjau</h2>
			</div>
			<div class="diagram-loading" id="diagram-loading" hidden>
				<span class="spinner" aria-hidden="true"></span>
				Memuat diagram…
			</div>
			<div class="preview diagram-preview" id="diagram-preview" aria-live="polite"></div>
		</div>
	</div>
</div>

<script>
	import { toast } from '../../lib/toast';
	import { copyText } from '../../lib/clipboard';
	import { downloadText } from '../../lib/download';
	import {
		buildSessionUrl,
		decodeSession,
		encodeSession,
		sessionTokenFromHash,
		SessionTooLargeError,
	} from '../../lib/share-session';
	import { getTemplate } from './templates';
	import { extractLineFromMermaidError } from './error-line';

	const STORAGE_KEY = 'toolsman-diagram-draft';
	const isDark = () => {
		const forced = document.documentElement.dataset.theme;
		if (forced === 'dark' || forced === 'light') return forced === 'dark';
		return matchMedia('(prefers-color-scheme: dark)').matches;
	};
	const DEFAULT_CODE = 'flowchart TD\n  A[Mulai] --> B[Selesai]';

	const input = document.getElementById('diagram-input') as HTMLTextAreaElement | null;
	const preview = document.getElementById('diagram-preview');
	const select = document.getElementById('diagram-template') as HTMLSelectElement | null;
	const status = document.getElementById('diagram-status');
	const errorBox = document.getElementById('diagram-error');
	const errorText = document.getElementById('diagram-error-text');
	const copyButton = document.getElementById('diagram-copy');
	const pngButton = document.getElementById('diagram-png') as HTMLButtonElement | null;
	const svgButton = document.getElementById('diagram-svg') as HTMLButtonElement | null;
	const loadingBox = document.getElementById('diagram-loading');

	if (input && preview && select && status && errorBox && errorText && copyButton && pngButton && svgButton) {
		let mermaidPromise: Promise<typeof import('mermaid').default> | null = null;
		let svgText = '';
		let renderId = 0;
		let saveTimer: number | undefined;

		const loadMermaid = () => {
			mermaidPromise ??= import('mermaid').then((module) => {
				module.default.initialize({
					startOnLoad: false,
					securityLevel: 'strict',
					theme: isDark() ? 'dark' : 'default',
				});
				return module.default;
			});
			return mermaidPromise;
		};

		const setError = (message: string | null, line?: number) => {
			if (message === null) {
				errorBox.hidden = true;
				errorText.textContent = '';
				input.removeAttribute('aria-invalid');
				return;
			}
			errorBox.hidden = false;
			errorText.textContent = line ? `Baris ${line}: ${message}` : message;
			input.setAttribute('aria-invalid', 'true');
		};

		const setButtons = (enabled: boolean) => {
			pngButton.disabled = !enabled;
			svgButton.disabled = !enabled;
		};

		const render = async () => {
			const code = input.value;
			const current = ++renderId;

			if (code.trim() === '') {
				preview.innerHTML = '';
				setError(null);
				setButtons(false);
				if (loadingBox) loadingBox.hidden = true;
				return;
			}

			if (loadingBox) loadingBox.hidden = false;

			try {
				const mermaid = await loadMermaid();
				await mermaid.parse(code);
				const { svg } = await mermaid.render(`diagram-${current}`, code);
				if (current !== renderId) return;
				svgText = svg;
				preview.innerHTML = svg;
				setError(null);
				setButtons(true);
			} catch (error) {
				if (current !== renderId) return;
				const issue = extractLineFromMermaidError(error, code);
				setError(issue.message, issue.line);
				setButtons(false);
			} finally {
				if (current === renderId && loadingBox) loadingBox.hidden = true;
			}
		};

		const save = () => {
			status.textContent = 'Menyimpan…';
			window.clearTimeout(saveTimer);
			saveTimer = window.setTimeout(() => {
				try {
					localStorage.setItem(STORAGE_KEY, input.value);
					status.textContent = 'Tersimpan otomatis';
				} catch {
					status.textContent = 'Draf tidak bisa disimpan di tab ini.';
				}
			}, 400);
		};

		input.addEventListener('input', () => {
			select.value = '';
			save();
			void render();
		});

		select.addEventListener('change', () => {
			const template = getTemplate(select.value);
			if (!template) return;
			input.value = template.code;
			save();
			void render();
			input.focus();
		});

		copyButton.addEventListener('click', async () => {
			const copied = await copyText(input.value);
			toast(copied ? 'Kode Mermaid disalin.' : 'Gagal menyalin. Pilih teksnya lalu tekan Ctrl+C.');
		});

		const download = (name: string, blob: Blob) => {
			const url = URL.createObjectURL(blob);
			const link = document.createElement('a');
			link.href = url;
			link.download = name;
			document.body.append(link);
			link.click();
			link.remove();
			setTimeout(() => URL.revokeObjectURL(url), 1000);
		};

		svgButton.addEventListener('click', () => {
			if (!svgText) return;
			download('diagram.svg', new Blob([svgText], { type: 'image/svg+xml' }));
		});

		pngButton.addEventListener('click', async () => {
			if (!svgText) return;
			const svgEl = preview.querySelector('svg');
			const box = svgEl?.getBoundingClientRect();
			const width = Math.max(1, Math.round(box?.width ?? 800));
			const height = Math.max(1, Math.round(box?.height ?? 600));
			const image = new Image();
			const url = URL.createObjectURL(new Blob([svgText], { type: 'image/svg+xml;charset=utf-8' }));
			image.src = url;
			await image.decode();
			const canvas = document.createElement('canvas');
			canvas.width = width * 2;
			canvas.height = height * 2;
			const context = canvas.getContext('2d');
			if (!context) return;
			context.fillStyle = '#ffffff';
			context.fillRect(0, 0, canvas.width, canvas.height);
			context.drawImage(image, 0, 0, canvas.width, canvas.height);
			URL.revokeObjectURL(url);
			canvas.toBlob((blob) => {
				if (blob) download('diagram.png', blob);
			}, 'image/png');
		});

		const shareBanner = document.querySelector<HTMLElement>('[data-share-banner]');
		const shareEdit = document.querySelector<HTMLButtonElement>('[data-share-edit]');
		const shareButton = document.querySelector<HTMLButtonElement>('#diagram-share');
		const shareResult = document.querySelector<HTMLElement>('[data-share-result]');
		const shareUrl = document.querySelector<HTMLInputElement>('#diagram-share-url');
		const shareCopy = document.querySelector<HTMLButtonElement>('#diagram-share-copy');

		const loadShared = async () => {
			const token = sessionTokenFromHash(location.hash);
			if (!token) return;

			try {
				const payload = (await decodeSession(token)) as {
					v?: number;
					type?: string;
					code?: string;
				};
				if (payload?.v !== 1 || payload.type !== 'diagram' || typeof payload.code !== 'string') {
					throw new Error('Sesi tidak dikenali.');
				}

				input.value = payload.code;
				input.readOnly = true;
				select.disabled = true;
				if (shareBanner) shareBanner.hidden = false;
				status.textContent = 'Hanya-baca dari link';
				await render();
			} catch (error) {
				if (shareBanner) shareBanner.hidden = true;
				status.textContent =
					error instanceof Error && error.message.includes('terlalu panjang')
						? 'Link sesi terpotong. Memakai draf lokal.'
						: 'Link sesi tidak bisa dibaca. Memakai draf lokal.';
				toast(
					error instanceof Error && error.message.includes('terlalu panjang')
						? 'Link sesi terpotong atau terlalu panjang. Draf lokal tetap dipakai.'
						: 'Link sesi tidak bisa dibaca. Draf lokal tetap dipakai.',
				);
			}
		};

		shareEdit?.addEventListener('click', () => {
			input.readOnly = false;
			select.disabled = false;
			if (shareBanner) shareBanner.hidden = true;
			history.replaceState(null, '', location.pathname);
			save();
			status.textContent = 'Tersimpan otomatis';
			toast('Draf dibuka. Perubahan disimpan di browser ini.');
			input.focus();
		});

		shareButton?.addEventListener('click', async () => {
			try {
				const token = await encodeSession({ v: 1, type: 'diagram', code: input.value });
				const url = buildSessionUrl(`${location.origin}/tools/diagram/`, token);
				if (shareUrl && shareResult) {
					shareUrl.value = url;
					shareResult.hidden = false;
				}
				const copied = await copyText(url);
				toast(
					copied
						? `Link hanya-baca disalin (${url.length} karakter).`
						: `Link dibuat (${url.length} karakter). Salin dari kolom.`,
				);
			} catch (error) {
				if (shareResult) shareResult.hidden = true;
				if (error instanceof SessionTooLargeError) {
					toast(
						`Diagram terlalu panjang untuk link (${error.length.toLocaleString('id-ID')} dari ${error.limit.toLocaleString('id-ID')} karakter). Ringkas kode, lalu coba lagi.`,
					);
					return;
				}
				toast(error instanceof Error ? error.message : 'Gagal membuat link.');
			}
		});

		shareCopy?.addEventListener('click', async () => {
			if (!shareUrl) return;
			const copied = await copyText(shareUrl.value);
			toast(copied ? 'Link disalin.' : 'Gagal menyalin. Pilih linknya lalu tekan Ctrl+C.');
		});

		const saved = localStorage.getItem(STORAGE_KEY);
		input.value = saved && saved.trim() !== '' ? saved : DEFAULT_CODE;
		status.textContent = 'Tersimpan otomatis';
		void render();
		void loadShared();
	}

	const mobileTabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-diagram-tab]'));
	const mobilePanes = Array.from(document.querySelectorAll<HTMLElement>('[data-diagram-pane]'));
	const mobileTablist = document.querySelector<HTMLElement>('.diagram-mobile-tabs');

	const selectMobilePane = (name: string, focus = false) => {
		mobileTabs.forEach((tab) => {
			const active = tab.dataset.diagramTab === name;
			tab.setAttribute('aria-selected', active ? 'true' : 'false');
			tab.tabIndex = active ? 0 : -1;
			if (active && focus) tab.focus();
		});
		mobilePanes.forEach((pane) => {
			pane.dataset.mobileActive = pane.dataset.diagramPane === name ? 'true' : 'false';
		});
	};

	mobileTabs.forEach((tab) => {
		tab.addEventListener('click', () => {
			selectMobilePane(tab.dataset.diagramTab ?? 'code');
		});
	});

	mobileTablist?.addEventListener('keydown', (event) => {
		if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return;
		const current = mobileTabs.findIndex((tab) => tab === document.activeElement);
		if (current === -1) return;
		event.preventDefault();
		const step = event.key === 'ArrowRight' ? 1 : -1;
		const next = mobileTabs[(current + step + mobileTabs.length) % mobileTabs.length];
		if (next?.dataset.diagramTab) selectMobilePane(next.dataset.diagramTab, true);
	});

	selectMobilePane('code');

	const DRAWIO_ORIGIN = 'https://embed.diagrams.net';
	const drawioButton = document.getElementById('diagram-drawio');
	const drawioDialog = document.getElementById('diagram-drawio-dialog') as HTMLDialogElement | null;
	const drawioFrame = document.getElementById('drawio-frame') as HTMLIFrameElement | null;
	const drawioClose = document.getElementById('drawio-close');

	const openDrawio = () => {
		if (!drawioDialog || !drawioFrame || drawioDialog.open) return;
		if (drawioFrame.dataset.loaded !== 'true') {
			drawioFrame.src = `${DRAWIO_ORIGIN}/?embed=1&proto=json&spin=1&ui=min&libraries=1&saveAndExit=1`;
			drawioFrame.dataset.loaded = 'true';
		}
		drawioDialog.showModal();
	};

	drawioButton?.addEventListener('click', openDrawio);
	drawioClose?.addEventListener('click', () => drawioDialog?.close());

	window.addEventListener('message', (event) => {
		if (event.origin !== DRAWIO_ORIGIN) return;
		const frameWindow = drawioFrame?.contentWindow;
		if (!frameWindow) return;

		let message: { event?: string; xml?: string; exit?: boolean } | null = null;
		try {
			message =
				typeof event.data === 'string' ? JSON.parse(event.data) : (event.data as typeof message);
		} catch {
			return;
		}
		if (!message) return;

		if (message.event === 'init') {
			frameWindow.postMessage(
				JSON.stringify({ action: 'load', xml: '', autosave: 0 }),
				DRAWIO_ORIGIN,
			);
		}

		if (message.event === 'save') {
			if (message.xml) {
				downloadText('diagram.drawio', message.xml, 'application/xml;charset=utf-8');
				toast('Berkas .drawio diunduh.');
			}
			if (message.exit) drawioDialog?.close();
		}

		if (message.event === 'exit') drawioDialog?.close();
	});
</script>

<style>
	.diagram-bar {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		gap: var(--space-3);
		padding: var(--space-3) var(--space-4);
		border-bottom: 1px solid var(--border);
	}

	.diagram-select {
		width: auto;
		min-width: 200px;
	}

	.share-banner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-3);
		padding: var(--space-2) var(--space-3);
		border-bottom: 1px solid var(--border);
		background: var(--accent-soft);
		font-size: 0.875rem;
	}

	.share-banner[hidden] {
		display: none;
	}

	.share-link-box {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		padding: var(--space-3) var(--space-4);
		border-bottom: 1px solid var(--border);
	}

	.share-link-box[hidden] {
		display: none;
	}

	.share-link-box .field-input {
		flex: 1 1 240px;
		font-family: var(--font-mono);
		font-size: 0.8125rem;
	}

	.diagram-mobile-tabs {
		display: none;
		margin: var(--space-3) var(--space-4) 0;
	}

	@media (max-width: 767px) {
		.diagram-mobile-tabs {
			display: inline-flex;
		}

		.diagram-split {
			padding-top: var(--space-3);
		}

		.diagram-split .pane[data-diagram-pane]:not([data-mobile-active='true']) {
			display: none;
		}
	}

	.diagram-split {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: var(--space-4);
		padding: var(--space-4);
	}

	@media (min-width: 900px) {
		.diagram-split {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		}
	}

	.diagram-preview {
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: 360px;
		overflow: auto;
	}

	.diagram-preview svg {
		max-width: 100%;
		height: auto;
	}

	.diagram-loading {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		padding-top: var(--space-2);
		color: var(--text-muted);
		font-size: 0.875rem;
	}

	.diagram-loading[hidden] {
		display: none;
	}

	.drawio-modal[open] {
		display: flex;
		flex-direction: column;
		width: min(1100px, calc(100vw - var(--space-5)));
		height: min(86dvh, 860px);
		max-height: none;
	}

	.drawio-head,
	.drawio-foot {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-3);
		padding: var(--space-3) var(--space-4);
	}

	.drawio-head {
		border-bottom: 1px solid var(--border);
	}

	.drawio-foot {
		border-top: 1px solid var(--border);
	}

	.drawio-note {
		margin: 0;
		padding: var(--space-3) var(--space-4);
	}

	.drawio-frame-wrap {
		flex: 1;
		min-height: 0;
		padding: 0 var(--space-4) var(--space-3);
	}

	.drawio-frame-wrap iframe {
		width: 100%;
		height: 100%;
		border: 1px solid var(--border);
		border-radius: var(--radius-md);
		background: var(--surface-2);
	}
</style>
