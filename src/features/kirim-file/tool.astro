---
import dict from './i18n';
import Dropzone from '../../components/ui/Dropzone.astro';
---

<div class="tool-shell share-shell">
	<Dropzone
		id="kirim-input"
		label={dict.id.chooseFiles} labelKey="workspace.kirim-file.chooseFiles"
		multiple
		hint={dict.id.fileHint} hintKey="workspace.kirim-file.fileHint"
	/>

	<ul class="share-list" data-list aria-label={dict.id.fileList} data-i18n-aria="workspace.kirim-file.fileList"></ul>

	<fieldset class="share-expiry">
		<legend class="field-label" data-i18n="workspace.kirim-file.expiry">{dict.id.expiry}</legend>
		<div class="segmented" role="radiogroup">
			<button type="button" class="segmented__btn" role="radio" aria-checked="false" data-expiry="1h" data-i18n="workspace.kirim-file.hour">{dict.id.hour}</button>
			<button type="button" class="segmented__btn" role="radio" aria-checked="true" data-expiry="24h" data-i18n="workspace.kirim-file.day">{dict.id.day}</button>
			<button type="button" class="segmented__btn" role="radio" aria-checked="false" data-expiry="7d" data-i18n="workspace.kirim-file.week">{dict.id.week}</button>
		</div>
	</fieldset>

	<fieldset class="share-options">
		<legend class="field-label" data-i18n="workspace.kirim-file.options">{dict.id.options}</legend>
		<label class="check-row">
			<input type="checkbox" data-password-toggle />
			<span data-i18n="workspace.kirim-file.lock">{dict.id.lock}</span>
		</label>
		<div data-password-field hidden>
			<label class="field-label" for="share-password" data-i18n="workspace.kirim-file.password">{dict.id.password}</label>
			<input
				class="field-input"
				id="share-password"
				type="password"
				autocomplete="off"
				maxlength="64"
			/>
			<p class="field-hint" data-i18n="workspace.kirim-file.passwordHint">{dict.id.passwordHint}</p>
		</div>
		<label class="check-row">
			<input type="checkbox" data-onetime-toggle />
			<span data-i18n="workspace.kirim-file.oneTime">{dict.id.oneTime}</span>
		</label>
		<p class="field-hint check-hint" data-i18n="workspace.kirim-file.oneTimeHint">{dict.id.oneTimeHint}</p>
	</fieldset>

	<div class="share-turnstile" data-turnstile-wrap hidden>
		<span class="field-label" data-i18n="workspace.kirim-file.security">{dict.id.security}</span>
		<div data-turnstile></div>
		<p class="field-hint" data-turnstile-status role="status"></p>
	</div>

	<div class="pane-actions">
		<button type="button" class="btn btn--primary" id="kirim-start" data-task-action disabled data-i18n="workspace.kirim-file.upload">{dict.id.upload}</button>
		<button type="button" class="btn btn--secondary" data-cancel hidden data-i18n="workspace.kirim-file.cancel">{dict.id.cancel}</button>
		<button type="button" class="btn btn--secondary" data-retry hidden data-i18n="workspace.kirim-file.retry">{dict.id.retry}</button>
	</div>

	<div class="share-overall" data-overall hidden>
		<progress max="100" value="0" data-overall-bar aria-label={dict.id.overallAria} data-i18n-aria="workspace.kirim-file.overallAria"></progress>
		<p class="field-hint" data-overall-text></p>
	</div>

	<div class="share-status-row">
		<span class="spinner" data-status-spinner hidden aria-hidden="true"></span>
		<p class="field-hint" data-status data-task-status aria-live="polite"></p>
	</div>

	<p class="field-hint" data-i18n="workspace.kirim-file.multipartHint">{dict.id.multipartHint}</p>

	<section class="share-result" data-result hidden aria-labelledby="result-title">
		<h2 id="result-title" class="pane__title" data-i18n="workspace.kirim-file.linkReady">{dict.id.linkReady}</h2>
		<div class="share-link-row">
			<input class="field-input" id="share-url" aria-label={dict.id.recipientLink} data-i18n-aria="workspace.kirim-file.recipientLink" readonly />
			<button type="button" class="btn btn--secondary" id="share-copy" data-i18n="workspace.kirim-file.copyLink">{dict.id.copyLink}</button>
		</div>
		<div class="share-meta">
			<img id="share-qr" alt={dict.id.qrAlt} data-i18n-alt="workspace.kirim-file.qrAlt" width="180" height="180" />
			<p class="field-hint" data-countdown></p>
		</div>
		<p class="field-hint" data-result-note hidden></p>
		<label class="field-label" for="share-manage-url" data-i18n="workspace.kirim-file.manageLink">{dict.id.manageLink}</label>
		<div class="share-link-row">
			<input class="field-input" id="share-manage-url" readonly />
			<button type="button" class="btn btn--secondary" id="share-manage-copy" data-i18n="workspace.kirim-file.copyManage">{dict.id.copyManage}</button>
		</div>
		<p class="field-hint" id="share-manage-note"></p>
	</section>
	<section class="pane" aria-labelledby="saved-shares-title">
		<h2 id="saved-shares-title" class="pane__title" data-i18n="workspace.kirim-file.yourShares">{dict.id.yourShares}</h2>
		<p class="field-hint" data-i18n="workspace.kirim-file.savedHint">{dict.id.savedHint}</p>
		<ul id="saved-shares"></ul>
		<p class="field-hint" id="saved-shares-empty" data-i18n="workspace.kirim-file.savedEmpty">{dict.id.savedEmpty}</p>
	</section>
</div>

<script>
	import { currentLang, tr, workspaceErrorMessage } from '../../lib/i18n';
	import { localizedText } from '../../lib/i18n-client';
	import dict from './i18n';
	import { apiErrorKey } from './client-errors';
	import { toast } from '../../lib/toast';
	import { copyText } from '../../lib/clipboard';
	import { dropzoneOf, setDropzoneState } from '../../lib/dropzone';
	import {
		postJson,
		putPartWithProgress,
		putWithProgress,
		UploadError,
		formatBytes,
		formatRemaining,
	} from './upload-client';
	import {
		partCount,
		partRange,
		partSize,
		shouldUseMultipart,
	} from './multipart';
	import { PASSWORD_MIN, PASSWORD_MAX, validateFile, validatePassword } from './share-rules';
	import { qrDataUrl } from './qr';
	import { loadSavedShares, managePath, removeSavedShare, saveShare, senderStorage } from './saved-shares';

	type Expiry = '1h' | '24h' | '7d';
	type FileState = 'idle' | 'uploading' | 'done' | 'failed';

	interface UploadTarget {
		name: string;
		uploadUrl: string;
	}

	interface ShareSession {
		id: string;
		manageToken: string;
		expiresAt: number;
		uploads: UploadTarget[];
		protected: boolean;
		oneTime: boolean;
	}

	const PRESIGN_WINDOW_MS = 13 * 60 * 1000;

	const input = document.getElementById('kirim-input') as HTMLInputElement | null;
	const list = document.querySelector<HTMLUListElement>('[data-list]');
	const startButton = document.getElementById('kirim-start') as HTMLButtonElement | null;
	const status = document.querySelector<HTMLElement>('[data-status]');
	const statusSpinner = document.querySelector<HTMLElement>('[data-status-spinner]');
	const overall = document.querySelector<HTMLElement>('[data-overall]');
	const overallBar = document.querySelector<HTMLProgressElement>('[data-overall-bar]');
	const overallText = document.querySelector<HTMLElement>('[data-overall-text]');
	const result = document.querySelector<HTMLElement>('[data-result]');
	const urlField = document.getElementById('share-url') as HTMLInputElement | null;
	const copyButton = document.getElementById('share-copy');
	const qrImage = document.getElementById('share-qr') as HTMLImageElement | null;
	const countdown = document.querySelector<HTMLElement>('[data-countdown]');
	const expiryButtons = document.querySelectorAll<HTMLButtonElement>('[data-expiry]');
	const passwordToggle = document.querySelector<HTMLInputElement>('[data-password-toggle]');
	const passwordField = document.querySelector<HTMLElement>('[data-password-field]');
	const passwordInput = document.getElementById('share-password') as HTMLInputElement | null;
	const oneTimeToggle = document.querySelector<HTMLInputElement>('[data-onetime-toggle]');
	const cancelButton = document.querySelector<HTMLButtonElement>('[data-cancel]');
	const retryButton = document.querySelector<HTMLButtonElement>('[data-retry]');
	const resultNote = document.querySelector<HTMLElement>('[data-result-note]');
	const turnstileWrap = document.querySelector<HTMLElement>('[data-turnstile-wrap]');
	const turnstileBox = document.querySelector<HTMLElement>('[data-turnstile]');
	const turnstileStatus = document.querySelector<HTMLElement>('[data-turnstile-status]');
	const TURNSTILE_SITE_KEY = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';
	const renderSavedShares = () => {
		const savedList = document.getElementById('saved-shares')!;
		const saved = loadSavedShares(senderStorage());
		savedList.replaceChildren();
		for (const share of saved) {
			const item = document.createElement('li');
			const link = document.createElement('a');
			link.href = managePath(share.id, share.token); link.textContent = share.fileNames.join(', ');
			link.rel = 'noreferrer';
			const note = document.createElement('p'); note.className = 'field-hint'; localizedText(note, () => tr(dict, 'validFor', { remaining: formatRemaining(share.expiresAt - Date.now()) }));
			const remove = document.createElement('button'); remove.type = 'button'; remove.className = 'btn btn--secondary'; localizedText(remove, () => (tr(dict, 'removeSaved')));
			remove.setAttribute('aria-label', tr(dict, 'removeAria', { name: share.fileNames.join(', ') }));
			remove.addEventListener('click', () => { if (!removeSavedShare(senderStorage(), share.id)) toast(() => (tr(dict, 'storageFailed')), { tone: 'error' }); renderSavedShares(); });
			item.append(link, note, remove); savedList.append(item);
		}
		document.getElementById('saved-shares-empty')!.hidden = saved.length > 0;
	};
	renderSavedShares();
	window.setInterval(renderSavedShares, 60_000);
	window.addEventListener('storage', renderSavedShares);
	document.addEventListener('lang:change', renderSavedShares);
	document.getElementById('share-manage-copy')!.addEventListener('click', async () => {
		const value = document.querySelector<HTMLInputElement>('#share-manage-url')!.value;
		if (!value) return;
		const copied = await copyText(value);
		toast(() => copied ? tr(dict, 'manageCopied') : tr(dict, 'manageCopyFailed'));
	});

	if (input && list && startButton && status && result && urlField && copyButton && qrImage && countdown) {
		const makeQr = (text: string) => qrDataUrl(text);

		let turnstileToken = '';
		let turnstileWidget: string | null = null;

		const resetTurnstile = () => {
			turnstileToken = '';
			if (window.turnstile && turnstileWidget) {
				window.turnstile.reset(turnstileWidget);
				if (turnstileStatus) {
					localizedText(turnstileStatus, () => (tr(dict, 'verifyFirst')));
				}
			}
		};

		const setupTurnstile = () => {
			const wrap = turnstileWrap;
			const box = turnstileBox;
			const note = turnstileStatus;
			if (TURNSTILE_SITE_KEY === '' || !wrap || !box || !note) return;

			wrap.hidden = false;
			localizedText(note, () => (tr(dict, 'verifyLoading')));

			const script = document.createElement('script');
			script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
			script.async = true;
			const renderVerification = () => {
				if (!window.turnstile) {
					localizedText(note, () => (tr(dict, 'verifyLoadFailed')));
					return;
				}
				try {
					if (turnstileWidget) window.turnstile.remove(turnstileWidget);
					turnstileToken = '';
					turnstileWidget = window.turnstile.render(box, {
						sitekey: TURNSTILE_SITE_KEY,
						theme: 'auto',
						language: currentLang(),
						callback: (token: string) => {
							turnstileToken = token;
							localizedText(note, () => (tr(dict, 'verified')));
						},
						'expired-callback': () => {
							turnstileToken = '';
							localizedText(note, () => (tr(dict, 'verifyExpired')));
						},
						'error-callback': () => {
							turnstileToken = '';
							localizedText(note, () => (tr(dict, 'verifyFailed')));
						},
					});
					localizedText(note, () => (tr(dict, 'verifyFirst')));
				} catch {
					localizedText(note, () => (tr(dict, 'verifyStartFailed')));
				}
			};
			script.addEventListener('load', renderVerification);
			document.addEventListener('lang:change', () => {
				if (turnstileWidget) renderVerification();
			});
			script.addEventListener('error', () => {
				localizedText(note, () => (tr(dict, 'verifyLoadFailed')));
			});
			document.head.append(script);
		};

		let files: File[] = [];
		let expiry: Expiry = '24h';
		let timer: number | undefined;
		let session: ShareSession | null = null;
		let createdAt = 0;
		let states: FileState[] = [];
		let progress: number[] = [];
		let attempts: number[] = [];
		let current: { abort: () => void } | null = null;
		let running = false;
		let cancelled = false;
		let retryable = false;
		const multipartStarted = new Set<number>();
		const thumbUrls = new Map<File, string>();

		const setStatus = (message: () => string, loading = false) => {
			localizedText(status, message);
			if (statusSpinner) statusSpinner.hidden = !loading;
		};

		const resetSession = () => {
			session = null;
			createdAt = 0;
			attempts = files.map(() => 0);
			retryable = false;
			multipartStarted.clear();
		};

		const updateOverall = () => {
			if (!overall || !overallBar || !overallText) return;
			if (files.length === 0) {
				overall.hidden = true;
				overallBar.value = 0;
				localizedText(overallText, () => (''));
				return;
			}

			const total = files.reduce((sum, file) => sum + file.size, 0);
			const loaded = files.reduce((sum, file, index) => {
				if (states[index] === 'done') return sum + file.size;
				return sum + Math.round((file.size * (progress[index] ?? 0)) / 100);
			}, 0);
			const percent = total > 0 ? Math.round((loaded / total) * 100) : 0;

			overall.hidden = false;
			overallBar.value = percent;
			localizedText(overallText, () => tr(dict, 'overall', { percent, loaded: formatBytes(loaded), total: formatBytes(total) }));
		};

		const clearThumbs = () => {
			for (const url of thumbUrls.values()) URL.revokeObjectURL(url);
			thumbUrls.clear();
		};

		const setBusy = (busy: boolean) => {
			running = busy;
			startButton.disabled = busy || files.length === 0;
			if (cancelButton) cancelButton.hidden = !busy;
			if (retryButton) retryButton.hidden = busy || !retryable;
			input.disabled = busy;
			if (passwordToggle) passwordToggle.disabled = busy;
			if (passwordInput) passwordInput.disabled = busy;
			if (oneTimeToggle) oneTimeToggle.disabled = busy;
			renderList();
		};

		const stateLabel = (index: number) => {
			const file = files[index];
			if (!file) return '';
			if (states[index] === 'done') return tr(dict, 'done');
			if (states[index] === 'failed') return tr(dict, 'failed');
			if (states[index] === 'uploading') {
				const percent = progress[index] ?? 0;
				return shouldUseMultipart(file.size) ? tr(dict, 'partProgress', { percent }) : `${percent}%`;
			}
			return tr(dict, 'idle');
		};

		const renderList = () => {
			list.innerHTML = '';
			files.forEach((file, index) => {
				const item = document.createElement('li');
				item.className = 'share-item';
				item.dataset.state = states[index] ?? 'idle';

				const thumb = document.createElement('span');
				thumb.className = 'share-item__thumb';
				if (file.type.startsWith('image/')) {
					let url = thumbUrls.get(file);
					if (!url) {
						url = URL.createObjectURL(file);
						thumbUrls.set(file, url);
					}
					const image = document.createElement('img');
					image.src = url;
					image.alt = '';
					image.loading = 'lazy';
					thumb.append(image);
				} else {
					const extension = file.name.includes('.') ? file.name.split('.').pop()! : 'file';
					thumb.textContent = extension.slice(0, 4).toUpperCase();
				}

				const info = document.createElement('span');
				info.className = 'share-item__info';

				const name = document.createElement('span');
				name.className = 'share-item__name';
				name.textContent = file.name;
				name.title = file.name;

				const meta = document.createElement('span');
				meta.className = 'share-item__meta';

				const size = document.createElement('span');
				size.textContent = formatBytes(file.size);

				const state = document.createElement('span');
				state.className = 'share-item__state';
				localizedText(state, () => (stateLabel(index)));
				if (states[index] === 'done') state.classList.add('is-done');
				if (states[index] === 'failed') state.classList.add('is-failed');

				meta.append(size, document.createTextNode(' · '), state);
				info.append(name, meta);

				const remove = document.createElement('button');
				remove.type = 'button';
				remove.className = 'icon-button share-item__remove';
				remove.textContent = '×';
				remove.disabled = running;
				remove.setAttribute('aria-label', tr(dict, 'removeAria', { name: file.name }));
				remove.addEventListener('click', () => {
					if (running) return;
					const [removedFile] = files.splice(index, 1);
					states.splice(index, 1);
					progress.splice(index, 1);
					attempts.splice(index, 1);
					multipartStarted.delete(index);
					if (removedFile) {
						const url = thumbUrls.get(removedFile);
						if (url) URL.revokeObjectURL(url);
						thumbUrls.delete(removedFile);
					}
					resetSession();
					result.hidden = true;
					renderList();
				});

				item.append(thumb, info, remove);

				if (states[index] === 'uploading' || states[index] === 'done') {
					const bar = document.createElement('progress');
					bar.max = 100;
					bar.value = states[index] === 'done' ? 100 : (progress[index] ?? 0);
					bar.setAttribute('aria-label', tr(dict, 'progressAria', { name: file.name }));
					item.append(bar);
				}

				list.append(item);
			});
			startButton.disabled = running || files.length === 0;
			updateOverall();
		};

		const resetFiles = () => {
			states = files.map(() => 'idle');
			progress = files.map(() => 0);
			attempts = files.map(() => 0);
			multipartStarted.clear();
			renderList();
		};

		input.addEventListener('change', () => {
			if (running) return;
			const picked = Array.from(input.files ?? []);
			const invalid = picked.find((file) => validateFile(file) !== null);
			files = picked.filter((file) => validateFile(file) === null);
			input.value = '';
			clearThumbs();
			setStatus(() => invalid ? validateFile(invalid, currentLang()) ?? '' : '');
			result.hidden = true;
			resetSession();
			resetFiles();
		});

		expiryButtons.forEach((button) => {
			button.addEventListener('click', () => {
				if (running) return;
				expiry = button.dataset.expiry as Expiry;
				expiryButtons.forEach((other) => {
					other.setAttribute('aria-checked', other === button ? 'true' : 'false');
				});
			});
		});

		passwordToggle?.addEventListener('change', () => {
			if (!passwordField) return;
			passwordField.hidden = !passwordToggle.checked;
			if (passwordToggle.checked) passwordInput?.focus();
		});

		const showResult = async (active: ShareSession) => {
			const url = `${location.origin}/s/${active.id}`;
			urlField.value = url;
			document.querySelector<HTMLInputElement>('#share-manage-url')!.value = `${location.origin}${managePath(active.id, active.manageToken)}`;
			const saved = saveShare(senderStorage(), { id: active.id, token: active.manageToken, expiresAt: active.expiresAt, fileNames: active.uploads.map((file) => file.name) });
			localizedText(document.getElementById('share-manage-note')!, () => (saved ? tr(dict, 'manageSaved') : tr(dict, 'manageUnsaved')));
			renderSavedShares();
			result.hidden = false;
			try { qrImage.src = await makeQr(url); qrImage.hidden = false; }
			catch { qrImage.hidden = true; }

			const notes = () => {
				const messages: string[] = [];
				if (active.protected) messages.push(tr(dict, 'needsPassword'));
				if (active.oneTime) messages.push(tr(dict, 'oneTimeHint'));
				return messages.join(' ');
			};
			if (resultNote) {
				localizedText(resultNote, notes);
				resultNote.hidden = !active.protected && !active.oneTime;
			}

			const tick = () => {
				localizedText(countdown, () => tr(dict, 'validFor', { remaining: formatRemaining(active.expiresAt - Date.now()) }));
			};
			tick();
			window.clearInterval(timer);
			timer = window.setInterval(tick, 30_000);
		};

		const createSession = async (): Promise<ShareSession> => {
			const wantsPassword = Boolean(passwordToggle?.checked);
			const password = passwordInput?.value ?? '';
			if (wantsPassword) {
				if (validatePassword(password)) throw new UploadError(password.length < PASSWORD_MIN ? 'passwordMin' : 'passwordMax', undefined, { count: password.length < PASSWORD_MIN ? PASSWORD_MIN : PASSWORD_MAX });
			}

			const response = await fetch('/api/shares', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({
					expiry,
					password: wantsPassword ? password : undefined,
					oneTime: Boolean(oneTimeToggle?.checked),
					turnstileToken: TURNSTILE_SITE_KEY !== '' ? turnstileToken : undefined,
					files: files.map((file) => ({ name: file.name, size: file.size, type: file.type })),
				}),
			}).finally(() => {
				if (TURNSTILE_SITE_KEY !== '') resetTurnstile();
			});
			const data = (await response.json()) as {
				id?: string;
				manageToken?: string;
				expiresAt?: number;
				uploads?: UploadTarget[];
				protected?: boolean;
				oneTime?: boolean;
				error?: string;
			};
			if (!response.ok || !data.id || !data.manageToken || !data.uploads || data.expiresAt === undefined) {
				throw new UploadError(response.ok ? 'incomplete' : apiErrorKey(response.status), response.status, { status: response.status });
			}

			return {
				id: data.id,
				manageToken: data.manageToken,
				expiresAt: data.expiresAt,
				uploads: data.uploads,
				protected: Boolean(data.protected),
				oneTime: Boolean(data.oneTime),
			};
		};

		const delay = (ms: number) => new Promise((resolve) => window.setTimeout(resolve, ms));

		const uploadMultipart = async (index: number, active: ShareSession, file: File) => {
			multipartStarted.add(index);
			const info = await postJson<{ partCount: number; completed: number[] }>(
				`/api/shares/${active.id}/multipart/start`,
				{ index },
			);

			const total = partCount(file.size);
			if (info.partCount !== total) {
				throw new UploadError("partsMismatch");
			}

			const done = new Set(info.completed);
			let doneBytes = 0;
			for (const part of done) {
				if (part >= 1 && part <= total) doneBytes += partSize(file.size, part);
			}

			for (let part = 1; part <= total; part += 1) {
				if (done.has(part)) continue;
				if (cancelled) throw new UploadError("uploadCancelled");

				const range = partRange(file.size, part);
				const chunk = file.slice(range.start, range.end);
				let retry = 0;

				for (;;) {
					try {
						const handle = putPartWithProgress(
							`/api/shares/${active.id}/multipart/part?index=${index}&part=${part}`,
							chunk,
							(loaded) => {
								progress[index] = Math.min(
									99,
									Math.round(((doneBytes + loaded) / file.size) * 100),
								);
								renderList();
							},
						);
						current = handle;
						await handle.promise;
						doneBytes += chunk.size;
						progress[index] = Math.min(99, Math.round((doneBytes / file.size) * 100));
						renderList();
						break;
					} catch (error) {
						if (cancelled) throw error;
						const httpStatus = error instanceof UploadError ? error.status : undefined;
						if (httpStatus !== undefined && httpStatus < 500) throw error;
						retry += 1;
						if (retry > 2) throw error;
						setStatus(() => tr(dict, 'retryPart', { part, retry }), true);
						await delay(800 * retry);
					}
				}
			}

			await postJson(`/api/shares/${active.id}/multipart/complete`, { index });
			multipartStarted.delete(index);
		};

		const uploadOne = async (index: number) => {
			const active = session;
			const file = files[index];
			if (!active || !file) throw new UploadError("incomplete");

			states[index] = 'uploading';
			renderList();
			setStatus(
				() => tr(dict, 'uploadFile', { name: file.name, multipart: shouldUseMultipart(file.size) ? tr(dict, 'multipartSuffix') : '' }),
				true,
			);

			try {
				if (shouldUseMultipart(file.size)) {
					await uploadMultipart(index, active, file);
				} else {
					const target = active.uploads[index];
					if (!target) throw new UploadError("incomplete");

					const handle = putWithProgress(
						target.uploadUrl,
						file,
						file.type || 'application/octet-stream',
						(loaded, total) => {
							progress[index] = Math.round((loaded / total) * 100);
							renderList();
						},
					);
					current = handle;
					await handle.promise;
				}

				states[index] = 'done';
				progress[index] = 100;
				renderList();
			} finally {
				current = null;
			}
		};

		const uploadAll = async () => {
			for (let index = 0; index < files.length; index += 1) {
				if (states[index] === 'done') continue;
				if (cancelled) throw new UploadError("uploadCancelled");

				for (;;) {
					try {
						await uploadOne(index);
						break;
					} catch (error) {
						if (cancelled) throw error;
						const httpStatus = error instanceof UploadError ? error.status : undefined;
						if (httpStatus === undefined && (attempts[index] ?? 0) < 1) {
							attempts[index] = (attempts[index] ?? 0) + 1;
							setStatus(
								() => tr(dict, 'retryFile', { name: files[index]?.name ?? tr(dict, 'fileFallback') }),
								true,
							);
							await delay(1200);
							continue;
						}
						states[index] = 'failed';
						renderList();
						throw error;
					}
				}
			}
		};

		const run = async () => {
			if (running || files.length === 0) return;

			const stale = session !== null && Date.now() - createdAt > PRESIGN_WINDOW_MS;
			const needsNewSession = !session || stale;
			if (needsNewSession && TURNSTILE_SITE_KEY !== '' && turnstileToken === '') {
				setStatus(() => (tr(dict, 'verifyRequired')));
				return;
			}

			cancelled = false;
			setBusy(true);
			const zone = dropzoneOf('kirim-input');
			setDropzoneState(zone, 'processing');

			try {
				if (needsNewSession) {
					if (stale) {
						setStatus(() => (tr(dict, 'staleSession')), true);
					} else {
						setStatus(() => (tr(dict, 'preparing')), true);
					}
					resetSession();
					states = files.map(() => 'idle');
					progress = files.map(() => 0);
					attempts = files.map(() => 0);
					renderList();

					session = await createSession();
					createdAt = Date.now();
					retryable = true;
					setBusy(true);
				}

				await uploadAll();
				const active = session;
				if (!active) throw new UploadError("sessionMissing");
				await postJson(`/api/shares/${active.id}/complete`, {});
				setStatus(() => (''));
				retryable = false;
				await showResult(active);
				toast(() => (tr(dict, 'readyToast')), { tone: 'success' });
			} catch (error) {
				if (error instanceof UploadError && error.status === 410) resetSession();
				retryable = session !== null;
				states = states.map((state) => (state === 'uploading' ? 'idle' : state));
				renderList();

				if (cancelled && session) {
					const active = session;
					await Promise.all(
						[...multipartStarted].map((index) =>
							postJson(`/api/shares/${active.id}/multipart/abort`, { index }).catch(
								() => null,
							),
						),
					);
					multipartStarted.clear();
				}

				setStatus(
					() => (cancelled
						? tr(dict, 'cancelledResume')
						: workspaceErrorMessage(error, tr(dict, 'unexpected'))),
				);
			} finally {
				current = null;
				setBusy(false);
				setDropzoneState(zone, files.length > 0 ? 'done' : 'empty');
			}
		};

		startButton.addEventListener('click', () => {
			void run();
		});

		retryButton?.addEventListener('click', () => {
			void run();
		});

		cancelButton?.addEventListener('click', () => {
			if (!running) return;
			cancelled = true;
			setStatus(() => (tr(dict, 'cancelling')), true);
			current?.abort();
		});

		copyButton.addEventListener('click', async () => {
			const copied = await copyText(urlField.value);
			toast(() => (copied ? tr(dict, 'copied') : tr(dict, 'copyFailed')), { tone: copied ? 'success' : 'error' });
		});

		setupTurnstile();
		document.addEventListener('lang:change', renderList);
	}
</script>

