---
import Dropzone from '../../components/ui/Dropzone.astro';
import { hashAlgorithms } from './hash';
import dict from './i18n';

const algorithms = hashAlgorithms;
---

<div class="tool-shell hash-shell">
	<div class="pane-grid pane-grid--split">
		<div class="pane">
			<div class="pane__head">
				<h2 class="pane__title" data-i18n="workspace.hash.input">{dict.id.input}</h2>
				<div class="segmented" role="group" aria-label={dict.id.inputType} data-i18n-aria="workspace.hash.inputType">
					<button type="button" class="segmented__btn" data-hash-mode="text" aria-pressed="true">
						<span data-i18n="workspace.hash.text">{dict.id.text}</span>
					</button>
					<button type="button" class="segmented__btn" data-hash-mode="file" aria-pressed="false">
						<span data-i18n="workspace.hash.file">{dict.id.file}</span>
					</button>
				</div>
			</div>

			<div data-hash-pane="text">
				<label class="sr-only" for="hash-input" data-i18n="workspace.hash.source">{dict.id.source}</label>
				<textarea
					id="hash-input"
					class="code-area"
					spellcheck="false"
					placeholder={dict.id.placeholder} data-i18n-placeholder="workspace.hash.placeholder"></textarea>
			</div>

			<div data-hash-pane="file" hidden>
				<Dropzone
					id="hash-file"
					label={dict.id.choose} labelKey="workspace.hash.choose"
					hint={dict.id.hint} hintKey="workspace.hash.hint"
				/>
			</div>

			<div class="form-grid">
				<div>
					<label class="field-label" for="hash-algorithm" data-i18n="workspace.hash.algorithm">{dict.id.algorithm}</label>
					<select class="field-input" id="hash-algorithm">
						{algorithms.map((algorithm) => <option value={algorithm.id} data-i18n={algorithm.id === 'SHA-1' ? 'workspace.hash.legacy' : undefined}>{algorithm.label}</option>)}
					</select>
				</div>
				<div>
					<label class="field-label" for="hash-compare" data-i18n="workspace.hash.compare">{dict.id.compare}</label>
					<input
						class="field-input field-mono"
						id="hash-compare"
						type="text"
						spellcheck="false"
						placeholder={dict.id.comparePlaceholder} data-i18n-placeholder="workspace.hash.comparePlaceholder"
					/>
					<p class="field-hint" data-i18n="workspace.hash.compareHint">{dict.id.compareHint}</p>
				</div>
			</div>

			<div class="hash-status-row">
				<span class="spinner" id="hash-spinner" hidden aria-hidden="true"></span>
				<p class="field-hint" id="hash-status" role="status" aria-live="polite">
					<span data-i18n="workspace.hash.initial">{dict.id.initial}</span>
				</p>
			</div>

			<div class="alert" id="hash-error" role="alert" hidden>
				<p id="hash-error-text"></p>
			</div>
		</div>

		<div class="pane">
			<div class="pane__head">
				<h2 class="pane__title">Hash</h2>
				<div class="pane-actions">
					<span class="badge" id="hash-match" hidden></span>
					<button type="button" class="btn btn--primary" id="hash-copy" disabled data-i18n="workspace.hash.copy">{dict.id.copy}</button>
				</div>
			</div>

			<pre class="code-block code-block--short" id="hash-output" hidden><code id="hash-code"></code></pre>
			<p class="preview-empty" id="hash-empty" data-i18n="workspace.hash.empty">{dict.id.empty}</p>
		</div>
	</div>
</div>

<script>
	import { copyText } from '../../lib/clipboard';
	import { toast } from '../../lib/toast';
	import { tr } from '../../lib/i18n';
	import { localizedText } from '../../lib/i18n-client';
	import dict from './i18n';
	import {
		hashBuffer,
		hashMatches,
		hashText,
		type HashAlgorithm,
	} from './hash';

	const input = document.getElementById('hash-input') as HTMLTextAreaElement | null;
	const fileInput = document.getElementById('hash-file') as HTMLInputElement | null;
	const algorithm = document.getElementById('hash-algorithm') as HTMLSelectElement | null;
	const compare = document.getElementById('hash-compare') as HTMLInputElement | null;
	const output = document.getElementById('hash-output');
	const code = document.getElementById('hash-code');
	const empty = document.getElementById('hash-empty');
	const copy = document.getElementById('hash-copy') as HTMLButtonElement | null;
	const status = document.getElementById('hash-status');
	const spinner = document.getElementById('hash-spinner');
	const errorBox = document.getElementById('hash-error');
	const errorText = document.getElementById('hash-error-text');
	const matchBadge = document.getElementById('hash-match');
	const modeButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-hash-mode]'));
	const panes = Array.from(document.querySelectorAll<HTMLElement>('[data-hash-pane]'));

	if (
		input &&
		fileInput &&
		algorithm &&
		compare &&
		output &&
		code &&
		empty &&
		copy &&
		status &&
		spinner &&
		errorBox &&
		errorText &&
		matchBadge
	) {
		let mode: 'text' | 'file' = 'text';
		let file: File | null = null;
		let result = '';
		let timer: number | undefined;
		let job = 0;

		const setError = (message: (() => string) | null) => {
			errorBox.hidden = message === null;
			localizedText(errorText, message ?? (() => ''));
		};

		const setLoading = (loading: boolean) => {
			spinner.hidden = !loading;
		};

		const setResult = (value: string) => {
			result = value;
			const blank = value === '';
			code.textContent = value;
			output.hidden = blank;
			empty.hidden = !blank;
			copy.disabled = blank;
			updateMatch();
		};

		const updateMatch = () => {
			if (!matchBadge) return;
			const expected = compare.value.trim();
			if (expected === '' || result === '') {
				matchBadge.hidden = true;
				matchBadge.classList.remove('is-pass', 'is-fail');
				return;
			}
			const matched = hashMatches(expected, result);
			matchBadge.hidden = false;
			localizedText(matchBadge, () => tr(dict, matched ? 'match' : 'mismatch'));
			matchBadge.classList.toggle('is-pass', matched);
			matchBadge.classList.toggle('is-fail', !matched);
		};

		const compute = async () => {
			const current = ++job;
			setError(null);
			setLoading(true);

			try {
				if (mode === 'text') {
					if (input.value === '') {
						if (current === job) {
							setResult('');
							localizedText(status, () => tr(dict, 'initial'));
						}
						return;
					}
					const value = await hashText(input.value, algorithm.value as HashAlgorithm);
					if (current !== job) return;
					setResult(value);
					localizedText(status, () => tr(dict, 'characters', { algorithm: algorithm.value, n: input.value.length }));
				} else {
					if (!file) {
						if (current === job) {
							setResult('');
							localizedText(status, () => tr(dict, 'chooseFirst'));
						}
						return;
					}
					const buffer = await file.arrayBuffer();
					const value = await hashBuffer(buffer, algorithm.value as HashAlgorithm);
					if (current !== job) return;
					setResult(value);
					localizedText(status, () => `${algorithm.value} · ${file?.name ?? ''}`);
				}
			} catch {
				if (current !== job) return;
				setResult('');
				setError(() => tr(dict, 'failed'));
			} finally {
				if (current === job) setLoading(false);
			}
		};

		modeButtons.forEach((button) => {
			button.addEventListener('click', () => {
				mode = button.dataset.hashMode === 'file' ? 'file' : 'text';
				modeButtons.forEach((other) =>
					other.setAttribute('aria-pressed', other === button ? 'true' : 'false'),
				);
				panes.forEach((pane) => {
					pane.hidden = pane.dataset.hashPane !== mode;
				});
				void compute();
			});
		});

		input.addEventListener('input', () => {
			window.clearTimeout(timer);
			timer = window.setTimeout(() => void compute(), 200);
		});

		fileInput.addEventListener('change', () => {
			file = fileInput.files?.[0] ?? null;
			if (file && file.size > 50 * 1024 * 1024) {
				file = null;
				setError(() => tr(dict, 'tooLarge'));
				return;
			}
			void compute();
		});

		algorithm.addEventListener('change', () => void compute());
		compare.addEventListener('input', updateMatch);

		copy.addEventListener('click', async () => {
			const copied = await copyText(result);
			toast(() => tr(dict, copied ? 'copied' : 'copyFailed'), { tone: copied ? 'success' : 'error' });
		});
	}
</script>

<style>
	.hash-shell {
		padding: var(--space-4);
	}

	.field-mono {
		font-family: var(--font-mono);
		font-size: 0.875rem;
	}

	.hash-status-row {
		display: flex;
		align-items: center;
		gap: var(--space-2);
	}

	.hash-status-row .field-hint {
		margin: 0;
	}

	.code-block--short {
		min-height: 140px;
		font-size: 0.8125rem;
		overflow-wrap: anywhere;
		white-space: pre-wrap;
	}

	.badge {
		padding: 2px 8px;
		border: 1px solid var(--border);
		border-radius: 999px;
		font-family: var(--font-mono);
		font-size: 0.75rem;
	}

	.badge[hidden] {
		display: none;
	}

	.badge.is-pass {
		border-color: light-dark(#9ccdb4, #2a5a43);
		background: light-dark(#e8f5ee, #1b2c24);
		color: light-dark(#11663f, #3dbe86);
	}

	.badge.is-fail {
		border-color: light-dark(#e2b4b4, #5c2e2e);
		background: light-dark(#fbeaea, #2e1b1b);
		color: light-dark(#8f2424, #f06b6b);
	}
</style>
