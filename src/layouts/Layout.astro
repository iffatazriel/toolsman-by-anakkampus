---
import '@fontsource-variable/plus-jakarta-sans/index.css';
import '@fontsource-variable/inter/index.css';
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/jetbrains-mono/latin-500.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Toast from '../components/ui/Toast.astro';
import { SITE_NAME, siteUrl } from '../lib/site';

interface Props {
	title: string;
	description: string;
	type?: 'website' | 'article';
	noindex?: boolean;
	jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, type = 'website', noindex = false, jsonLd } = Astro.props;
const base = Astro.site ?? new URL(`${siteUrl}/`);
const canonical = new URL(Astro.url.pathname, base).toString();
const jsonLdText = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : null;
---

<!doctype html>
<html lang="id">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content={type} />
		<meta property="og:url" content={canonical} />
		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:locale" content="id_ID" />
		<meta name="twitter:card" content="summary" />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		{jsonLdText && (
			<script type="application/ld+json" is:inline set:html={jsonLdText} />
		)}
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<script is:inline src="/theme-init.js"></script>
	</head>
	<body>
		<a class="skip-link" href="#konten" data-i18n="nav.skip">Langsung ke konten</a>
		<Header />
		<main id="konten"><slot /></main>
		<Footer />
		<Toast />
		<script>
			import { isFavorite, toggleFavorite } from '../lib/favorites';
			import { initLanguage } from '../lib/i18n-client';
			import { fill, readLang, t } from '../lib/i18n';

			const sync = () => {
				const lang = readLang();
				document.querySelectorAll<HTMLButtonElement>('[data-favorite]').forEach((button) => {
					const slug = button.dataset.favorite ?? '';
					if (slug === '') return;
					const active = isFavorite(localStorage, slug);
					const name = button.dataset.name ?? (lang === 'en' ? 'tool' : 'alat');
					button.setAttribute('aria-pressed', active ? 'true' : 'false');
					button.setAttribute(
						'aria-label',
						fill(t(lang, active ? 'favorite.remove' : 'favorite.save'), { name }),
					);
				});
			};

			document.addEventListener('click', (event) => {
				const button = (event.target as HTMLElement).closest<HTMLButtonElement>(
					'[data-favorite]',
				);
				if (!button) return;
				const slug = button.dataset.favorite ?? '';
				if (slug === '') return;
				toggleFavorite(localStorage, slug);
				sync();
				document.dispatchEvent(new CustomEvent('favorites:change'));
			});

			document.addEventListener('favorites:change', sync);
			document.addEventListener('lang:change', sync);
			initLanguage();
			sync();
		</script>
	</body>
</html>
