---
import '../styles/fonts.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Toast from '../components/ui/Toast.astro';
import { SITE_NAME, absoluteUrl, siteUrl } from '../lib/site';
import displayFont from '@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2?url';
import bodyFont from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';

interface Props {
	title: string;
	description: string;
	type?: 'website' | 'article';
	noindex?: boolean;
	jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, type = 'website', noindex = false, jsonLd } = Astro.props;
const base = Astro.site ?? new URL(`${siteUrl}/`);
const canonical = new URL(Astro.url.pathname, base).toString();
const jsonLdText = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : null;
const ogImage = absoluteUrl('/og.png');
// Halaman alat punya area kerja (kanvas/editor) yang tidak boleh beranimasi,
// jadi hanya halaman non-alat yang ikut cross-document view transition.
const isWorkspace = Astro.url.pathname.startsWith('/tools/');
---

<!doctype html>
<html lang="id">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		{!isWorkspace && (
			<style is:inline>
				@view-transition {
					navigation: auto;
				}
				@media (prefers-reduced-motion: reduce) {
					::view-transition-group(*),
					::view-transition-old(*),
					::view-transition-new(*) {
						animation: none !important;
					}
				}
			</style>
		)}
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content={type} />
		<meta property="og:url" content={canonical} />
		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:locale" content="id_ID" />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Toolsman, kotak perkakas untuk kuliah dan koding." />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:image" content={ogImage} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		{jsonLdText && (
			<script type="application/ld+json" is:inline set:html={jsonLdText} />
		)}
		{/* Satu warna bilah per tema. Toggle manual tetap mengikuti sistem. */}
		<meta name="color-scheme" content="light dark" />
		<meta name="theme-color" content="#faf8f5" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#141311" media="(prefers-color-scheme: dark)" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="32x32" href="/icon-32.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/manifest.webmanifest" />
		{/* Hanya font yang tampil di layar pertama yang dipreload. Mono tidak,
		    karena dipakai label kecil yang tidak menahan render. */}
		<link rel="preload" as="font" type="font/woff2" href={displayFont} crossorigin />
		<link rel="preload" as="font" type="font/woff2" href={bodyFont} crossorigin />
		<meta name="generator" content={Astro.generator} />
		<script is:inline src="/theme-init.js"></script>
	</head>
	<body>
		<a class="skip-link" href="#konten" data-i18n="nav.skip">Langsung ke konten</a>
		<Header />
		<main id="konten"><slot /></main>
		<Footer />
		<Toast />
		<script>
			import { isFavorite, toggleFavorite } from '../lib/favorites';
			import { initLanguage } from '../lib/i18n-client';
			import { fill, readLang, t } from '../lib/i18n';

			const sync = () => {
				const lang = readLang();
				document.querySelectorAll<HTMLButtonElement>('[data-favorite]').forEach((button) => {
					const slug = button.dataset.favorite ?? '';
					if (slug === '') return;
					const active = isFavorite(localStorage, slug);
					const name = button.dataset.name ?? (lang === 'en' ? 'tool' : 'alat');
					button.setAttribute('aria-pressed', active ? 'true' : 'false');
					button.setAttribute(
						'aria-label',
						fill(t(lang, active ? 'favorite.remove' : 'favorite.save'), { name }),
					);
				});
			};

			document.addEventListener('click', (event) => {
				const button = (event.target as HTMLElement).closest<HTMLButtonElement>(
					'[data-favorite]',
				);
				if (!button) return;
				const slug = button.dataset.favorite ?? '';
				if (slug === '') return;
				toggleFavorite(localStorage, slug);
				sync();
				document.dispatchEvent(new CustomEvent('favorites:change'));
			});

			document.addEventListener('favorites:change', sync);
			document.addEventListener('lang:change', sync);
			initLanguage();
			sync();
		</script>
	</body>
</html>
